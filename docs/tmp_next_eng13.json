[{"i": 3601, "es": "...Mas o menos......", "orig": "…まあね……。"}, {"i": 3602, "es": "(...Este sonido...)", "orig": "（…この音…）"}, {"i": 3603, "es": "No puede ser... su\npareja...", "orig": "まさか…恋人…"}, {"i": 3604, "es": "Con esto, listo.", "orig": "これで、よし。"}, {"i": 3605, "es": "...Que te pasa?", "orig": "…どうしたの？"}, {"i": 3606, "es": "Ah, se detuvo.", "orig": "あ、止まった。"}, {"i": 3607, "es": "Eh? La nuestra?", "orig": "え？　うちの？"}, {"i": 3608, "es": "...Sera la talla?", "orig": "…サイズかな？"}, {"i": 3609, "es": "Ah, un correo...", "orig": "あ、メール…。"}, {"i": 3610, "es": "Mira la etiqueta...", "orig": "ラベル見て…。"}, {"i": 3611, "es": "Ya no...puedo mas...", "orig": "もう…ダメ…。"}, {"i": 3612, "es": "Lo siguiente es el bano.", "orig": "次は浴室だよ。"}, {"i": 3613, "es": "Si, hace un rato.", "orig": "うん、さっき。"}, {"i": 3614, "es": "Yo quiero te.", "orig": "あたし、紅茶。"}, {"i": 3615, "es": "Lo sabe usted?", "orig": "知ってますか？"}, {"i": 3616, "es": "No lo olvides.", "orig": "忘れないでね。"}, {"i": 3617, "es": "Primero el bano...", "orig": "まずは浴室…。"}, {"i": 3618, "es": "Asi se hace.", "orig": "そうこなきゃ。"}, {"i": 3619, "es": "Dicen que es el origen de\nla historia.", "orig": "元ネタだって。"}, {"i": 3620, "es": "Eh...... en serio?", "orig": "えっ……マジ？"}, {"i": 3621, "es": "Ya no puedo mas!", "orig": "もう無理だよ！"}, {"i": 3622, "es": "Ya lo abro!", "orig": "今開けるから！"}, {"i": 3623, "es": "No esta bien mentir.", "orig": "ウソはいかん。"}, {"i": 3624, "es": "Senorita Hayakawa.", "orig": "ハヤカワさん。"}, {"i": 3625, "es": "(...Un amuleto...)", "orig": "（…魔除け…）"}, {"i": 3626, "es": "Rapido! Escapemos!", "orig": "早く！逃げよ！"}, {"i": 3627, "es": "Ya veo...", "orig": "そうなんだ…。"}, {"i": 3628, "es": "Lo prepare, pero.", "orig": "用意したけど。"}, {"i": 3629, "es": "No estara?", "orig": "いないのかな。"}, {"i": 3630, "es": "...Que te pasa?", "orig": "…どうしたの？"}, {"i": 3631, "es": "Paso algo?", "orig": "なんかあった？"}, {"i": 3632, "es": "(Que es esto...)", "orig": "（なにこれ…）"}, {"i": 3633, "es": "Fue como en\nseptiembre.", "orig": "９月頃ですけど。"}, {"i": 3634, "es": "Coserlo...", "orig": "縫い合わせる…。"}, {"i": 3635, "es": "Que vieron una silueta,\no algo asi,", "orig": "人影を見たとか、"}, {"i": 3636, "es": "Que te pasa de repente?", "orig": "急にどうしたの？"}, {"i": 3637, "es": "Ya lo se.", "orig": "わかってるって。"}, {"i": 3638, "es": "Y si nos descubren...?", "orig": "見つかったら…？"}, {"i": 3639, "es": "...Profesora Yukari...", "orig": "…ユカリ先生…。"}, {"i": 3640, "es": "Me dijeron que tenga\ncuidado.", "orig": "気をつけろって。"}, {"i": 3641, "es": "Decirlo 3 veces en tu\nmente", "orig": "心の中で３回言う"}, {"i": 3642, "es": "(Lo senti...)", "orig": "（感じました…）"}, {"i": 3643, "es": "Eh, Masaki!?", "orig": "えっ、マサキ！？"}, {"i": 3644, "es": "Te encontre......", "orig": "見いつけた……。"}, {"i": 3645, "es": "Te encontre......", "orig": "見いつけた……。"}, {"i": 3646, "es": "Te encontre......", "orig": "見いつけた……。"}, {"i": 3647, "es": "Eh, en serio?", "orig": "えっ、そうなの？"}, {"i": 3648, "es": "Paso algo?", "orig": "なんかあったの？"}, {"i": 3649, "es": "Esconderse bajo el\nescritorio", "orig": "机の下にかくれる"}, {"i": 3650, "es": "Te encontre......", "orig": "見いつけた……。"}, {"i": 3651, "es": "Abuela...", "orig": "おばあちゃん…。"}, {"i": 3652, "es": "Oye, y la cama?", "orig": "あれ、ベッドは？"}, {"i": 3653, "es": "Con esto se acabo.", "orig": "これでおしまい。"}, {"i": 3654, "es": "...Mejor dejo de\nhacerlo...", "orig": "…やめよっかな…"}, {"i": 3655, "es": "Que genial.", "orig": "かっこいいなあ。"}, {"i": 3656, "es": "Decirlo 1 vez en tu\nmente", "orig": "心の中で１回言う"}, {"i": 3657, "es": "No puede ser... su\npareja...", "orig": "まさか…恋人…。"}, {"i": 3658, "es": "(Ya no importa...)", "orig": "（もういいよ…）"}, {"i": 3659, "es": "(Te encontre...)", "orig": "（見いつけた…）"}, {"i": 3660, "es": "Decirlo 3 veces en tu\nmente", "orig": "心の中で３回言う"}, {"i": 3661, "es": "Seguramente es un\nacosador", "orig": "たぶんストーカー"}, {"i": 3662, "es": "Eh... esta bien.", "orig": "えっ、…いいよ。"}, {"i": 3663, "es": "Da un poco de miedo,\nno?", "orig": "気味悪いよね…。"}, {"i": 3664, "es": "(Que sonido es\nese...?)", "orig": "（なんの音…？）"}, {"i": 3665, "es": "Ah, la linterna...", "orig": "あ、懐中電灯…。"}, {"i": 3666, "es": "Hitori Kakurenbo", "orig": "ヒトリカクレンボ"}, {"i": 3667, "es": "(Que hago...)", "orig": "（どうしよう…）"}, {"i": 3668, "es": "Bueno, es logico.", "orig": "そりゃ、そうだ。"}, {"i": 3669, "es": "Y, vuelvo al bano.", "orig": "で、浴室に戻る。"}, {"i": 3670, "es": "Que emocion, no?", "orig": "ドキドキするね。"}, {"i": 3671, "es": "(Au...auxilio...)", "orig": "（た…助けて…）"}, {"i": 3672, "es": "Decirlo 3 veces en tu\nmente", "orig": "心の中で３回言う"}, {"i": 3673, "es": "...Necesitas algo?", "orig": "……なにか用か？"}, {"i": 3674, "es": "Decirlo 5 veces en tu\nmente", "orig": "心の中で５回言う"}, {"i": 3675, "es": "El sonido viene de\naqui...?", "orig": "ここから音が…？"}, {"i": 3676, "es": "Ahora te toca ser el\nbuscador", "orig": "次はあなたがオニ"}, {"i": 3677, "es": "Decirlo 3 veces en tu\nmente", "orig": "心の中で３回言う"}, {"i": 3678, "es": "Que tal, por alla?", "orig": "どう、そっちは？"}, {"i": 3679, "es": "Te encontre......", "orig": "見いつけた……。"}, {"i": 3680, "es": "Oye, Masaki.", "orig": "おーい、マサキ。"}, {"i": 3681, "es": "Ah, es Masaki...", "orig": "あ、マサキだ…。"}, {"i": 3682, "es": "Por favor, venga.", "orig": "おいでください。"}, {"i": 3683, "es": "Se corto...", "orig": "切っちゃった…。"}, {"i": 3684, "es": "(Te encontre...)", "orig": "（見いつけた…）"}, {"i": 3685, "es": "(Ya no importa...)", "orig": "（もういいよ…）"}, {"i": 3686, "es": "Oye... Riko...", "orig": "ね……リコ……。"}, {"i": 3687, "es": "Decirlo 5 veces en tu\nmente", "orig": "心の中で５回言う"}, {"i": 3688, "es": "Al final no esta.", "orig": "やっぱいないよ。"}, {"i": 3689, "es": "(Te encontre...)", "orig": "（見いつけた…）"}, {"i": 3690, "es": "Sera tu imaginacion.", "orig": "気のせいでしょ。"}, {"i": 3691, "es": "Ohh...gah...", "orig": "おおっ…がっ…。"}, {"i": 3692, "es": "Entendido.........", "orig": "わかった………。"}, {"i": 3693, "es": "Que retro, otra vez...", "orig": "またレトロな…。"}, {"i": 3694, "es": "Te encontre......", "orig": "見いつけた……。"}, {"i": 3695, "es": "Decirlo 1 vez en tu\nmente", "orig": "心の中で１回言う"}, {"i": 3696, "es": "Una cinta de video...", "orig": "ビデオテープ…。"}, {"i": 3697, "es": "Cree en ti misma...", "orig": "自分を信じて…。"}, {"i": 3698, "es": "Echarse agua salada en\nla cabeza", "orig": "頭に塩水をかける"}, {"i": 3699, "es": "Eh, y papa?", "orig": "え、お父さんは？"}, {"i": 3700, "es": "(Ya no importa...)", "orig": "（もういいよ…）"}, {"i": 3701, "es": "Revisar una vez mas", "orig": "もう１回確認する"}, {"i": 3702, "es": "Viene de la sala!", "orig": "リビングからだ！"}, {"i": 3703, "es": "Hay que apagarlo\nrapido!", "orig": "早く消さないと！"}, {"i": 3704, "es": "Echarse agua salada en\nla cabeza", "orig": "頭に塩水をかける"}, {"i": 3705, "es": "Esconderse en la cama", "orig": "ベッドにかくれる"}, {"i": 3706, "es": "Algo raro...?", "orig": "おかしなこと…？"}, {"i": 3707, "es": "No volvemos al cuarto?", "orig": "部屋に戻らない？"}, {"i": 3708, "es": "Que es esto...", "orig": "なんだ、これ…。"}, {"i": 3709, "es": "Cierra los ojos......", "orig": "目を閉じて……。"}, {"i": 3710, "es": "Ahora te toca ser el\nbuscador", "orig": "次はあなたがオニ"}, {"i": 3711, "es": "Ah, es Masaki...", "orig": "あ、マサキだ…。"}, {"i": 3712, "es": "(No hay tiempo...)", "orig": "（時間が無い…）"}, {"i": 3713, "es": "Bueno, nos\nvemos......", "orig": "じゃ、また……。"}, {"i": 3714, "es": "Hay que apagarlo\nrapido!", "orig": "早く消さないと！"}, {"i": 3715, "es": "Jeje... puede ser.", "orig": "フフッ…かもね。"}, {"i": 3716, "es": "Probemos a reproducirlo", "orig": "再生してみよっか"}, {"i": 3717, "es": "No queda otra que\nespiar!", "orig": "のぞくしかない！"}, {"i": 3718, "es": "Asi es, pues...", "orig": "そうじゃのう…。"}, {"i": 3719, "es": "(Que sera...?)", "orig": "（なんだろ…？）"}, {"i": 3720, "es": "(...Un fenomeno\nparanormal...)", "orig": "（…心霊現象…）"}, {"i": 3721, "es": "(...Kurata Yumiko...)", "orig": "（…倉田裕見子…）"}, {"i": 3722, "es": "Cree en ti misma...", "orig": "『自分を信じて…』"}, {"i": 3723, "es": "(Todavia... hay\ntiempo)", "orig": "（まだ…間に合う）"}, {"i": 3724, "es": "Ah... yo soy Masaki.", "orig": "あ……俺、マサキ。"}, {"i": 3725, "es": "Te digo que no es eso.", "orig": "それじゃないって。"}, {"i": 3726, "es": "...Bien, ya esta.", "orig": "…よし、できたよ。"}, {"i": 3727, "es": "Decirlo 3 veces en tu\nmente.", "orig": "心の中で３回言う。"}, {"i": 3728, "es": "Bueno, volvamos al\ncuarto.", "orig": "さ、部屋に戻ろう。"}, {"i": 3729, "es": "Si, alo.", "orig": "…はい、もしもし。"}, {"i": 3730, "es": "Todavia dudo un\npoco...", "orig": "まだ、ためらいが…"}, {"i": 3731, "es": "Gracias... profesora.", "orig": "ありがとう…先生。"}, {"i": 3732, "es": "Pedir ayuda con el\ncelular...", "orig": "ケータイで助けを…"}, {"i": 3733, "es": "(Cuando salga del\nbano...)", "orig": "（風呂を出たら…）"}, {"i": 3734, "es": "Decirlo 3 veces en tu\nmente.", "orig": "心の中で３回言う。"}, {"i": 3735, "es": "Salir del bano de\ninmediato!", "orig": "すぐに浴室を出る！"}, {"i": 3736, "es": "Llego un correo al\ncelular...", "orig": "携帯にメールが…。"}, {"i": 3737, "es": "Que irresponsable...", "orig": "そんな無責任な…。"}, {"i": 3738, "es": "Oye, y como termina?", "orig": "ねえ、終わり方は？"}, {"i": 3739, "es": "Un cadaver... u-una\nmomia!", "orig": "死体…ミ、ミイラ！"}, {"i": 3740, "es": "Bien, salgamos afuera", "orig": "よしっ、外に出よう"}, {"i": 3741, "es": "No hay ninguna\nreaccion...", "orig": "何も反応が無い…。"}, {"i": 3742, "es": "Decirlo 3 veces en tu\nmente.", "orig": "心の中で３回言う。"}, {"i": 3743, "es": "(Fue asesinada...)", "orig": "（殺されました…）"}, {"i": 3744, "es": "(Ademas da miedo...)", "orig": "（気味が悪いし…）"}, {"i": 3745, "es": "Dejarlo tal como esta", "orig": "そのままにしておく"}, {"i": 3746, "es": "Te atrape......", "orig": "つかまえたあ……。"}, {"i": 3747, "es": "Es que es ese tipo de\njuego.", "orig": "そういう遊びだし。"}, {"i": 3748, "es": "Te atrape......", "orig": "つかまえたあ……。"}, {"i": 3749, "es": "Este no es......", "orig": "これじゃない……。"}, {"i": 3750, "es": "Apunalar con el\ncuchillo......", "orig": "ナイフで刺す……。"}, {"i": 3751, "es": "Yo mejor paso.", "orig": "あたしはカンベン。"}, {"i": 3752, "es": "Te atrape......", "orig": "つかまえたあ……。"}, {"i": 3753, "es": "Te atrape......", "orig": "つかまえたあ……。"}, {"i": 3754, "es": "(Primero... a\ndonde...)", "orig": "（まず…どこへ…）"}, {"i": 3755, "es": "Termine apoyandolo.", "orig": "立てかけちゃった。"}, {"i": 3756, "es": "Este no es......", "orig": "これじゃない……。"}, {"i": 3757, "es": "Apunalar con el\ncuchillo......", "orig": "ナイフで刺す……。"}, {"i": 3758, "es": "Apunalar con el\ncuchillo... y.", "orig": "ナイフで刺す…と。"}, {"i": 3759, "es": "Con permiso.", "orig": "おじゃましまーす。"}, {"i": 3760, "es": "Te atrape......", "orig": "つかまえたあ……。"}, {"i": 3761, "es": "Te digo que no es eso.", "orig": "それじゃないって。"}, {"i": 3762, "es": "Te digo que no es eso.", "orig": "それじゃないって。"}, {"i": 3763, "es": "No puede ser,\nverdad...", "orig": "なわけないよね…。"}, {"i": 3764, "es": "No hay ninguna\nreaccion...", "orig": "何も反応が無い…。"}, {"i": 3765, "es": "No hay ninguna\nreaccion...", "orig": "何も反応が無い…。"}, {"i": 3766, "es": "No hay ninguna\nreaccion...", "orig": "何も反応が無い…。"}, {"i": 3767, "es": "Ah, es mama...", "orig": "あ、お母さんだ…。"}, {"i": 3768, "es": "De verdad daba miedo.", "orig": "マジで怖かったよ。"}, {"i": 3769, "es": "(Por favor...\ncontesta...)", "orig": "（お願い…出て…）"}, {"i": 3770, "es": "Alo! Reika?", "orig": "もしもし！レイカ？"}, {"i": 3771, "es": "Sin senal!? No puede\nser!", "orig": "圏外！？…そんな！"}, {"i": 3772, "es": "Si. Un tipo asqueroso.", "orig": "そう。薄汚いやつ。"}, {"i": 3773, "es": "...Si, entendido.", "orig": "…うん、わかった。"}, {"i": 3774, "es": "Primero yo sere la que\nbusca", "orig": "最初はわたしがオニ"}, {"i": 3775, "es": "(Masaki! Riko!)", "orig": "（マサキ！リコ！）"}, {"i": 3776, "es": "Aaah! Que alivio!", "orig": "はああ！すっきり！"}, {"i": 3777, "es": "Que es esto! Que asco!", "orig": "なにこれ！キモッ！"}, {"i": 3778, "es": "(...Sera mi\nimaginacion...?)", "orig": "（…気のせい…？）"}, {"i": 3779, "es": "De verdad piensas\nbotarlo?", "orig": "ほんとに捨てる気？"}, {"i": 3780, "es": "...Mejor dejo de\nhacerlo...", "orig": "…やめよっかな…。"}, {"i": 3781, "es": "Si, alo.", "orig": "…はい、もしもし。"}, {"i": 3782, "es": "Contar hasta 10 en tu\nmente", "orig": "心の中で１０数える"}, {"i": 3783, "es": "Jaja... es\nverdad......", "orig": "ははっ…だね……。"}, {"i": 3784, "es": "De verdad daba miedo.", "orig": "マジで怖かったよ。"}, {"i": 3785, "es": "Este no es......", "orig": "これじゃない……。"}, {"i": 3786, "es": "De verdad piensas eso?", "orig": "ホントにそう思う？"}, {"i": 3787, "es": "Ah... yo soy Masaki.", "orig": "あ……俺、マサキ。"}, {"i": 3788, "es": "En fin, salgamos a ver.", "orig": "とにかく出てみよ。"}, {"i": 3789, "es": "El cadaver se levanta?", "orig": "死体が起き上がる？"}, {"i": 3790, "es": "Con permiso.", "orig": "おじゃましまーす。"}, {"i": 3791, "es": "En fin, pasa.", "orig": "とにかくあがって。"}, {"i": 3792, "es": "Aaah! Que alivio!", "orig": "はああ！すっきり！"}, {"i": 3793, "es": "Eeeh! No mires!", "orig": "えーっ！見ないで？"}, {"i": 3794, "es": "Ya, ya, entendido.", "orig": "分かった分かった。"}, {"i": 3795, "es": "Que desperdicio.", "orig": "もったいないなぁ。"}, {"i": 3796, "es": "No hay remedio.", "orig": "しょうがないなあ。"}, {"i": 3797, "es": "(Hiiiiii!)", "orig": "（ひぃぃぃぃぃ！）"}, {"i": 3798, "es": "(Ya no...puedoo)", "orig": "（もう…ダメええ）"}, {"i": 3799, "es": "(...Que hago...)", "orig": "（…どうしよう…）"}, {"i": 3800, "es": "Todavia... la banera...", "orig": "まだ…バスタブ…。"}, {"i": 3801, "es": "(Sera el bano?)", "orig": "（お風呂場かな？）"}, {"i": 3802, "es": "Hace 20 anos? Que\nviejo.", "orig": "２０年前？古すぎ。"}, {"i": 3803, "es": "Perdon... Mizuki.", "orig": "ごめんね…ミズキ。"}, {"i": 3804, "es": "(Fue asesinada...)", "orig": "（殺されました…）"}, {"i": 3805, "es": "...Papel aluminio...", "orig": "…アルミホイル…。"}, {"i": 3806, "es": "(Fue asesinada...)", "orig": "（殺されました…）"}, {"i": 3807, "es": "Es mi cuarto...", "orig": "わたしの部屋だ…。"}, {"i": 3808, "es": "Esconderse en el armario", "orig": "押し入れにかくれる"}, {"i": 3809, "es": "...Oye...... el\ntecho...", "orig": "…おい……天井…。"}, {"i": 3810, "es": "...Que hago...", "orig": "……どうしよう…。"}, {"i": 3811, "es": "Sobre Kurata Yumiko", "orig": "倉田裕見子について"}, {"i": 3812, "es": "Si, ya lo se.", "orig": "うん、わかってる。"}, {"i": 3813, "es": "Cual de los dos crees?", "orig": "どっちなら信じる？"}, {"i": 3814, "es": "El fuego se extiende muy\nrapido!", "orig": "火の回りがはええ！"}, {"i": 3815, "es": "Da miedo, no puedo\nmirar...", "orig": "怖くてのぞけない…"}, {"i": 3816, "es": "Te atrape......", "orig": "つかまえたあ……。"}, {"i": 3817, "es": "Oh...... ah......", "orig": "おっ……ああ……。"}, {"i": 3818, "es": "Dicen que si hubo.", "orig": "あったらしいって。"}, {"i": 3819, "es": "(Dicen que no hay...)", "orig": "（ないという……）"}, {"i": 3820, "es": "Hundir esto... y.", "orig": "これを沈めて…と。"}, {"i": 3821, "es": "(...Un acosador...)", "orig": "（…ストーカー男…）"}, {"i": 3822, "es": "(Estaba pegado)", "orig": "（貼られていました）"}, {"i": 3823, "es": "(La verdad detras de la\nleyenda urbana...)", "orig": "（都市伝説の真実…）"}, {"i": 3824, "es": "Estoy muy inquieta...", "orig": "とっても不安です…。"}, {"i": 3825, "es": "Puede que ambos sean\nigual de malos.", "orig": "どっちもどっちかな。"}, {"i": 3826, "es": "Todavia dudo un\npoco...", "orig": "まだ、ためらいが…。"}, {"i": 3827, "es": "(Tengo que hacerselo\nentender...)", "orig": "（わからせないと…）"}, {"i": 3828, "es": "Todavia hay algo\nmas...?", "orig": "まだ、何かあるの…？"}, {"i": 3829, "es": "No queda mas que\naguantar...", "orig": "ひたすらたえるしか…"}, {"i": 3830, "es": "Escucha bien, eh.", "orig": "ちゃんと聞いててよ。"}, {"i": 3831, "es": "Salir del bano por un\nmomento.", "orig": "いったん風呂を出る。"}, {"i": 3832, "es": "Mizuki! Noooo!", "orig": "ミズキ！やだあああ！"}, {"i": 3833, "es": "(Si cierro los ojos...)", "orig": "（目をつむったら…）"}, {"i": 3834, "es": "Te digo que no es\neso...", "orig": "それじゃないって…。"}, {"i": 3835, "es": "(Si cierro los ojos...)", "orig": "（目をつむったら…）"}, {"i": 3836, "es": "Yo gane... y.", "orig": "わたしの勝ち…と…。"}, {"i": 3837, "es": "Vamos, comamos pastel.", "orig": "ほら、ケーキ食べよ。"}, {"i": 3838, "es": "(La empujo al suelo...)", "orig": "（押し倒しました…）"}, {"i": 3839, "es": "(Si cierro los ojos...)", "orig": "（目をつむったら…）"}, {"i": 3840, "es": "Que buen momento...", "orig": "ナイスタイミング…。"}, {"i": 3841, "es": "Yo lo hare todo sola.", "orig": "全部１人でやるから。"}, {"i": 3842, "es": "(Cierto, el celular)", "orig": "（そうだ、ケータイ）"}, {"i": 3843, "es": "(De alguna forma se\ncalmo)", "orig": "（なんとか収まった）"}, {"i": 3844, "es": "(Se juntaron alrededor\nde la momia)", "orig": "（ミイラに集まった）"}, {"i": 3845, "es": "(Que uso a\ncontinuacion?)", "orig": "（次に使うものは？）"}, {"i": 3846, "es": "(No hay remedio...)", "orig": "（しょうがないな…）"}, {"i": 3847, "es": "Ahora me toca\nesconderme a mi", "orig": "次はわたしがかくれる"}, {"i": 3848, "es": "Ojala sea asi...", "orig": "だといいんだけど…。"}, {"i": 3849, "es": "(Que objeto uso?)", "orig": "（使うアイテムは？）"}, {"i": 3850, "es": "Se llama... Kumazou.", "orig": "クマゾウって…名前。"}, {"i": 3851, "es": "Entonces, el jardin del\nprimer piso, por\nejemplo.", "orig": "じゃ、１階の庭とか。"}, {"i": 3852, "es": "Es la chica que vive en el\nsegundo piso.", "orig": "２階に住んでる子よ。"}, {"i": 3853, "es": "No sera que la viste mal?", "orig": "見間違いじゃないの？"}, {"i": 3854, "es": "(Hice una promesa en mi\ncorazon)", "orig": "（心に誓ったのです）"}, {"i": 3855, "es": "Ahora me toca\nesconderme a mi", "orig": "次はわたしがかくれる"}, {"i": 3856, "es": "Vamos a investigar un\npoco.", "orig": "ちょっと調べてみよ。"}, {"i": 3857, "es": "Otra vez volviendo en el\nultimo tren......", "orig": "また終電帰りか……。"}, {"i": 3858, "es": "Eh?...que sonido es\nese...?", "orig": "ん？…なんの音だ…？"}, {"i": 3859, "es": "Llenar la banera con\nagua.", "orig": "バスタブに水を張る。"}, {"i": 3860, "es": "Oye, Mizuki! Rapido!", "orig": "ねえ、ミズキ！早く！"}, {"i": 3861, "es": "Mizuki, nada mal.", "orig": "ミズキ、やるじゃん。"}, {"i": 3862, "es": "Tsk, que aburrido.", "orig": "ちぇっ、つまんない。"}, {"i": 3863, "es": "Que te pasa, Mizuki?", "orig": "どうしたの？ミズキ。"}, {"i": 3864, "es": "(Hice una promesa en mi\ncorazon)", "orig": "（心に誓ったのです）"}, {"i": 3865, "es": "Entonces... no es\neso...", "orig": "じゃあ…、違うか…。"}, {"i": 3866, "es": "El celular... esta sobre\nel escritorio...", "orig": "携帯は…机の上だ…。"}, {"i": 3867, "es": "(Pedirle ayuda a\nReika...)", "orig": "（レイカに助けを…）"}, {"i": 3868, "es": "(Despues tengo que\nlavarlo)", "orig": "（後で洗濯しないと）"}, {"i": 3869, "es": "Ahora te toca ser el\nbuscador", "orig": "『次はあなたがオニ』"}, {"i": 3870, "es": "Justo en un momento\nimportante...", "orig": "もう、大事な時に…。"}, {"i": 3871, "es": "Que...? El bolsillo...?", "orig": "なに…？ポケット…？"}, {"i": 3872, "es": "Si...... ah, cierto.", "orig": "うん……あ、そうだ。"}, {"i": 3873, "es": "(Despues tengo que\nordenarlo)", "orig": "（後で整理しないと）"}, {"i": 3874, "es": "Es el aviso de la reunion\nde ex alumnos.", "orig": "同窓会のお知らせよ。"}, {"i": 3875, "es": "...Bueno, una vez\nmas.", "orig": "…じゃあ、もう１回。"}, {"i": 3876, "es": "(No queda otra que\nespiar!)", "orig": "（のぞくしかない！）"}, {"i": 3877, "es": "Apagar antes todas las\nluces de la casa", "orig": "先に家中の照明を消す"}, {"i": 3878, "es": "(Sera que me preocupo\ndemasiado...)", "orig": "（気にしすぎかな…）"}, {"i": 3879, "es": "Esta vez investigar\nafuera", "orig": "今度は外を調べてみる"}, {"i": 3880, "es": "Eh? Ahora? Por que?", "orig": "えっ？　今？なんで？"}, {"i": 3881, "es": "Riko me pidio consejo.", "orig": "リコに相談されたの。"}, {"i": 3882, "es": "De donde viene el\nsonido?", "orig": "どこから音がするの？"}, {"i": 3883, "es": "No reacciona en\nespecial...", "orig": "特に反応しないね…。"}, {"i": 3884, "es": "No reacciona en\nespecial...", "orig": "特に反応しないね…。"}, {"i": 3885, "es": "Mizuki, y tu mama?", "orig": "ミズキ、お母さんは？"}, {"i": 3886, "es": "...Otra vez de\nNanashi...", "orig": "…またナナシから…。"}, {"i": 3887, "es": "Ya veo.\nTienes razon.", "orig": "そっか。\nそうだよね。"}, {"i": 3888, "es": "(...El hombre debajo\nde la cama...)", "orig": "（…ベッドの下の男…）"}, {"i": 3889, "es": "(La verdad quedo entre\nlas sombras...)", "orig": "（真相は闇の中です…）"}, {"i": 3890, "es": "...Ya no importa, no\ncrees?", "orig": "…もういいんじゃない？"}, {"i": 3891, "es": "Porque lo que viene\nahora es importante.", "orig": "これからが重要だから。"}, {"i": 3892, "es": "(Tengo que contarselo a\nRiko...)", "orig": "（リコに…教えなきゃ）"}, {"i": 3893, "es": "Lo siguiente era la sala,\nno...?", "orig": "次はリビングだっけ…。"}, {"i": 3894, "es": "Primero yo soy la que\nbusca", "orig": "「最初はわたしがオニ」"}, {"i": 3895, "es": "Primero tu eres el que\nbusca", "orig": "「最初はあなたがオニ」"}, {"i": 3896, "es": "Bueno, dejame\nrepasarlo.", "orig": "じゃあおさらいさせて。"}, {"i": 3897, "es": "Al final si era el\nacosador...", "orig": "やっぱストーカーが…。"}, {"i": 3898, "es": "Quedemonos escondidos\nun poco mas", "orig": "もう少しかくれていよう"}, {"i": 3899, "es": "No seria mejor botarlo?", "orig": "捨てればいんじゃない？"}, {"i": 3900, "es": "Escapemos por la\nventana!!", "orig": "窓から外へ逃げよう！！"}]