[{"i": 4801, "es": "Mmm......", "orig": "うーん……。"}, {"i": 4802, "es": "Quien sabe.", "orig": "どうかしら。"}, {"i": 4803, "es": "Tuve un sueno raro...", "orig": "変な夢を見て…"}, {"i": 4804, "es": "Mizuki, apurate!", "orig": "ミズキ、急げ！"}, {"i": 4805, "es": "Senor Hasegawa,", "orig": "ハセガワさん、"}, {"i": 4806, "es": "Pintura fosforescente...\nya veo.", "orig": "夜光塗料…か。"}, {"i": 4807, "es": "Sera algun codigo?", "orig": "なにかの暗号？"}, {"i": 4808, "es": "Usted es......", "orig": "あなたは……。"}, {"i": 4809, "es": "Si, entendido", "orig": "うん、わかった"}, {"i": 4810, "es": "Eh? Por que?", "orig": "え？どうして？"}, {"i": 4811, "es": "Un garabato de nino?", "orig": "子供の落書き？"}, {"i": 4812, "es": "Sientate, vamos.", "orig": "座ってごらん。"}, {"i": 4813, "es": "El panel de energia...", "orig": "電源パネル…。"}, {"i": 4814, "es": "Mi papa que murio,", "orig": "死んだ親父は、"}, {"i": 4815, "es": "Crayon rojo", "orig": "アカイクレヨン"}, {"i": 4816, "es": "(...Un payaso...)", "orig": "（…ピエロ…）"}, {"i": 4817, "es": "Paso algo?", "orig": "なにかあった？"}, {"i": 4818, "es": "Es una libreta.........", "orig": "手帳だ………。"}, {"i": 4819, "es": "Vamos a comprobarlo?", "orig": "確かめようか。"}, {"i": 4820, "es": "Es una guillotina...", "orig": "ギロチンだ…。"}, {"i": 4821, "es": "Ah, aqui......", "orig": "あ、ここ……。"}, {"i": 4822, "es": "No importa, rapido!", "orig": "いいから早く！"}, {"i": 4823, "es": "...Tienes razon.", "orig": "…そうだよね。"}, {"i": 4824, "es": "Senorita Hayakawa.", "orig": "ハヤカワさん。"}, {"i": 4825, "es": "Mi papa incluso\nahora...", "orig": "親父は今も…。"}, {"i": 4826, "es": "Los demas espiritus,", "orig": "他の霊たちは、"}, {"i": 4827, "es": "Todavia sigues con eso!!", "orig": "まだ言うか！！"}, {"i": 4828, "es": "Mizuki? Soy yo.", "orig": "ミズキ？私よ。"}, {"i": 4829, "es": "Escapemos rapido!", "orig": "早く逃げよう！"}, {"i": 4830, "es": "Otra cadena?", "orig": "またチェンメ？"}, {"i": 4831, "es": "Tuve un sueno raro...", "orig": "変な夢を見て…"}, {"i": 4832, "es": "Ah, un correo.", "orig": "あ、メールだ。"}, {"i": 4833, "es": "Esta amaneciendo...", "orig": "夜が明ける…。"}, {"i": 4834, "es": "Por favor, hazme el\nfavor", "orig": "そこをなんとか"}, {"i": 4835, "es": "Yo......", "orig": "わたしが……。"}, {"i": 4836, "es": "De un cliente,", "orig": "お客さんから、"}, {"i": 4837, "es": "Yo......", "orig": "わたしが……。"}, {"i": 4838, "es": "Ya no me importa!", "orig": "もう知らない！"}, {"i": 4839, "es": "Es de Reika.", "orig": "レイカからだ。"}, {"i": 4840, "es": "Un garabato de nino?", "orig": "子供の落書き？"}, {"i": 4841, "es": "Aqui esta, aqui esta.", "orig": "あったあった。"}, {"i": 4842, "es": "El parque de diversiones\nde los suenos......", "orig": "夢の遊園地……。"}, {"i": 4843, "es": "Los planos de la rueda\nde la fortuna?", "orig": "観覧車の設計図？"}, {"i": 4844, "es": "(Este lugar es......?)", "orig": "（ここは……？）"}, {"i": 4845, "es": "...Gracias...", "orig": "…ありがとう…。"}, {"i": 4846, "es": "Senor Hasegawa...", "orig": "ハセガワさん…。"}, {"i": 4847, "es": "Se ve la rueda de la\nfortuna.", "orig": "観覧車が見える。"}, {"i": 4848, "es": "A donde vamos ahora?", "orig": "次はどこに行く？"}, {"i": 4849, "es": "No, es mi papa.", "orig": "いや、親父だよ。"}, {"i": 4850, "es": "Aun mas aterrador...", "orig": "より恐ろしく…。"}, {"i": 4851, "es": "Que quieres decir?", "orig": "どういう意味だ？"}, {"i": 4852, "es": "Todavia se reunen los\nespiritus aqui?", "orig": "今も霊が集まる？"}, {"i": 4853, "es": "Eh? Que es esto?", "orig": "ん？なんだこれ？"}, {"i": 4854, "es": "Entendido........", "orig": "わかったよ……。"}, {"i": 4855, "es": "Prefiero al final...", "orig": "最後がいいな…。"}, {"i": 4856, "es": "Espere, por favor.", "orig": "待ってください。"}, {"i": 4857, "es": "No tengo muchas ganas.", "orig": "気が進まないの。"}, {"i": 4858, "es": "Que sale ahi?", "orig": "なにがうつるの？"}, {"i": 4859, "es": "N-no lo se.", "orig": "わ、わかんない。"}, {"i": 4860, "es": "Senor Hasegawa...", "orig": "ハセガワさん…。"}, {"i": 4861, "es": "No lo se......", "orig": "わからない……。"}, {"i": 4862, "es": "El simbolo del payaso...", "orig": "ピエロの象徴…。"}, {"i": 4863, "es": "Ese sonido...que fue?", "orig": "今の音……なに？"}, {"i": 4864, "es": "Un crayon rojo...", "orig": "赤いクレヨン…。"}, {"i": 4865, "es": "Yo soy su hijo.", "orig": "私はその息子だ。"}, {"i": 4866, "es": "Una motosierra...", "orig": "チェーンソー…。"}, {"i": 4867, "es": "...U-usted es...?", "orig": "…あ、あなたは？"}, {"i": 4868, "es": "Por eso, papa......", "orig": "だから親父……。"}, {"i": 4869, "es": "Quien es usted?", "orig": "あなたは誰なの？"}, {"i": 4870, "es": "No hay alguna forma?", "orig": "なにか手はないの？"}, {"i": 4871, "es": "Elige una vez mas.", "orig": "もう１回選ぶんだ。"}, {"i": 4872, "es": "Riko, estas bien!?", "orig": "リコ、無事なの！？"}, {"i": 4873, "es": "Que bueno que estas\nbien.", "orig": "よかった、無事で。"}, {"i": 4874, "es": "Si, gracias.", "orig": "うん、ありがとう。"}, {"i": 4875, "es": "Es una motosierra...", "orig": "チェーンソーだ…。"}, {"i": 4876, "es": "Ahora que lo pienso, en\nesa epoca,", "orig": "そういえば当時は、"}, {"i": 4877, "es": "No, es de mentira.", "orig": "いや、作り物だよ。"}, {"i": 4878, "es": "En el Dream Park?", "orig": "ドリームパークで？"}, {"i": 4879, "es": "Por una broma de mi\npapa,", "orig": "親父のイタズラで、"}, {"i": 4880, "es": "Carrusel", "orig": "メリーゴーラウンド"}, {"i": 4881, "es": "No tuve suerte.", "orig": "ついてなかったよ。"}, {"i": 4882, "es": "Bueno, primero...,", "orig": "じゃあ、まずは…、"}, {"i": 4883, "es": "De verdad estoy bien", "orig": "ホントに大丈夫です"}, {"i": 4884, "es": "Que gente tan curiosa.", "orig": "物好きな人たちね。"}, {"i": 4885, "es": "Es de Nanashi......", "orig": "ナナシからだ……。"}, {"i": 4886, "es": "Al Dream Park?", "orig": "ドリームパークに？"}, {"i": 4887, "es": "......No puede ser.", "orig": "……そんなはずは。"}, {"i": 4888, "es": "Senor Hasegawa......", "orig": "ハセガワさん……。"}, {"i": 4889, "es": "Es verdad, y la salida?", "orig": "そうだね、出口は？"}, {"i": 4890, "es": "Senor Hasegawa......", "orig": "ハセガワさん……。"}, {"i": 4891, "es": "Sh...... quedate\ncallado......", "orig": "し……黙って……。"}, {"i": 4892, "es": "No! Corre, rapido!", "orig": "やだ！逃げて早く！"}, {"i": 4893, "es": "Es un contenido\ntotalmente opuesto.", "orig": "正反対な内容だね。"}, {"i": 4894, "es": "Por fin te acordaste?", "orig": "やっと思い出した？"}, {"i": 4895, "es": "Oye, todavia sigues con\neso.", "orig": "コラ、まだ言うか。"}, {"i": 4896, "es": "Esa ropa... cuando era\npequena,", "orig": "あの服…小さい頃、"}, {"i": 4897, "es": "Lleva hacia la parte de\natras.", "orig": "裏に通じているの。"}, {"i": 4898, "es": "Ah, por ahi tambien.", "orig": "ああ、そっちもな。"}, {"i": 4899, "es": "Q-que miedo pase...", "orig": "こ、怖かったぁ…。"}, {"i": 4900, "es": "Que estan haciendo!", "orig": "何をやってるんだ！"}, {"i": 4901, "es": "No! Corre, rapido!", "orig": "やだ！逃げて早く！"}, {"i": 4902, "es": "Ah...... eso es......", "orig": "あ……あれは……。"}, {"i": 4903, "es": "Igual... que el\nsueno......", "orig": "夢と……同じ……。"}, {"i": 4904, "es": "Lleva hacia la parte de\natras.", "orig": "裏に通じているの。"}, {"i": 4905, "es": "Que dijiste que\nviene......?", "orig": "何が来るって……？"}, {"i": 4906, "es": "Que rayos eres tu!!", "orig": "何だぁ、お前は！！"}, {"i": 4907, "es": "Ahora estoy frente a la\nrueda de la fortuna.", "orig": "いま観覧車の前だ。"}, {"i": 4908, "es": "Senor Hasegawa......", "orig": "ハセガワさん……。"}, {"i": 4909, "es": "Otra vez... el\npayaso...!?", "orig": "また…ピエロ…！？"}, {"i": 4910, "es": "...Si, no es nada.", "orig": "…うん、何でもない。"}, {"i": 4911, "es": "Algo que tenias grabado\nen el corazon?", "orig": "心にとめていたもの？"}, {"i": 4912, "es": "Solia presumirlo mucho.", "orig": "よく自慢していたな。"}, {"i": 4913, "es": "Esto, senor Hasegawa?", "orig": "これ、ハセガワさん？"}, {"i": 4914, "es": "Es la energia de\nemergencia del parque.", "orig": "園内の非常用電源だ。"}, {"i": 4915, "es": "Encontre un pasadizo\nsubterraneo.", "orig": "地下通路見つけたよ。"}, {"i": 4916, "es": "No hay alguna via de\nescape?", "orig": "逃げ道はないですか？"}, {"i": 4917, "es": "Esta con llave...", "orig": "鍵がかかっている…。"}, {"i": 4918, "es": "(Si engordara asi...)", "orig": "（こんな太ったら…）"}, {"i": 4919, "es": "Eso, donde......", "orig": "それは、どこに……。"}, {"i": 4920, "es": "Ese era el contenido.", "orig": "っていう内容だった。"}, {"i": 4921, "es": "(No esta...\ncompletamente oscuro)", "orig": "（真っ暗…じゃない）"}, {"i": 4922, "es": "Aqui ya entramos.", "orig": "ここはもう入ったよ。"}, {"i": 4923, "es": "Esto es obra de ustedes,\nno?", "orig": "お前たちの仕業だろ？"}, {"i": 4924, "es": "Esa voz es...... Ri...\nRiko?", "orig": "その声は……リ…コ？"}, {"i": 4925, "es": "Esto es pintura\nfosforescente.", "orig": "これは夜光塗料だね。"}, {"i": 4926, "es": "Encontre un pasadizo\nsubterraneo.", "orig": "地下通路見つけたよ。"}, {"i": 4927, "es": "Mira... es de\nNanashi...", "orig": "見て…ナナシから…。"}, {"i": 4928, "es": "Tengo que llamar a Reika", "orig": "レイカに電話しなきゃ"}, {"i": 4929, "es": "Sono como una voz\nhumana.", "orig": "人の声に聞こえたぞ。"}, {"i": 4930, "es": "Algo que tenias grabado\nen el corazon?", "orig": "心にとめていたもの？"}, {"i": 4931, "es": "Este lado es la salida.", "orig": "こっち側は出口だな。"}, {"i": 4932, "es": "...El payaso... no\npuede ser...", "orig": "…ピエロ…そんな…。"}, {"i": 4933, "es": "Calmate, Mizuki.", "orig": "落ち着いて、ミズキ。"}, {"i": 4934, "es": "Ya esta bien con este\nlugar, no?", "orig": "ここはもういいっしょ。"}, {"i": 4935, "es": "(Poco despues de eso,)", "orig": "（それから間もなく、）"}, {"i": 4936, "es": "Esta disfrutando del\nparque de diversiones.", "orig": "遊園地を楽しんでいる。"}, {"i": 4937, "es": "Vamos a recorrer todo un\npoco.", "orig": "一通り回ってみようぜ。"}, {"i": 4938, "es": "Que fue eso!?", "orig": "今のなんだったんだ！？"}, {"i": 4939, "es": "Nosotras lo hacemos...", "orig": "わたしたちがするの…。"}, {"i": 4940, "es": "Todavia no estoy\nsegura, pero...", "orig": "まだ確信はないけど…。"}, {"i": 4941, "es": "Esa sombra blanca\ntambien... un\nfantasma...", "orig": "あの白い影も…幽霊…。"}, {"i": 4942, "es": "No invitamos a Reika\ntambien?", "orig": "レイカも誘ってみない？"}, {"i": 4943, "es": "QUE BUENO QUE NO LO\nUSASTE", "orig": "ツケナクテ　ヨカッタナ"}, {"i": 4944, "es": "Jaja, te asuste?", "orig": "ははっ、びっくりした？"}, {"i": 4945, "es": "Ah, espera un momento.", "orig": "あ、ちょっと待ってよ。"}, {"i": 4946, "es": "Esto... no tendra que\nver...", "orig": "これは…関係ないか…。"}, {"i": 4947, "es": "Dicen que es peligroso\nsalir afuera.", "orig": "外に出たらやばいって。"}, {"i": 4948, "es": "Que tipo de lugar es?", "orig": "どんなトコなんですか？"}, {"i": 4949, "es": "Hay un pasadizo en un\nlugar asi!", "orig": "こんなところに通路が！"}, {"i": 4950, "es": "Si, hacer feliz a la\ngente,", "orig": "そう、人を喜ばせたり、"}, {"i": 4951, "es": "Se tranquilizo, y\ndesaparecio.", "orig": "安心して、消えたんだ。"}, {"i": 4952, "es": "Si acabamos de entrar.", "orig": "今入ったばっかりだろ。"}, {"i": 4953, "es": "Tenemos que reunirnos\ncon Masaki.", "orig": "マサキと合流しないと。"}, {"i": 4954, "es": "Yo prefiero ir primero.", "orig": "わたし、１番先がいい。"}, {"i": 4955, "es": "Nos tomo bastante\ntiempo.", "orig": "結構、時間かかったね。"}, {"i": 4956, "es": "Eh, que sera esto?", "orig": "あれ、これなんだろう？"}, {"i": 4957, "es": "Es un lugar de\nrecuerdos, verdad.", "orig": "思い出の場所なんだね。"}, {"i": 4958, "es": "Entonces, te lo tomo yo.", "orig": "じゃあ、とってあげる。"}, {"i": 4959, "es": "Perdon, me perdi.", "orig": "ごめん、迷っちゃった。"}, {"i": 4960, "es": "Esto es una puerta, no?", "orig": "ここ扉になってるよね？"}, {"i": 4961, "es": "Como no esta encendida\nla energia,", "orig": "電源が入ってないから、"}, {"i": 4962, "es": "Que esta pasando?", "orig": "なにが起こっているの？"}, {"i": 4963, "es": "Habia un mecanismo asi?", "orig": "こんな仕掛けあったか？"}, {"i": 4964, "es": "No digas cosas feas.", "orig": "やなこと言わないでよ。"}, {"i": 4965, "es": "......Por que\naqui......", "orig": "……なんでここに……。"}, {"i": 4966, "es": "Al final si era eso.", "orig": "やっぱりそうなんだな。"}, {"i": 4967, "es": "Senor Hasegawa,\nespere!", "orig": "ハセガワさん、待って！"}, {"i": 4968, "es": "Todos, calmense.", "orig": "みんな、落ち着くんだ。"}, {"i": 4969, "es": "O-oigan, ustedes!", "orig": "お、おい、おまえたち！"}, {"i": 4970, "es": "Se estan reuniendo.", "orig": "集まってきているんだ。"}, {"i": 4971, "es": "Ya, por favor, aqui\nno...", "orig": "ここはもう簡便して…。"}, {"i": 4972, "es": "Si no huimos nos van a\nmatar!", "orig": "逃げないと殺されるっ！"}, {"i": 4973, "es": "De donde salio?", "orig": "どこから出てきたんだ？"}, {"i": 4974, "es": "Nosotras, cuando\neramos pequenas,", "orig": "あたしたち、小さい時は"}, {"i": 4975, "es": "(Ah, tengo que tomar\nuna foto)", "orig": "（あ、写真とらなきゃ）"}, {"i": 4976, "es": "Que tipo de lugar es?", "orig": "どんなトコなんですか？"}, {"i": 4977, "es": "No hay algun arma para\npelear?", "orig": "戦う武器はないですか？"}, {"i": 4978, "es": "Ahora!\nCorran rapido!!", "orig": "いまだ！\n早く逃げろ！！"}, {"i": 4979, "es": "Tiene idea de quien es\nese payaso?", "orig": "あのピエロに心当たりは？"}, {"i": 4980, "es": "Quedate quieta un\nmomento.", "orig": "しばらくじっとしていて。"}, {"i": 4981, "es": "(Era una mirada de\nlocura)", "orig": "（狂気のまなざしでした）"}, {"i": 4982, "es": "Vamos a ver otros\nlugares tambien?", "orig": "他の場所も見てみようか。"}, {"i": 4983, "es": "Entendido. Ten cuidado.", "orig": "わかった。気をつけてね。"}, {"i": 4984, "es": "Aqui es la casa de\nespejos......", "orig": "ここがミラーハウス……。"}, {"i": 4985, "es": "Y eso que es el hijo del\ndueno...", "orig": "オーナーの息子なのに…。"}, {"i": 4986, "es": "No hay forma de volver a\ncomo estaba?", "orig": "元に戻る方法はないのか。"}, {"i": 4987, "es": "Todavia no termino de\ninvestigar.", "orig": "まだ調べ終わってないわ。"}, {"i": 4988, "es": "Una maqueta del Dream\nPark...", "orig": "ドリームパークの模型…。"}, {"i": 4989, "es": "Se parece muchisimo al\nsenor Hasegawa.", "orig": "ハセガワさんにそっくり。"}, {"i": 4990, "es": "Lo divertido, mas\ndivertido todavia?", "orig": "楽しいものはより楽しく？"}, {"i": 4991, "es": "Y eso que antes llorabas\na mares.", "orig": "昔は大泣きしたくせにな。"}, {"i": 4992, "es": "La caja fuerte de mi papa\nesta abierta!", "orig": "親父の金庫が開いている！"}, {"i": 4993, "es": "Solo mi papa sabia como\nabrirla.", "orig": "開け方は親父しか知らん。"}, {"i": 4994, "es": "Se puede encender la\nluz?", "orig": "電気つけられるんですか？"}, {"i": 4995, "es": "Sera que te da\ncuriosidad?", "orig": "ひょっとして、気になる？"}, {"i": 4996, "es": "No vamos con Reika\ntambien?", "orig": "レイカも一緒に行かない？"}, {"i": 4997, "es": "Mmm. No hay nada\ntirado.", "orig": "んー。何も落ちてないや。"}, {"i": 4998, "es": "Era una persona\ninteresante, verdad.", "orig": "面白い人だったんですね。"}, {"i": 4999, "es": "Una broma bien tipica de\nmi papa.", "orig": "親父らしいイタズラだな。"}, {"i": 5000, "es": "Habia alguna otra\ninformacion?", "orig": "ほかになにか情報あった？"}, {"i": 5001, "es": "Estaba tirado en el\nasiento.", "orig": "座席のところに落ちてた。"}, {"i": 5002, "es": "Encender la casa\nembrujada...", "orig": "お化け屋敷をＯＮっと…。"}, {"i": 5003, "es": "Esa nina... esa\nropa......", "orig": "あの女の子…あの服……。"}, {"i": 5004, "es": "Te esta persiguiendo el\npayaso!?", "orig": "ピエロに追われてるの！？"}, {"i": 5005, "es": "(El espejo esta un poco\ndeformado)", "orig": "（鏡に少しゆがみがある）"}, {"i": 5006, "es": "Lleno de crayon rojo,", "orig": "赤いクレヨンでいっぱい、"}, {"i": 5007, "es": "Oye, salgamos de aqui.\nRapido......!", "orig": "ね、ここ出よ。早く……！"}, {"i": 5008, "es": "N-no es asi...", "orig": "そ、そんなことないよ…。"}, {"i": 5009, "es": "Todavia no termino de\ninvestigar.", "orig": "まだ調べ終わってないわ。"}, {"i": 5010, "es": "Vamos a ver otros\nlugares tambien?", "orig": "他の場所も見てみようか。"}, {"i": 5011, "es": "Este lado era la salida?", "orig": "こっちは出口だったかな。"}, {"i": 5012, "es": "Esta bien oxidado.", "orig": "ずいぶん錆びついてるな。"}, {"i": 5013, "es": "Oye, no decidas por tu\ncuenta.", "orig": "おい、勝手に決めるなよ。"}, {"i": 5014, "es": "Tiene idea de que es esa\nsombra blanca?", "orig": "あの白い影に心当たりは？"}, {"i": 5015, "es": "(Era una mirada de\nlocura)", "orig": "（狂気のまなざしでした）"}, {"i": 5016, "es": "Esa cosa blanca es un\nfantasma?", "orig": "あの白いのは幽霊なのか？"}, {"i": 5017, "es": "Tiene alguna idea,\nverdad?", "orig": "心当たりがあるんですね？"}, {"i": 5018, "es": "Hay una razon para ello.", "orig": "何か、理由があるんです。"}, {"i": 5019, "es": "Hay una oficina.\nVamos ahi...", "orig": "事務所がある。\nそこへ…。"}, {"i": 5020, "es": "Solo quieres hacer una\nprueba de valor, no?", "orig": "ただ肝試ししたいだけだろ。"}, {"i": 5021, "es": "No hay nada raro en\nespecial.", "orig": "特に変わったものはないね。"}, {"i": 5022, "es": "Es como estar viviendo\nuna pesadilla.", "orig": "まるで悪夢を見てるようだ。"}, {"i": 5023, "es": "Masaki! Donde estas\nahora?", "orig": "マサキ！いまどこにいるの？"}, {"i": 5024, "es": "En fin, vamos rapido.", "orig": "とにかく、さっさと行くぞ。"}, {"i": 5025, "es": "......Entendido. Lo\nvoy a intentar.", "orig": "……わかった。やってみる。"}, {"i": 5026, "es": "Esta bien hecho. Sera\nreal?", "orig": "よく出来ているな。本物か？"}, {"i": 5027, "es": "Parece que arriba de\nesto esta frente a la\nrueda de la fortuna.", "orig": "この上が観覧車前みたいね。"}, {"i": 5028, "es": "Al principio todos se\nponen palidos.", "orig": "はじめは誰もが青ざめるね。"}, {"i": 5029, "es": "Y como prueba de que\nllegaste hasta el fondo,", "orig": "それで奥までいった証拠に、"}, {"i": 5030, "es": "Espera. Hablemoslo una\nvez.", "orig": "待って。一度話し合おうよ。"}, {"i": 5031, "es": "Si, hagamoslo.", "orig": "うん、やってやろうじゃん。"}, {"i": 5032, "es": "Sera un poco\ndescuidado?", "orig": "ちょっと大雑把でしょうか？"}, {"i": 5033, "es": "No hay nada raro en\nparticular.", "orig": "特に変わった様子はないな。"}, {"i": 5034, "es": "Para entrar al cuarto del\npersonal,", "orig": "スタッフルームに入るには、"}, {"i": 5035, "es": "El dueno del Dream\nPark?", "orig": "ドリームパークのオーナー？"}, {"i": 5036, "es": "(Esta es la verdad detras\ndel rumor......)", "orig": "（これがウワサの真相……）"}, {"i": 5037, "es": "Ya no hace falta que te\npreocupes por nada.", "orig": "もう何も心配しなくていい。"}, {"i": 5038, "es": "Adentro esta oscuro, ten\ncuidado.", "orig": "中は暗いから気をつけろよ。"}, {"i": 5039, "es": "Por que, cuando llame\npor primera vez,", "orig": "なんで最初に電話したとき、"}, {"i": 5040, "es": "Es un mecanismo.", "orig": "仕掛けになっているんだよ。"}, {"i": 5041, "es": "Parece algo que vi en la\ncasa embrujada...", "orig": "お化け屋敷で見たような…。"}, {"i": 5042, "es": "Sera una luz decorativa?", "orig": "イルミネーションライトか？"}, {"i": 5043, "es": "Quiere decir que ilumine\nla oscuridad?", "orig": "暗闇を明るくしろってこと？"}, {"i": 5044, "es": "E-esto es un\nllanto......", "orig": "な、泣き声だよ、これ……。"}, {"i": 5045, "es": "No importa, vamos\nrapido.", "orig": "どうでもいいから早く行こ。"}, {"i": 5046, "es": "El aire esta frio......", "orig": "空気がひんやりしてる……。"}, {"i": 5047, "es": "El dueno del Dream\nPark?", "orig": "ドリームパークのオーナー？"}, {"i": 5048, "es": "Por que estas aqui a esta\nhora?", "orig": "何で、こんな時間にここに？"}, {"i": 5049, "es": "No hay nada raro en\nparticular.", "orig": "特に変わった様子はないな。"}, {"i": 5050, "es": "No, antes pensaba eso.", "orig": "ううん、前はそう思ってた。"}, {"i": 5051, "es": "Tengo que revisar el\ncontenido de la caja\nfuerte.", "orig": "金庫の中身を確かめなきゃ。"}, {"i": 5052, "es": "Habra existido ese\nrumor?", "orig": "そんなウワサあったかなぁ。"}, {"i": 5053, "es": "Que es esta sensacion?\nEs como...", "orig": "なんだこの感じ？まるで…。"}, {"i": 5054, "es": "El aire esta frio......", "orig": "空気がひんやりしてる……。"}, {"i": 5055, "es": "Ademas, ese\npayaso......", "orig": "それに、あのピエロは……。"}, {"i": 5056, "es": "Hazme el favor!\nVamos.", "orig": "そこをなんとか！\n行こうよ。"}, {"i": 5057, "es": "Papa! Soy yo!\nMe olvidaste!?", "orig": "親父！俺だよ！\n忘れたのか！"}, {"i": 5058, "es": "No hay alguna via de\nescape por algun lado?", "orig": "どこかに逃げ道はないですか？"}, {"i": 5059, "es": "Esta bastante bien\nelaborado.", "orig": "なかなか作りこまれているな。"}, {"i": 5060, "es": "Dicen que ponen cosas\nreales.", "orig": "本物を置いているって噂だよ。"}, {"i": 5061, "es": "Voy a avisarle a la policia\ntambien, pero...", "orig": "警察にも連絡しておくけど…。"}, {"i": 5062, "es": "Cuando era pequeno me\ngustaba.", "orig": "ちっちゃいとき好きだったな。"}, {"i": 5063, "es": "Lo divertido, mas\ndivertido todavia...", "orig": "楽しいものは、より楽しく…。"}, {"i": 5064, "es": "Por que no lo revisas de\nnuevo con calma?", "orig": "もう１度よく見直してみたら？"}, {"i": 5065, "es": "Por que no lo revisas de\nnuevo con calma?", "orig": "もう１度よく見直してみたら？"}, {"i": 5066, "es": "Esta caja fuerte no tiene\ncombinacion...", "orig": "この金庫、ダイヤルがない…。"}, {"i": 5067, "es": "Lo divertido, mas\ndivertido todavia...", "orig": "楽しいものは、より楽しく…。"}, {"i": 5068, "es": "Parece algo que vi en la\ncasa de espejos...", "orig": "ミラーハウスで見たような…。"}, {"i": 5069, "es": "Puede que sea asi,\npero...", "orig": "それはそうかもしれないが…。"}, {"i": 5070, "es": "Entre Riko, Yuuta y yo,\nlos tres.", "orig": "リコと俺とユウタと３人でね。"}, {"i": 5071, "es": "Es el parque de\ndiversiones que estaba\ncerca de aqui.", "orig": "この近くにあった遊園地だよ。"}, {"i": 5072, "es": "La verdad es que yo, en\nel Dream Park,", "orig": "実はわたし、ドリームパークで"}, {"i": 5073, "es": "Es que yo me\nadelante...", "orig": "僕は先に行っちゃったから…。"}, {"i": 5074, "es": "De verdad hace tiempo\nque no venia. Que\nnostalgia.", "orig": "久しぶりだね本当。懐かしい。"}, {"i": 5075, "es": "Si. Si subes solo a la\nrueda de la fortuna,", "orig": "うん。観覧車に１人で乗ると、"}, {"i": 5076, "es": "(La cerradura\nelectronica esta\nabierta...)", "orig": "（電子ロックが開いている…）"}, {"i": 5077, "es": "No asustes tanto a\nMizuki.", "orig": "あんまりミズキを脅かすなよ。"}, {"i": 5078, "es": "Hay rumores raros como\nese.", "orig": "とかヘンなウワサがあってさ。"}, {"i": 5079, "es": "No es nada del otro\nmundo!", "orig": "そんな大したものじゃないよ！"}, {"i": 5080, "es": "Es-espera un momento.", "orig": "ちょ、ちょっと待ちなさいよ。"}, {"i": 5081, "es": "Gracias a eso ayer\nestuve ocupada.", "orig": "昨日はおかげで忙しかったわ。"}, {"i": 5082, "es": "La maquina no esta\nencendida, verdad?", "orig": "機械の電源は入ってないよな？"}, {"i": 5083, "es": "Si de alguna forma\ncerramos la puerta...", "orig": "どうにかして扉を閉めれば…。"}, {"i": 5084, "es": "Oye, que es el Dream\nPark?", "orig": "ねえ、ドリームパークって何？"}, {"i": 5085, "es": "Masaki esta frente a la\nrueda de la fortuna, no?", "orig": "マサキは観覧車前にいるよね？"}, {"i": 5086, "es": "Por que hay un globo en\nun lugar asi...", "orig": "どうして風船がこんな所に…。"}, {"i": 5087, "es": "Masaki esta frente a la\nrueda de la fortuna, no?", "orig": "マサキは観覧車前にいるよね？"}, {"i": 5088, "es": "Senor Hasegawa, espere\npor favor!", "orig": "ハセガワさん、待って下さい！"}, {"i": 5089, "es": "El dueno... osea, su\npapa,", "orig": "オーナー…\nつまりお父さんは、"}, {"i": 5090, "es": "Si le hago recordar ese\nsentimiento,", "orig": "そんな気持ちを思い出させれば、"}, {"i": 5091, "es": "Vamos a recorrer\nrevisando este mapa.", "orig": "この地図で確認しながらまわろ。"}, {"i": 5092, "es": "...Ya veo, otra vez te\nviste envuelta en esto.", "orig": "…そう、また巻き込まれたのね。"}, {"i": 5093, "es": "Que se supone que haga\nyo...", "orig": "いったいわたし、どうすれば…。"}, {"i": 5094, "es": "(Y esa nina... que fue\nde ella......?)", "orig": "（そして、あの女の子は……？）"}, {"i": 5095, "es": "(Dejando varios\nmisterios sin resolver,)", "orig": "（いろいろな謎を残したまま、）"}, {"i": 5096, "es": "Si, lo pense a mi\nmanera.", "orig": "うん、わたしなりに考えてみた。"}, {"i": 5097, "es": "Tanto que un payaso\nmaligno no pueda\nquedarse?", "orig": "邪悪なピエロがいられないほど？"}, {"i": 5098, "es": "Si. Lo divertido, mas\ndivertido todavia,", "orig": "そう。楽しいものはより楽しく、"}, {"i": 5099, "es": "Hay algo que quiero que\nhagan.", "orig": "やってもらいたいことがあるの。"}, {"i": 5100, "es": "No puede ser tan\ndescuidado.", "orig": "そんなに大雑把なわけないだろ。"}]