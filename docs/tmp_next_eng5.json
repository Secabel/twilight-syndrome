[{"i": 1201, "es": "Eh, por que?", "orig": "えっ、どうして？"}, {"i": 1202, "es": "Es de mal gusto.", "orig": "タチが悪いのよ。"}, {"i": 1203, "es": "No lo sabia...", "orig": "知らなかった…。"}, {"i": 1204, "es": "Que quieres\ndecir...?", "orig": "どういうこと…？"}, {"i": 1205, "es": "(......El edificio\nviejo...)", "orig": "（……旧校舎…）"}, {"i": 1206, "es": "Jaja, perdon.", "orig": "あはは、ごめん。"}, {"i": 1207, "es": "Eeh, por que?", "orig": "えーっ、なんで？"}, {"i": 1208, "es": "El tercer piso......\nDonde?", "orig": "３階の……どこ？"}, {"i": 1209, "es": "...Mejor me\nvoy...", "orig": "…帰ろっかな…。"}, {"i": 1210, "es": "Riko, que hacemos?", "orig": "リコ、どうする？"}, {"i": 1211, "es": "En ese caso.......", "orig": "その時は………。"}, {"i": 1212, "es": "Aun asi...", "orig": "それにしても…。"}, {"i": 1213, "es": "Es solo un\nrumor......", "orig": "ウワサだし……。"}, {"i": 1214, "es": "Asi que era eso.", "orig": "そうだったんだ。"}, {"i": 1215, "es": "Eh? Sola...?", "orig": "えっ？１人で…？"}, {"i": 1216, "es": "Que piensa Riko?", "orig": "リコはどう思う？"}, {"i": 1217, "es": "Que quieres\ndecir...?", "orig": "どういうこと…？"}, {"i": 1218, "es": "...Sexto\nsentido...eh...", "orig": "…霊感…ねえ…。"}, {"i": 1219, "es": "No es eso.", "orig": "それじゃないよ。"}, {"i": 1220, "es": "Espera un poco.", "orig": "ちょっと待って。"}, {"i": 1221, "es": "Toryanse", "orig": "「とおりゃんせ」"}, {"i": 1222, "es": "En ese caso.......", "orig": "その時は………。"}, {"i": 1223, "es": "Te voy a estar\nesperando!", "orig": "待ってるからね！"}, {"i": 1224, "es": "Escucha, escucha!", "orig": "聞いて、聞いて！"}, {"i": 1225, "es": "Mmm, con la B!!", "orig": "うーん、Ｂで！！"}, {"i": 1226, "es": "Es de mal gusto.", "orig": "タチが悪いのよ。"}, {"i": 1227, "es": "Solo una, eso si.", "orig": "１つだけだけど。"}, {"i": 1228, "es": "Kagome Kagome", "orig": "「かごめかごめ」"}, {"i": 1229, "es": "Si...pero...", "orig": "そう…だけど…。"}, {"i": 1230, "es": "Mira, el\nedificio...", "orig": "見て、校舎が…。"}, {"i": 1231, "es": "No sera un\nfantasma?", "orig": "幽霊じゃないの？"}, {"i": 1232, "es": "Confien en la\nprofesora.", "orig": "先生を信頼して。"}, {"i": 1233, "es": "...Que quieres\ndecir?", "orig": "…どういうこと？"}, {"i": 1234, "es": "Que polvo...", "orig": "すごいホコリ…。"}, {"i": 1235, "es": "......Que fue eso?", "orig": "……なに、今の？"}, {"i": 1236, "es": "Es de mal gusto.", "orig": "タチが悪いのよ。"}, {"i": 1237, "es": "Eh? Que es eso.", "orig": "えっ？なにそれ。"}, {"i": 1238, "es": "Yo no lo hice.", "orig": "私はしなかった。"}, {"i": 1239, "es": "Esta con llave.", "orig": "鍵がかかってる。"}, {"i": 1240, "es": "Que te pasa?", "orig": "“どうしたの？”"}, {"i": 1241, "es": "No sera de\narriba?", "orig": "上からじゃない？"}, {"i": 1242, "es": "Es de mal gusto.", "orig": "タチが悪いのよ。"}, {"i": 1243, "es": "Tengo un poco\nde miedo...", "orig": "ちょっと不安が…"}, {"i": 1244, "es": "Yo tambien", "orig": "“あたしもだよ”"}, {"i": 1245, "es": "Por que, aqui.", "orig": "なんで、ここに。"}, {"i": 1246, "es": "Ponte las pilas.", "orig": "しっかりしてよ。"}, {"i": 1247, "es": "Voy a revisar el\nedificio viejo", "orig": "旧校舎を見てみる"}, {"i": 1248, "es": "Correo en cadena?", "orig": "チェーンメール？"}, {"i": 1249, "es": "Solo una, eso si.", "orig": "１つだけだけど。"}, {"i": 1250, "es": "Viene de la\nbodega", "orig": "“倉庫からだよ”"}, {"i": 1251, "es": "...Que tipo mas\ngrosero...", "orig": "…失礼なヤツ…。"}, {"i": 1252, "es": "Todavia suena.", "orig": "まだ、鳴るんだ。"}, {"i": 1253, "es": "Pero, hace un\nrato...", "orig": "でも、さっき…。"}, {"i": 1254, "es": "Este edificio\nviejo...", "orig": "この旧校舎が…。"}, {"i": 1255, "es": "Parece que se\nva a romper...", "orig": "割れそうだよ…。"}, {"i": 1256, "es": "Le tienes miedo\na los animales?", "orig": "動物、苦手なの？"}, {"i": 1257, "es": "Dejamelo a mi", "orig": "わたしにまかせて"}, {"i": 1258, "es": "Arisa! Arisa!", "orig": "アリサ！アリサ！"}, {"i": 1259, "es": "Que hacemos?\nEntramos?", "orig": "どうする？入る？"}, {"i": 1260, "es": "El tono de\nllamada del\ncelular?", "orig": "携帯の…着メロ？"}, {"i": 1261, "es": "El refugio\nantiaereo esta\nmas alla...", "orig": "防空壕はこの奥…。"}, {"i": 1262, "es": "Hay que\nconfirmarlo...", "orig": "たしかめないと…。"}, {"i": 1263, "es": "Quiero\nintentarlo, pero...", "orig": "やってみたいけど…"}, {"i": 1264, "es": "Entonces, Kana...", "orig": "じゃあ、カナが…。"}, {"i": 1265, "es": "......No me\npuedo calmar...", "orig": "……落ち着かない…"}, {"i": 1266, "es": "Era verdad.", "orig": "ホントだったんだ。"}, {"i": 1267, "es": "Donde esta\nsonando?", "orig": "どこで鳴いてるの？"}, {"i": 1268, "es": "Que es\nesto......basura?", "orig": "なにこれ……ゴミ？"}, {"i": 1269, "es": "Tal vez, pero......", "orig": "たぶんだけど……。"}, {"i": 1270, "es": "Ya esta muerto...", "orig": "もう死んでるよ…。"}, {"i": 1271, "es": "Yo...ya no doy\nmas.", "orig": "あたし…もう限界。"}, {"i": 1272, "es": "Como...lo sabes.", "orig": "なんで…わかるの。"}, {"i": 1273, "es": "Jah......jah......", "orig": "はあ……はあ……。"}, {"i": 1274, "es": "Ah, profesora\nYukari...", "orig": "あ、ユカリ先生…。"}, {"i": 1275, "es": "...Ya no doy\nmas.", "orig": "…もう…限界だよ。"}, {"i": 1276, "es": "Eh, un zorro...?", "orig": "えっ、キツネが…？"}, {"i": 1277, "es": "Eh, era asi?", "orig": "えっ、そうだっけ？"}, {"i": 1278, "es": "Yuuta, no tienes\nalgo?", "orig": "ユウタ、何かない？"}, {"i": 1279, "es": "Eh, que era?", "orig": "えっ、なんだっけ？"}, {"i": 1280, "es": "Asi se habla!", "orig": "そうこなくっちゃ！"}, {"i": 1281, "es": "Yuuta, no tienes\nalgo?", "orig": "ユウタ、何かない？"}, {"i": 1282, "es": "La vieja\nmorada...?", "orig": "ムラサキババア…？"}, {"i": 1283, "es": "Que es...esta\ninquietud...", "orig": "なに…この胸騒ぎ…"}, {"i": 1284, "es": "El espejo\nmorado...?", "orig": "ムラサキカガミ…？"}, {"i": 1285, "es": "Puede ser.", "orig": "かもしれないわね。"}, {"i": 1286, "es": "......Parece que\nno sirve...", "orig": "……ダメみたい…。"}, {"i": 1287, "es": "Te refieres a\nuno por uno...?", "orig": "１通ずつって事…？"}, {"i": 1288, "es": "...Bueno, nos\nvemos.", "orig": "…そう、じゃあね。"}, {"i": 1289, "es": "Te digo que no se...", "orig": "わかんないって…。"}, {"i": 1290, "es": "..........Es cierto.", "orig": "…………そうだね。"}, {"i": 1291, "es": "Uh...que aire\nmalo...", "orig": "うっ…空気悪っ…。"}, {"i": 1292, "es": "Que tonta eres.", "orig": "バッカじゃないの。"}, {"i": 1293, "es": "Te refieres al\nfondo del pasillo?", "orig": "廊下の奥ってこと？"}, {"i": 1294, "es": "El espejo, hay\nque usar el\nespejo.", "orig": "鏡よ、鏡を使うの。"}, {"i": 1295, "es": "...Si...entendido.", "orig": "…うん…わかった。"}, {"i": 1296, "es": "Eh......que es\neso...", "orig": "え……なにそれ…。"}, {"i": 1297, "es": "Esto es el\nedificio viejo...", "orig": "これ、旧校舎だ…。"}, {"i": 1298, "es": "No se abre, no?", "orig": "開かないんでしょ？"}, {"i": 1299, "es": "Asi es, vamos!", "orig": "そうだよ、行こっ！"}, {"i": 1300, "es": "Eso es muy\ntipico de ti.", "orig": "あんたらしいって。"}, {"i": 1301, "es": "...Tengo esa\nsensacion.", "orig": "…そんな気がする。"}, {"i": 1302, "es": "(...Desaparicion\nmisteriosa...)", "orig": "（…カミカクシ…）"}, {"i": 1303, "es": "...Profesora...\npor que...", "orig": "…先生…なんで…。"}, {"i": 1304, "es": "Estas llamando\nvarias veces?", "orig": "何回もかけてる訳？"}, {"i": 1305, "es": "Dicen que nos\nlo diran.", "orig": "教えてくれるって。"}, {"i": 1306, "es": "...Ah......si......", "orig": "…あ……うん……。"}, {"i": 1307, "es": "Porque lo\nhice......?", "orig": "実行したから……？"}, {"i": 1308, "es": "Otra vez...lo\nescuche...", "orig": "また…聞こえた…。"}, {"i": 1309, "es": "Esta con llave.", "orig": "カギがかかってる。"}, {"i": 1310, "es": "Voy a llamar\na Kana", "orig": "カナに電話してみる"}, {"i": 1311, "es": "Eeh, eso es todo?", "orig": "えーっ、それだけ？"}, {"i": 1312, "es": "Por que, eso...", "orig": "なんで、それが…。"}, {"i": 1313, "es": "...Yo...ya...", "orig": "…あたし…もう…。"}, {"i": 1314, "es": "Te digo que no\nes eso.", "orig": "それじゃないって。"}, {"i": 1315, "es": "Ah, no era eso.", "orig": "なんだ、違うんだ。"}, {"i": 1316, "es": "En mi curso...", "orig": "わたしのクラスで…"}, {"i": 1317, "es": "Dame esa\ndireccion", "orig": "そのアドレス教えて"}, {"i": 1318, "es": "Tal vez...por\naqui.", "orig": "たぶん…この辺り。"}, {"i": 1319, "es": "Es el armario\nde limpieza.", "orig": "掃除用具入れだね。"}, {"i": 1320, "es": "El espejo\nmorado...?", "orig": "ムラサキカガミ…？"}, {"i": 1321, "es": "...Que cancion\nera...", "orig": "…何の歌だっけ…。"}, {"i": 1322, "es": "Ya estoy bien...", "orig": "もう大丈夫です…。"}, {"i": 1323, "es": "Otra vez con eso.", "orig": "またそういうこと。"}, {"i": 1324, "es": "Mmm, y ademas...", "orig": "うーん、あとは…。"}, {"i": 1325, "es": "Una...cancion\ninfantil...!", "orig": "わ…わらべうた…！"}, {"i": 1326, "es": "Kokkuri-san...", "orig": "コックリさんが…。"}, {"i": 1327, "es": "Bueno, voy a\nabrir.", "orig": "じゃあ、開けるよ。"}, {"i": 1328, "es": "Nada mal,\nMizuki!", "orig": "やるじゃんミズキ！"}, {"i": 1329, "es": "El celular...\ndonde esta?", "orig": "ケータイは…どこ？"}, {"i": 1330, "es": "Si...de donde...?", "orig": "うん…どこから…？"}, {"i": 1331, "es": "Eso es grave.", "orig": "やばくない、それ。"}, {"i": 1332, "es": "......Entendido.", "orig": "……わかりました。"}, {"i": 1333, "es": "...Ah, me\nacorde.", "orig": "…あ、思い出した。"}, {"i": 1334, "es": "Le paso lo de\nla desaparicion\nmisteriosa...?", "orig": "神隠しにあった…？"}, {"i": 1335, "es": "Basta ya...", "orig": "やめてよ、もう…。"}, {"i": 1336, "es": "Esto es un\nzorro.", "orig": "これはキツネだね。"}, {"i": 1337, "es": "Sera que\ntodavia sirve?", "orig": "まだ使えるのかな？"}, {"i": 1338, "es": "Desde el otro\nlado...?", "orig": "向こうの方から…？"}, {"i": 1339, "es": "Llevame ahi.", "orig": "そこに連れてって。"}, {"i": 1340, "es": "La vieja\nmorada...?", "orig": "ムラサキババア…？"}, {"i": 1341, "es": "Un animal...\nen serio.", "orig": "動物って…いったい。"}, {"i": 1342, "es": "Perdon, mejor\nno", "orig": "ごめん、やめておくよ"}, {"i": 1343, "es": "Es el papel para\nel examen de\nvista.", "orig": "視力検査用の紙だね。"}, {"i": 1344, "es": "El del tono de\nllamada de\nantes...?", "orig": "さっきの着メロの…？"}, {"i": 1345, "es": "Al fondo de este\npiso......", "orig": "この階の奥の方……。"}, {"i": 1346, "es": "Mejor no, al\nfinal", "orig": "やっぱり、やめておく"}, {"i": 1347, "es": "Desde el fondo\ndel pasillo...?", "orig": "廊下の奥の方から…？"}, {"i": 1348, "es": "Tambien tiene\nsentido\nenfrentarse.", "orig": "向き合う意味もある。"}, {"i": 1349, "es": "Ah. Ya veo.", "orig": "ふ〜ん。そうなんだ。"}, {"i": 1350, "es": "Oye, el pelo de\nese animal...", "orig": "ね、今の動物の毛…。"}, {"i": 1351, "es": "Tal vez podamos\nbuscarlo.", "orig": "探せるかもしれない。"}, {"i": 1352, "es": "Eeh, que es\neso...", "orig": "ええっ、なにそれ…。"}, {"i": 1353, "es": "Que deberia\nhacer...", "orig": "どうしたらいいの…。"}, {"i": 1354, "es": "(Parece que lo\nguardaron)", "orig": "（しまったようです）"}, {"i": 1355, "es": "...No se......", "orig": "…わかんないよ……。"}, {"i": 1356, "es": "El de abajo,\nno? Vamos!", "orig": "やっぱり下？いこっ！"}, {"i": 1357, "es": "Queda algo de\npartitura.", "orig": "楽譜とかが残ってる。"}, {"i": 1358, "es": "...Una comadreja\ndisecada?", "orig": "…イタチのはくせい？"}, {"i": 1359, "es": "Ah......ay......", "orig": "あぁ……いてて……。"}, {"i": 1360, "es": "Deje de\nescucharlo...", "orig": "聞こえなくなった…。"}, {"i": 1361, "es": "Sera que no se\npuede mas...", "orig": "これ以上は無理か…。"}, {"i": 1362, "es": "Dicen que lo\nencontraron.", "orig": "発見されたんだって。"}, {"i": 1363, "es": "Otra vez...se\nescapo...?", "orig": "また…逃げられた…？"}, {"i": 1364, "es": "Eh? Un\ncorreo........?", "orig": "えっ？メール………？"}, {"i": 1365, "es": "Fuiste a la\nbodega?", "orig": "倉庫には行ってみた？"}, {"i": 1366, "es": "......Este,\nprofesora......", "orig": "……あの、先生……。"}, {"i": 1367, "es": "Mmm, no hay...", "orig": "うーん、無いなぁ…。"}, {"i": 1368, "es": "(Esta con llave...)", "orig": "（鍵がかかってる…）"}, {"i": 1369, "es": "Yo me enoje, eso\nsi.", "orig": "私は、怒ったけどね。"}, {"i": 1370, "es": "Esta vez no se\nme escapa.", "orig": "今度こそ逃がさない。"}, {"i": 1371, "es": "Y ademas...la\nenfermeria?", "orig": "あとは…保健室とか？"}, {"i": 1372, "es": "Si. Vamos a\nver.", "orig": "うん。行ってみよう。"}, {"i": 1373, "es": "Ah, Mizuki,\nbuenos dias.", "orig": "あ、ミズキ、おはよ。"}, {"i": 1374, "es": "Estaba\nexhibido.", "orig": "飾ってあったんだよ。"}, {"i": 1375, "es": "Golpeemos la\npared.", "orig": "壁をたたいてみよっ。"}, {"i": 1376, "es": "...Otra vez...lo\nescuche.", "orig": "…また……聞こえた。"}, {"i": 1377, "es": "Calmate...yo...", "orig": "落ち着け…わたし…。"}, {"i": 1378, "es": "Ella es Izumi\nReika.", "orig": "彼女がイズミレイカ。"}, {"i": 1379, "es": "No es eso, no?", "orig": "それじゃないでしょ。"}, {"i": 1380, "es": "No se sabe su\nparadero.", "orig": "行方が分からないの。"}, {"i": 1381, "es": "Deje de\nescucharlo...", "orig": "聞こえなくなった…。"}, {"i": 1382, "es": "Deje de\nescucharlo...", "orig": "聞こえなくなった…。"}, {"i": 1383, "es": "Eh, que quieres\ndecir?", "orig": "えっ、どういうこと？"}, {"i": 1384, "es": "Y ademas...\nmmm......", "orig": "あとは…うーん……。"}, {"i": 1385, "es": "No, definitivamente\nno.", "orig": "いや、ゼッタイいや。"}, {"i": 1386, "es": "Esta...con\nllave.", "orig": "カギが…かかってる。"}, {"i": 1387, "es": "Donde esta Kana?", "orig": "カナはどこにいるの？"}, {"i": 1388, "es": "Mmm, elijo la\nA!!", "orig": "うーん、Ａにする！！"}, {"i": 1389, "es": "Es una leyenda\nurbana famosa.", "orig": "有名な都市伝説だよ。"}, {"i": 1390, "es": "Es que lo dijiste.", "orig": "言ってたんだからさ。"}, {"i": 1391, "es": "Voy a llamar\na Megumi", "orig": "メグミに電話してみる"}, {"i": 1392, "es": "Ah, si. Es\ncierto.", "orig": "あ、うん。そうだね。"}, {"i": 1393, "es": "Este sonido...\nKana...?", "orig": "この鳴き声…カナ…？"}, {"i": 1394, "es": "...Al final...\nun zorro...", "orig": "…やっぱり…キツネ…"}, {"i": 1395, "es": "...Mmm,\nentendido.", "orig": "…うーん、わかった。"}, {"i": 1396, "es": "Lo de la\ndesaparicion\nmisteriosa...me\npreocupa", "orig": "神隠しって…気になる"}, {"i": 1397, "es": "(Una fuerte\nalteracion\nmagnetica...)", "orig": "（強い磁場の乱れ…）"}, {"i": 1398, "es": "...No puede\nser......Nanashi?", "orig": "…まさか……ナナシ？"}, {"i": 1399, "es": "Esta...con\nllave.", "orig": "カギが…かかってる。"}, {"i": 1400, "es": "Mejor dejemoslo,\nal final", "orig": "やっぱり、やめようよ"}, {"i": 1401, "es": "Ah, espera un\npoco.", "orig": "あ、ちょっと待って。"}, {"i": 1402, "es": "Eso fue...Riko?\nMizuki?", "orig": "今の…リコ？ミズキ？"}, {"i": 1403, "es": "(Se habia\nperdido)", "orig": "（失われていました）"}, {"i": 1404, "es": "Lo del correo en\ncadena...", "orig": "チェーンメールって…"}, {"i": 1405, "es": "Ya, entendi...", "orig": "もう、分かったよ…。"}, {"i": 1406, "es": "De donde...se\nescucha?", "orig": "どこから…聞こえる？"}, {"i": 1407, "es": "Ah, era asi......", "orig": "あ、そうだっけ……。"}, {"i": 1408, "es": "(Hay que cantar\nrapido...)", "orig": "（早く歌わないと…）"}, {"i": 1409, "es": "(Hay que cantar\nrapido...)", "orig": "（早く歌わないと…）"}, {"i": 1410, "es": "No se... tengo un mal\npresentimiento...", "orig": "なんか…不安なの…。"}, {"i": 1411, "es": "Te digo que no es asi.", "orig": "そんなことないって。"}, {"i": 1412, "es": "Oye... oyes eso?", "orig": "ねえ……聞こえない？"}, {"i": 1413, "es": "Viniste a ayudarme!", "orig": "助けに来てくれたの！"}, {"i": 1414, "es": "Espera un momento...", "orig": "…ちょっと待って…。"}, {"i": 1415, "es": "Huele a moho...", "orig": "なんか…かび臭い…。"}, {"i": 1416, "es": "Nos esta atrayendo...", "orig": "引き寄せてしまう…。"}, {"i": 1417, "es": "Ah, hay una llave\nadentro...", "orig": "あっ、中にカギが…。"}, {"i": 1418, "es": "La salida esta justo\nahi, pero...", "orig": "外は目の前なのに…。"}, {"i": 1419, "es": "Oye, la llave\nde antes...", "orig": "ね、さっきのカギ…。"}, {"i": 1420, "es": "No hay de otra...", "orig": "…しょうがないな…。"}, {"i": 1421, "es": "Alguien lo menciono,\ncreo.", "orig": "誰かが言ってたっけ。"}, {"i": 1422, "es": "Dicen que la\nencontraron.", "orig": "発見されたんだって。"}, {"i": 1423, "es": "No sera... Nanashi?", "orig": "…まさか……ナナシ？"}, {"i": 1424, "es": "Hay medicinas y cosas\nasi...", "orig": "薬とかが入ってる…。"}, {"i": 1425, "es": "Eso si que no,\npor favor.", "orig": "それはカンベンして。"}, {"i": 1426, "es": "Ya no se oye\nnada...", "orig": "聞こえなくなった…。"}, {"i": 1427, "es": "Es la sala de archivos\ndel sotano.", "orig": "地下の資料室だけど。"}, {"i": 1428, "es": "Que hay en el\npasillo...?", "orig": "…廊下に何がいるの…？"}, {"i": 1429, "es": "Yo me quedare quieta.", "orig": "あたしはじっとしてる。"}, {"i": 1430, "es": "Aunque digas\neso...", "orig": "そんなこと言われても。"}, {"i": 1431, "es": "Nanashi tambien\nlo dijo.", "orig": "ナナシも言ってたよね。"}, {"i": 1432, "es": "Entonces, que\nhacemos...", "orig": "じゃあ、どうしたら…。"}, {"i": 1433, "es": "Ah!? Que quiere\ndecir eso?", "orig": "はあ！？どういうこと？"}, {"i": 1434, "es": "Arisa esta internada,\nno?", "orig": "アリサは入院中でしょ。"}, {"i": 1435, "es": "Al fondo... del otro\npasillo?", "orig": "奥……向こう廊下の方？"}, {"i": 1436, "es": "Es pelo... pelo de\nanimal...?", "orig": "毛…だ……動物の毛…？"}, {"i": 1437, "es": "Esto... esto es malo...", "orig": "……やばいよ…これ…。"}, {"i": 1438, "es": "Esa era... la voz de\nKana...", "orig": "あれは…カナ…の声…。"}, {"i": 1439, "es": "Esta poseida...", "orig": "…とり憑かれたんだ…。"}, {"i": 1440, "es": "(Sera posible\nhacerlo?)", "orig": "（出来るのでしょうか）"}, {"i": 1441, "es": "Por que haria algo\nasi...", "orig": "なんで、そんなこと…。"}, {"i": 1442, "es": "El edificio viejo es\npeligroso?", "orig": "旧校舎って、やばいの？"}, {"i": 1443, "es": "Oye, no se\npodra romper eso?", "orig": "ね、それ割れないかな。"}, {"i": 1444, "es": "Dicen que es alguien\nelegido.", "orig": "選ばれた人らしいって。"}, {"i": 1445, "es": "Creo que si, tal vez.", "orig": "たぶん…そうだと思う。"}, {"i": 1446, "es": "No parece que\nKana este aqui.", "orig": "カナはいそうにないね。"}, {"i": 1447, "es": "(Tengo que ir a la\nbiblioteca)", "orig": "（図書室に行かなきゃ）"}, {"i": 1448, "es": "Y? Ya te acostumbraste\na la escuela?", "orig": "どう？学校には慣れた？"}, {"i": 1449, "es": "Un zorro disecado...", "orig": "キツネのはくせい……。"}, {"i": 1450, "es": "Hay que salir de aqui\nrapido...", "orig": "早くここから出ないと…"}, {"i": 1451, "es": "Tal vez podamos salir\npor la entrada...", "orig": "玄関から出れるかも…。"}, {"i": 1452, "es": "Llego! Es de Nanashi.", "orig": "きたっ！ナナシからだ。"}, {"i": 1453, "es": "No sabia que existia\nalgo asi...", "orig": "そんなのがあるんだ…。"}, {"i": 1454, "es": "Si, entendido...", "orig": "うん、わかりました…。"}, {"i": 1455, "es": "Al final es dentro del\nedificio viejo...?", "orig": "やっぱり旧校舎の中…？"}, {"i": 1456, "es": "Es un recuerdo, nada\nmas. Ya esta?", "orig": "記念だよ、キネン。ね？"}, {"i": 1457, "es": "Pero no te parece raro?", "orig": "…でも疑問に思わない？"}, {"i": 1458, "es": "Tu eres la nueva, no?", "orig": "あんた、転校生でしょ？"}, {"i": 1459, "es": "Riko, tu\ntambien ayuda.", "orig": "リコも手伝いなさいよ。"}, {"i": 1460, "es": "Asi que nos llamo a\nesta azotea.", "orig": "この屋上に呼んだのか。"}, {"i": 1461, "es": "Ah, no me crees,\nverdad?", "orig": "あ、信じてないでしょ。"}, {"i": 1462, "es": "Dicen que no pueden\ncontactarla...", "orig": "連絡が取れないって…。"}, {"i": 1463, "es": "No hay otra opcion,\nverdad?", "orig": "他に手はないんでしょ？"}, {"i": 1464, "es": "Pero, que\nhacemos con esto?", "orig": "でも、どうする、これ。"}, {"i": 1465, "es": "(Un zorro disecado...)", "orig": "（キツネのはくせい…）"}, {"i": 1466, "es": "Parece que algo paso.", "orig": "何かが起きたみたいね。"}, {"i": 1467, "es": "Hay algun lugar donde\nno hayamos ido?", "orig": "他に行ってない場所は？"}, {"i": 1468, "es": "Creo que tambien\nhabia ese rumor.", "orig": "ウワサもあったような。"}, {"i": 1469, "es": "A veces se manifiesta,\nsabes.", "orig": "発揮することもあるの。"}, {"i": 1470, "es": "Esa persona\nes... Izumi Reika?", "orig": "あの人が…泉レイカ…？"}, {"i": 1471, "es": "Es un tanuki disecado.", "orig": "タヌキのはくせいだね。"}, {"i": 1472, "es": "(Eso fue un sueno?)", "orig": "（あれは夢だったの？）"}, {"i": 1473, "es": "Por que se\ncorrompio el texto?", "orig": "なんで文字化けしたの？"}, {"i": 1474, "es": "El deposito esta\nal fondo, no?", "orig": "倉庫は１階の奥だよね。"}, {"i": 1475, "es": "Eh...? No abre...", "orig": "…えっ、…開かない…。"}, {"i": 1476, "es": "Es broma... dejalo ya.", "orig": "ジョーダン…やめてよ。"}, {"i": 1477, "es": "Por que haria algo\nasi...", "orig": "なんで、そんなこと…。"}, {"i": 1478, "es": "El cementerio de\ncadenas de correo?", "orig": "チェーンメールの墓場？"}, {"i": 1479, "es": "Un refugio antiaereo\nsubterraneo...", "orig": "地下の防空壕…か……。"}, {"i": 1480, "es": "Se siente\nencerrado, no?", "orig": "なんか…こもってるね。"}, {"i": 1481, "es": "Dejame tomar\nuna foto, una foto.", "orig": "写メ撮らせてよ、写メ。"}, {"i": 1482, "es": "Por ahora,\nvamos arriba.", "orig": "とりあえず、上に行こ。"}, {"i": 1483, "es": "Desaparecio dentro del\nsalon de musica...", "orig": "音楽室の中に消えた…。"}, {"i": 1484, "es": "\"Esta vez no te dejare\nescapar\"", "orig": "“今度こそ逃がさない”"}, {"i": 1485, "es": "(Ese sonido... ya se!)", "orig": "（あの音……そうか！）"}, {"i": 1486, "es": "En serio vamos\na entrar?", "orig": "…ホントに中に入るの？"}, {"i": 1487, "es": "Mejor... lo dejo por\nahora...", "orig": "やっぱ…やめとくよ…。"}, {"i": 1488, "es": "Por que\nharias algo asi.", "orig": "なんで、そんなことを。"}, {"i": 1489, "es": "Cual cuarto abrimos\nprimero?", "orig": "どの部屋を開けてみる？"}, {"i": 1490, "es": "El eje del tiempo esta\ndistorsionado...", "orig": "時間の軸がぶれてる…。"}, {"i": 1491, "es": "Eso... fue\ndemasiado...", "orig": "…ちょっと…言いすぎ…"}, {"i": 1492, "es": "Uuh... uuh...", "orig": "ううっ……ううっ……。"}, {"i": 1493, "es": "No hay de otra,\nsabes...", "orig": "…しょうがないでしょ…"}, {"i": 1494, "es": "Al fondo tambien\nhay un refugio.", "orig": "奥には防空壕もあるの。"}, {"i": 1495, "es": "?\nQue tiene el fonografo?", "orig": "？\n蓄音機がどうしたの？"}, {"i": 1496, "es": "El sonido... se\ndetuvo...", "orig": "…鳴き声が…止まった…。"}, {"i": 1497, "es": "Con esto creo que se\nsolucionara.", "orig": "これで何とかなりそうね。"}, {"i": 1498, "es": "Entonces... de\nquien era esa voz?", "orig": "じゃ…あの声は誰なの…？"}, {"i": 1499, "es": "Ya veo. Entonces ese\nlugar es...?", "orig": "そう。つまりその場所は？"}, {"i": 1500, "es": "Que fue lo que paso,\nexactamente?", "orig": "…いったい何があったの？"}]