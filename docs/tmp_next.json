[
 {
  "i": 6510,
  "orig": "実はトンデモサイトだったって\n知ってた？",
  "rev": ""
 },
 {
  "i": 6511,
  "orig": "勝手に見知らぬ人へ転送されてた\nみたい。",
  "rev": ""
 },
 {
  "i": 6512,
  "orig": "ケータイの写真、まだ残っている\nでしょ。",
  "rev": ""
 },
 {
  "i": 6513,
  "orig": "…都市伝説の闇に…引き込まれた\n人間は…",
  "rev": ""
 },
 {
  "i": 6514,
  "orig": "さもないと今度こそ大変なことに\nなるわよ。",
  "rev": ""
 },
 {
  "i": 6515,
  "orig": "雨の夕暮れには霊たちが道連れを\n探すの…。",
  "rev": ""
 },
 {
  "i": 6516,
  "orig": "ちょっと前に流行った“チェンメの\n墓場”、",
  "rev": ""
 },
 {
  "i": 6517,
  "orig": "うん…ユカリ先生、最近見ないなあ\nって…。",
  "rev": ""
 },
 {
  "i": 6518,
  "orig": "（ユカリ先生…\n　どうしちゃったんだろう）",
  "rev": ""
 },
 {
  "i": 6519,
  "orig": "…特に、こんな雨の日は…\n早く帰らないと…。",
  "rev": ""
 },
 {
  "i": 6520,
  "orig": "マサキが看護師を殺して病院を\n抜け出したって！",
  "rev": ""
 },
 {
  "i": 6521,
  "orig": "うーん、最近また別のひとが\n気になっちゃって。",
  "rev": ""
 },
 {
  "i": 6522,
  "orig": "あんた、どうでもいい記憶力は\nカンペキだよね。",
  "rev": ""
 },
 {
  "i": 6523,
  "orig": "あんたの好きなナナシのメールにも\nあったでしょ。",
  "rev": ""
 },
 {
  "i": 6524,
  "orig": "で、結局、どっち選んだの？\n告られた２人のうち。",
  "rev": ""
 },
 {
  "i": 6525,
  "orig": "（わたしは、ユカリ先生のことを\n　調べてみた…）",
  "rev": ""
 },
 {
  "i": 6526,
  "orig": "あの“おい”って声…持ってるの、\n気味悪くて…。",
  "rev": ""
 },
 {
  "i": 6527,
  "orig": "（たしか…わたしやリコが撮った\n　写真にも……）",
  "rev": ""
 },
 {
  "i": 6528,
  "orig": "ひどくない？それ。\nあたし何度も送っちゃったのに。",
  "rev": ""
 },
 {
  "i": 6529,
  "orig": "…モリモト…ハラ…クリタ…アラセ\n…カンザキでしょ。",
  "rev": ""
 },
 {
  "i": 6530,
  "orig": "（ユカリ先生と会っていたのは\n　こっちの方じゃない）",
  "rev": ""
 },
 {
  "i": 6531,
  "orig": "（…たしかにユカリ先生は…\n　桐塚高校の教師だった…）",
  "rev": ""
 },
 {
  "i": 6532,
  "orig": "（あの日を境に…ユカリ先生の姿は\n　見えなくなった…）",
  "rev": ""
 },
 {
  "i": 6533,
  "orig": "（レイカは…そう言ったけど…\n　どうしても気になって、）",
  "rev": ""
 },
 {
  "i": 6534,
  "orig": "（…３年前、視聴覚教室で首を\n　吊って自殺したらしい…）",
  "rev": ""
 },
