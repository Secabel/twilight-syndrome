[{"i": 301, "es": "Ahora que lo pienso...\nel tamaño y la forma\nde las letras se veian\nun poco distintos.", "orig": "そういえば…文字の大きさや形が\nビミョーに違ったような。"}, {"i": 302, "es": "(Pero la enfermera,\nsin poder soportarlo,\nescondio al zorro\nen algun lugar\ndel colegio,)", "orig": "（しかし看護師は思いあまって\n　キツネを校舎のどこかに）"}, {"i": 303, "es": "Ah...ahora que\nlo pienso, cuando vi\nel correo aun\neran como las 2.", "orig": "あ…そういえば、メールを見た時は\nまだ２時台だったはず。"}, {"i": 304, "es": "Ayer, a Arisa, Megumi\ny Kana, que hicieron\nKokkuri-san en el\nedificio viejo,", "orig": "昨日、旧校舎でコックリさんをした\nアリサ、メグミ、カナを"}, {"i": 305, "es": "(Sobre el correo en\ncadena de Kana,\nque hacer con eso,)", "orig": "（カナからのチェーンメールだって\n　どうしたらいいか、）"}, {"i": 306, "es": "Cuando ves muchos\nhitodama, si no\ncantas Toryanse,", "orig": "たくさんのヒトダマを見た時、\n“とおりゃんせ”を歌わないと"}, {"i": 307, "es": "Oye, no sera que\nlo de Kokkuri-san,\ncomo es un espiritu\nzorro,", "orig": "ね、ひょっとして、コックリさんの\nこと、キツネの霊だからって"}, {"i": 308, "es": "Si Kana sintio algun\npeligro y de repente\nreenvio el correo...", "orig": "もしも、カナが何か危険を感じて、\n急にメールを転送したら…。"}, {"i": 309, "es": "Hii...", "orig": "ひぃっ…。"}, {"i": 310, "es": "Que alivio...", "orig": "よかった…。"}, {"i": 311, "es": "Q-que alivio...", "orig": "よ…よかった…。"}, {"i": 312, "es": "No se oye nada...", "orig": "何にも聞こえない…。"}, {"i": 313, "es": "Uy...esto es grave...", "orig": "うわ…ヤバイってコレ…。"}, {"i": 314, "es": "Eso es prueba de\nque hay un\nfantasma, no?", "orig": "ユーレイがいる証拠でしょ？"}, {"i": 315, "es": "Ah.\nPero por que no lo\nguardas por si acaso?", "orig": "あ。\nでもいちおー登録しといたら？"}, {"i": 316, "es": "...Ruido...?\nNo, es como\nuna voz...?", "orig": "……ノイズ…？\nいや、何かの声…？"}, {"i": 317, "es": "Podemos revisarlo\ndespues, vamonos ya?", "orig": "あとで確認すればいいから、\nもう行こう？"}, {"i": 318, "es": "Pense que haria si\nsalia algo en la foto...", "orig": "なにか写ってたら\nどうしようかと思った…。"}, {"i": 319, "es": "Quien sabe?", "orig": "さあ？"}, {"i": 320, "es": "Mira.", "orig": "ほら。"}, {"i": 321, "es": "Hii.", "orig": "ひっ。"}, {"i": 322, "es": "Quien sabe?", "orig": "さあ？"}, {"i": 323, "es": "Ha!", "orig": "はっ！"}, {"i": 324, "es": "En serio?", "orig": "マジ？"}, {"i": 325, "es": "Hii.", "orig": "ひっ。"}, {"i": 326, "es": "Quien sabe?", "orig": "さあ？"}, {"i": 327, "es": "Si.", "orig": "うん。"}, {"i": 328, "es": "Si.", "orig": "うん。"}, {"i": 329, "es": "La policia?", "orig": "警察？"}, {"i": 330, "es": "En serio?", "orig": "マジ？"}, {"i": 331, "es": "Una partitura?", "orig": "楽譜？"}, {"i": 332, "es": "Si...", "orig": "うん…。"}, {"i": 333, "es": "Es cierto!", "orig": "そうだ！"}, {"i": 334, "es": "A Reika", "orig": "レイカに"}, {"i": 335, "es": "Eh!?", "orig": "えっ！？"}, {"i": 336, "es": "...Si.", "orig": "…うん。"}, {"i": 337, "es": "...Si.", "orig": "…はい。"}, {"i": 338, "es": "Arisa!", "orig": "アリサ！"}, {"i": 339, "es": "No!", "orig": "いやあ！"}, {"i": 340, "es": "Arisa!", "orig": "アリサ！"}, {"i": 341, "es": "A Reika", "orig": "レイカに"}, {"i": 342, "es": "Noo.", "orig": "だーめ。"}, {"i": 343, "es": "Si...", "orig": "うん…。"}, {"i": 344, "es": "Ha...", "orig": "はっ…。"}, {"i": 345, "es": "\"ahora\"", "orig": "“いま”"}, {"i": 346, "es": "En serio?", "orig": "ホント？"}, {"i": 347, "es": "...Kana?", "orig": "…カナ？"}, {"i": 348, "es": "Es cierto.", "orig": "そうだね。"}, {"i": 349, "es": "Hii...", "orig": "ひぃっ…。"}, {"i": 350, "es": "Mmm...", "orig": "うーん…。"}, {"i": 351, "es": "Se le olvido cerrar?", "orig": "閉め忘れ？"}, {"i": 352, "es": "No puede ser...", "orig": "まさか…。"}, {"i": 353, "es": "Mmm...", "orig": "うーん…。"}, {"i": 354, "es": "Kana......", "orig": "カナ……。"}, {"i": 355, "es": "La enfermeria...", "orig": "保健室…。"}, {"i": 356, "es": "Es cierto.", "orig": "そうだね。"}, {"i": 357, "es": "Riko......", "orig": "リコ……。"}, {"i": 358, "es": "Basta ya.", "orig": "やめなよ。"}, {"i": 359, "es": "No......", "orig": "いや……。"}, {"i": 360, "es": "Se le olvido cerrar?", "orig": "閉め忘れ？"}, {"i": 361, "es": "No puede ser...", "orig": "そんな…。"}, {"i": 362, "es": "Eh......", "orig": "えっ……。"}, {"i": 363, "es": "Que alivio.", "orig": "よかった。"}, {"i": 364, "es": "Mmm...", "orig": "うーん…。"}, {"i": 365, "es": "Kana......", "orig": "カナ……。"}, {"i": 366, "es": "Noooo!", "orig": "いやああ！"}, {"i": 367, "es": "Si, si.", "orig": "はいはい。"}, {"i": 368, "es": "S-si.", "orig": "う、うん。"}, {"i": 369, "es": "Perdon...", "orig": "ごめん…。"}, {"i": 370, "es": "Por favor...", "orig": "お願い…。"}, {"i": 371, "es": "Entendido.", "orig": "わかった。"}, {"i": 372, "es": "...Si...", "orig": "…うん…。"}, {"i": 373, "es": "......Kana?", "orig": "……カナ？"}, {"i": 374, "es": "...Se abrio.", "orig": "…開いた。"}, {"i": 375, "es": "Y la moneda?", "orig": "コインは？"}, {"i": 376, "es": "Q-que!?", "orig": "な、なに！？"}, {"i": 377, "es": "...Nanashi...", "orig": "…ナナシ…。"}, {"i": 378, "es": "Sera eso?", "orig": "そうかなあ？"}, {"i": 379, "es": "Del tipo leyenda urbana?", "orig": "都市伝説系？"}, {"i": 380, "es": "El remitente es...", "orig": "送り主は…。"}, {"i": 381, "es": "Kagami Riko", "orig": "カガミ　リコ"}, {"i": 382, "es": "Por favor!!!", "orig": "お願い！！！"}, {"i": 383, "es": "Que ridiculo", "orig": "バカバカしい"}, {"i": 384, "es": "A donde vas?", "orig": "どこ行くの？"}, {"i": 385, "es": "Mmm......", "orig": "うーん……。"}, {"i": 386, "es": "Al baño...ya veo.", "orig": "トイレ…ね。"}, {"i": 387, "es": "Que te pasa?", "orig": "どうしたの？"}, {"i": 388, "es": "El horario......", "orig": "予定表……。"}, {"i": 389, "es": "Es cierto...", "orig": "そうだね…。"}, {"i": 390, "es": "Yo tambien...", "orig": "あたしも…。"}, {"i": 391, "es": "Otra vez, el espejo...", "orig": "また、鏡…。"}, {"i": 392, "es": "Por favor......", "orig": "お願い……。"}, {"i": 393, "es": "Yo tambien...", "orig": "あたしも…。"}, {"i": 394, "es": "......No puede ser.", "orig": "……そんな。"}, {"i": 395, "es": "Ah, Reika?", "orig": "あ、レイカ？"}, {"i": 396, "es": "Que te pasa?", "orig": "どうしたの？"}, {"i": 397, "es": "...Perdon...", "orig": "…ごめん…。"}, {"i": 398, "es": "Es que...por que...", "orig": "なぜって…。"}, {"i": 399, "es": "Eh, cual?", "orig": "えっ、どれ？"}, {"i": 400, "es": "Eh? Profesora?", "orig": "あれ？先生？"}, {"i": 401, "es": "Que te pasa?", "orig": "どうしたの？"}, {"i": 402, "es": "La basura......", "orig": "ゴミが……。"}, {"i": 403, "es": "Entramos?", "orig": "入ってみる？"}, {"i": 404, "es": "El kanji de perro...", "orig": "犬の漢字…。"}, {"i": 405, "es": "Entramos?", "orig": "入ってみる？"}, {"i": 406, "es": "Que hacemos!", "orig": "どうしよう！"}, {"i": 407, "es": "No...en serio?", "orig": "やだ…マジで？"}, {"i": 408, "es": "El laboratorio......", "orig": "理科室ね……。"}, {"i": 409, "es": "Otra vez a Riko", "orig": "もう一度リコに"}, {"i": 410, "es": "...Quien...eres...?", "orig": "…誰…なの…？"}, {"i": 411, "es": "Izumi Reika", "orig": "イズミ　レイカ"}, {"i": 412, "es": "Ya dejame en paz.", "orig": "カンベンして。"}, {"i": 413, "es": "Alguien! Alguien!", "orig": "誰か！　誰か！"}, {"i": 414, "es": "...Yo......", "orig": "…あたし……。"}, {"i": 415, "es": "Que alivio......", "orig": "よかった……。"}, {"i": 416, "es": "...Que te pasa?", "orig": "…どうしたの？"}, {"i": 417, "es": "Es cierto......", "orig": "そうだね……。"}, {"i": 418, "es": "Sera que...,", "orig": "もしかして…、"}, {"i": 419, "es": "Hanako-saaan.", "orig": "花子さぁぁん。"}, {"i": 420, "es": "Eso tampoco sirve...", "orig": "それもダメ…。"}, {"i": 421, "es": "...La llave, esta bien?", "orig": "…鍵、大丈夫？"}, {"i": 422, "es": "Otra vez a Riko", "orig": "もう一度リコに"}, {"i": 423, "es": "No! No!", "orig": "ダメ！　ダメ！"}, {"i": 424, "es": "...Sera eso?", "orig": "…そうかなあ？"}, {"i": 425, "es": "Alguien! Alguien!", "orig": "誰か！　誰か！"}, {"i": 426, "es": "No...en serio?", "orig": "やだ…マジで？"}, {"i": 427, "es": "Sera que...,", "orig": "もしかして…、"}, {"i": 428, "es": "...Que te pasa?", "orig": "…どうしたの？"}, {"i": 429, "es": "Ah,...si...", "orig": "あ、…うん…。"}, {"i": 430, "es": "Que fue eso...?", "orig": "今の、ナニ…？"}, {"i": 431, "es": "Que preparada estas.", "orig": "用意がいいね。"}, {"i": 432, "es": "Ah, ya veo.", "orig": "あっ、そうか。"}, {"i": 433, "es": "Que hacemos, Kana?", "orig": "どうする、カナ？"}, {"i": 434, "es": "Q-que hacemos.", "orig": "ど、どうしよう。"}, {"i": 435, "es": "No esta bien?", "orig": "いいんじゃない？"}, {"i": 436, "es": "El del espejo es...", "orig": "鏡があるのは…。"}, {"i": 437, "es": "Probamos tocando?", "orig": "ノックしてみる？"}, {"i": 438, "es": "Oye, esto sera...?", "orig": "ね、これって…。"}, {"i": 439, "es": "Se lo dejo a Kana", "orig": "カナにまかせるよ"}, {"i": 440, "es": "Tienes miedo, no.", "orig": "こわいんでしょ。"}, {"i": 441, "es": "Eh, no lo hare.", "orig": "えっ、しないよ。"}, {"i": 442, "es": "Lo de Hanako-san,", "orig": "花子さんなんか、"}, {"i": 443, "es": "Hay que huir rapido!", "orig": "早く逃げなきゃ！"}, {"i": 444, "es": "Que hacemos, Kana?", "orig": "どうする、カナ？"}, {"i": 445, "es": "Esta con llave.", "orig": "鍵がかかってる。"}, {"i": 446, "es": "Que estara haciendo?", "orig": "なにしてんだろ？"}, {"i": 447, "es": "Es cierto! La luz!", "orig": "そうだ！　電気！"}, {"i": 448, "es": "Que hacemos......", "orig": "どうしよう……。"}, {"i": 449, "es": "Esta con llave.", "orig": "鍵がかかってる。"}, {"i": 450, "es": "Hazlo tu, Arisa", "orig": "アリサがやりなよ"}, {"i": 451, "es": "Esta con llave.", "orig": "鍵がかかってる。"}, {"i": 452, "es": "Eso te lo buscaste tu.", "orig": "自業自得でしょ。"}, {"i": 453, "es": "...Nos salvamos...?", "orig": "…助かったの…？"}, {"i": 454, "es": "Esta con llave.", "orig": "鍵がかかってる。"}, {"i": 455, "es": "Igual que en\nel segundo piso...", "orig": "２階と同じ…か。"}, {"i": 456, "es": "Lo escribi de dia.", "orig": "昼間書いたんだ。"}, {"i": 457, "es": "No hay de otra.", "orig": "しょうがないなあ"}, {"i": 458, "es": "Era cuando estabamos\nen el jardin infantil?", "orig": "幼稚園の頃だっけ？"}, {"i": 459, "es": "Si, entendido...", "orig": "うん、わかった…。"}, {"i": 460, "es": "Tambien hay\nun subterraneo...", "orig": "地下もあるんだ…。"}, {"i": 461, "es": "Eh, que quieres decir?", "orig": "え、どういう意味？"}, {"i": 462, "es": "Por favor! Ayuda!", "orig": "お願い！　助けて！"}, {"i": 463, "es": "Asi que el agua\nfunciona.", "orig": "水…使えるんだね。"}, {"i": 464, "es": "Por favor! Ayuda!", "orig": "お願い！　助けて！"}, {"i": 465, "es": "Entonces...amiga......", "orig": "じゃあ…友達……。"}, {"i": 466, "es": "Asi que el agua\nfunciona.", "orig": "水…使えるんだね。"}, {"i": 467, "es": "Salgamos rapido\nde aqui!", "orig": "早く外に出ようよ！"}, {"i": 468, "es": "Asi que el agua\nfunciona.", "orig": "水…使えるんだね。"}, {"i": 469, "es": "Recien...desde el\nedificio viejo...", "orig": "今…旧校舎から…。"}, {"i": 470, "es": "Al final si es\nHanako-san.", "orig": "やっぱり花子さん。"}, {"i": 471, "es": "El horario de\nguardia nocturna......?", "orig": "宿直の当番表……？"}, {"i": 472, "es": "Hay algun mapa?", "orig": "地図なんかあるの？"}, {"i": 473, "es": "Eso no es cierto.", "orig": "そんなことないよ。"}, {"i": 474, "es": "Bueno, yo lo hago.", "orig": "んじゃ、あたしが。"}, {"i": 475, "es": "Bueno, intentemoslo", "orig": "いいよ、やってみよ"}, {"i": 476, "es": "Que se vaya de aqui.", "orig": "退散してもらうの。"}, {"i": 477, "es": "Eso, que era?", "orig": "それ、なんだっけ？"}, {"i": 478, "es": "Bueno, yo lo hago.", "orig": "いいよ、あたしが。"}, {"i": 479, "es": "...Espera un poco.", "orig": "…ちょっと待って。"}, {"i": 480, "es": "N-no se...", "orig": "わ、分かんないよ…。"}, {"i": 481, "es": "Eh, que quieres decir?", "orig": "えっ、どういう意味？"}, {"i": 482, "es": "...Es cierto......\nel espejo......", "orig": "…そうだ……鏡……。"}, {"i": 483, "es": "Por que esta roto!?", "orig": "なんで割れてるの！？"}, {"i": 484, "es": "Con Bunjin-sama!", "orig": "“ブンシンさま”で！"}, {"i": 485, "es": "Oye, vamonos rapido.", "orig": "ねえ、早く行こうよ。"}, {"i": 486, "es": "Seguro que va\na aparecer algo...", "orig": "絶対なんか出そう…。"}, {"i": 487, "es": "Mejor volvamos\na casa...", "orig": "やっぱり帰ろうよ…。"}, {"i": 488, "es": "Dicen que es muy grave.", "orig": "マジやばいらしいよ。"}, {"i": 489, "es": "Basta...no digas eso...", "orig": "やめてよ…そんな…。"}, {"i": 490, "es": "Salgamos de aqui rapido!", "orig": "早くここから出よう！"}, {"i": 491, "es": "Eso tambien,\nbastante......", "orig": "それもいっぱい……。"}, {"i": 492, "es": "Por que esta roto!?", "orig": "なんで割れてるの！？"}, {"i": 493, "es": "Por que esta roto!?", "orig": "なんで割れてるの！？"}, {"i": 494, "es": "Ah, que preparada.", "orig": "へー、用意がいいね。"}, {"i": 495, "es": "En fin, apuremonos.", "orig": "とにかく早くしよっ。"}, {"i": 496, "es": "Eso tiene partitura?", "orig": "アレって楽譜あるの？"}, {"i": 497, "es": "Pero, Arisa......", "orig": "でも、アリサが……。"}, {"i": 498, "es": "Entonces, el profesor\nHayashi?", "orig": "じゃ、担任のハヤシ？"}, {"i": 499, "es": "Por que esta roto!?", "orig": "なんで割れてるの！？"}, {"i": 500, "es": "Bueno, entonces\nesta bien.", "orig": "じゃあ、いいじゃん。"}, {"i": 501, "es": "Por que esta roto!?", "orig": "なんで割れてるの！？"}, {"i": 502, "es": "Por que esta roto!?", "orig": "なんで割れてるの！？"}, {"i": 503, "es": "No sirve...no se conecta.", "orig": "ダメ…つながらない。"}, {"i": 504, "es": "No se despega......", "orig": "はがれないよぉ……。"}, {"i": 505, "es": "Este interruptor,\npara que es?", "orig": "これ、何のスイッチ？"}, {"i": 506, "es": "Solo hay que\ngolpearlo, no.", "orig": "叩けばいいんでしょ。"}, {"i": 507, "es": "Eh? Esta abierto......", "orig": "あれ？開いてる……。"}, {"i": 508, "es": "Vamos a la sala\nde musica.", "orig": "さ、音楽室に行くよ。"}, {"i": 509, "es": "Oye, terminemos rapido.", "orig": "ね、早く済ませよっ。"}, {"i": 510, "es": "Pero, Arisa......", "orig": "でも、アリサが……。"}, {"i": 511, "es": "Arisa?\nQue te pasa?", "orig": "アリサ？\nどうしたの？"}, {"i": 512, "es": "Colegio Kirizuka\nDespues de clases...", "orig": "桐塚高等学校\n放課後…"}, {"i": 513, "es": "...Bunjin-sama...\nclaro...", "orig": "…ブンシンさま…ね…。"}, {"i": 514, "es": "Eh!? Yo tambien!?", "orig": "えっ！？あたしもっ！？"}, {"i": 515, "es": "Jeje, quedo perfecto.", "orig": "へへ、バッチリでしょ。"}, {"i": 516, "es": "Esto es grave!\nEs grave!!", "orig": "やばい！　やばいよ！！"}, {"i": 517, "es": "Mucho mas que eso......", "orig": "目じゃないくらい……。"}, {"i": 518, "es": "El espejo......\nrapido, el espejo...", "orig": "鏡……早く、鏡を……。"}, {"i": 519, "es": "Y bueno, donde\nesta la sala de musica?", "orig": "で、音楽室はどこなの？"}, {"i": 520, "es": "Sera esa de\nPise a un gato?", "orig": "ネコふんじゃったとか？"}, {"i": 521, "es": "...Ah, es solo\nun espejo...", "orig": "…なんだ、鏡じゃん…。"}, {"i": 522, "es": "Vamos rapido a\nla sala de musica.", "orig": "早く音楽室に行こうよ。"}, {"i": 523, "es": "Por favor, venga.", "orig": "どうぞおいでください。"}, {"i": 524, "es": "No sirve......\nno se abre......", "orig": "ダメ……開かない……。"}, {"i": 525, "es": "Dirigiendose al\nsegundo cubiculo", "orig": "２番目の個室に向かって"}, {"i": 526, "es": "Ah...Kana...espera...", "orig": "あ…、カナ…待って…。"}, {"i": 527, "es": "Eh? Es un correo......", "orig": "あれ？　メールだ……。"}, {"i": 528, "es": "Es lo de la mujer\nde la boca rasgada, no?", "orig": "マタサケオンナでしょ。"}, {"i": 529, "es": "...No es raro\nesto...??", "orig": "…なんか違くない…？？"}, {"i": 530, "es": "Aunque me lo\ndigas a mi...", "orig": "あたしに言われても…。"}, {"i": 531, "es": "...Que...? Que es esto?", "orig": "…なに…？　なんなの？"}, {"i": 532, "es": "La sala de musica,\nla sala de musica.", "orig": "音楽室でしょ、音楽室。"}, {"i": 533, "es": "...Que...? Que es esto?", "orig": "…なに…？　なんなの？"}, {"i": 534, "es": "En que piso era\nla sala de musica?", "orig": "音楽室って何階だっけ？"}, {"i": 535, "es": "En el tercer piso.\nAl fondo del todo.", "orig": "３階よ。３階の一番奥。"}, {"i": 536, "es": "Busquemos en\notro lugar...", "orig": "別のところを探そう…。"}, {"i": 537, "es": "Llegamos a la sala\nde musica, pero...", "orig": "音楽室に着いたけど…。"}, {"i": 538, "es": "Eh? Esta abierto......", "orig": "あれ？　開いてる……。"}, {"i": 539, "es": "Aqui es...\nla sala de musica, no.", "orig": "ここ…だよね…音楽室。"}, {"i": 540, "es": "...Bueno,\nempezamos?", "orig": "…じゃあ、始めますか。"}, {"i": 541, "es": "Tambien esta\nescrito el horario.", "orig": "予定とかも書いてあるね。"}, {"i": 542, "es": "Ademas, hacerlo\ncon lapiz mecanico,", "orig": "あと、シャーペンでする、"}, {"i": 543, "es": "En fin, hay que\napurarse...!", "orig": "とにかく、急がないと…！"}, {"i": 544, "es": "Kana todavia\nesta alla...", "orig": "向こうにはまだカナが…。"}, {"i": 545, "es": "Hay que buscar\nel espejo rapido...", "orig": "早く鏡を探さなくちゃ…。"}, {"i": 546, "es": "No puede ser,\nse te cayo?", "orig": "まさか、落としちゃった？"}, {"i": 547, "es": "En ese momento...\nla mancha en la pared...", "orig": "その時の…壁のシミが…。"}, {"i": 548, "es": "Esta detras de ti.", "orig": "あなたのうしろにいるの。"}, {"i": 549, "es": "Hasta ahora, cada\nvez que empieza\nuna obra,", "orig": "今まで、工事を始めると、"}, {"i": 550, "es": "Seguro que hay\nalgo ahi.", "orig": "ゼッタイ何かいるんだよ。"}, {"i": 551, "es": "(El espejo......\nrapido, el espejo......)", "orig": "（鏡……早く、鏡を……）"}, {"i": 552, "es": "En...en fin,\nsalgamos rapido!", "orig": "と、とにかく早く出よう！"}, {"i": 553, "es": "No puede ser...\nno se abre...", "orig": "そんな…開かないよぉ…。"}, {"i": 554, "es": "No sirve......\nesto no se abre.", "orig": "ダメ……ここは開かない。"}, {"i": 555, "es": "Es cierto...\nyo tambien...\nhace tiempo...", "orig": "そうだ…あたしも…昔…。"}, {"i": 556, "es": "Las escaleras\nestan bloqueadas......", "orig": "階段がふさがれてる……。"}, {"i": 557, "es": "...Solo esta\nroto, no...?", "orig": "…壊れてるだけでしょ…？"}, {"i": 558, "es": "En cual podemos\nconfiar...?", "orig": "頼りになるのは…どっち？"}, {"i": 559, "es": "Tal vez alguien\nesta escondido.", "orig": "誰かが隠れていたりして。"}, {"i": 560, "es": "Eh, por que en el\nedificio viejo...?", "orig": "えっ、なんで旧校舎に…。"}, {"i": 561, "es": "Detras de mi......\nalguien......", "orig": "うしろに……誰かが……。"}, {"i": 562, "es": "...El sonido...\ndel cañeria\nde la pared...?", "orig": "…壁の…水道管…の音…？"}, {"i": 563, "es": "...El sonido...\ndel cañeria\nde la pared...?", "orig": "…壁の…水道管…の音…？"}, {"i": 564, "es": "Ah, quedo una\npartitura vieja.", "orig": "あ、古い楽譜が残ってる。"}, {"i": 565, "es": "Si.\nLa encontre en\nla biblioteca.", "orig": "うん。\n図書室で見つけた。"}, {"i": 566, "es": "Que tonta!\nQue estas\nhaciendo!", "orig": "馬鹿ね！\n何をやってるの！"}, {"i": 567, "es": "...En la linea\nEdogawa hay muchos\nsuicidios, no?", "orig": "…江戸川線、自殺多いよね。"}, {"i": 568, "es": "En fin, hay que\nbuscar el espejo...", "orig": "とにかく鏡を探さなきゃ…。"}, {"i": 569, "es": "Fue anoche muy\ntarde, no?", "orig": "昨日の深夜だったんでしょ？"}, {"i": 570, "es": "No puede ser...\nestamos encerradas...?", "orig": "そんな…閉じこめられた…？"}, {"i": 571, "es": "Ultimamente hay\nmuchos correos\nen cadena.", "orig": "最近、多いよね、チェンメ。"}, {"i": 572, "es": "Ya da asco,\ny es insistente.", "orig": "もうキモいし、しつこいし。"}, {"i": 573, "es": "Se sentia como si\nlo movieran.", "orig": "動かされている感じだった。"}, {"i": 574, "es": "Como pense...\nno se abre...", "orig": "やっぱり…開かないよぉ…。"}, {"i": 575, "es": "Ya no debe\nservir, pero...", "orig": "もう使えないだろうけど…。"}, {"i": 576, "es": "En fin, alguien...\nalguien......", "orig": "とにかく誰か…、誰か……。"}, {"i": 577, "es": "No sirve...no\nse conecta bien.", "orig": "ダメ…うまくつながらない。"}, {"i": 578, "es": "...La verdad...\nKokkuri-san...", "orig": "…実は…コックリさんを…。"}, {"i": 579, "es": "Al fondo del\ntercer piso.\nEntendido.", "orig": "３階の一番奥ね。分かった。"}, {"i": 580, "es": "Entiendes, no.\nSiguelo con el dedo.", "orig": "わかるよね。指でなぞるの。"}, {"i": 581, "es": "Si por casualidad\nhay un espejo cerca,", "orig": "もしも近くに鏡があるなら、"}, {"i": 582, "es": "Ah, que raro......?\nNo esta la llave...", "orig": "あ、あれ……？\n鍵がない…。"}, {"i": 583, "es": "Hay varias formas\nde decirlo, no.", "orig": "いろいろ言い方が違うでしょ。"}, {"i": 584, "es": "Por ahora, hay que\nbuscar el espejo.", "orig": "とりあえず、鏡を探さなきゃ。"}, {"i": 585, "es": "El del baño y el\nespejo del pasillo...\nlos demas son...", "orig": "トイレと廊下の姿見…他は…。"}, {"i": 586, "es": "Eh, por que no\nse abre!?", "orig": "ええっ、なんで開かないの！？"}, {"i": 587, "es": "Y cuando lo saque\nde la boca de golpe,", "orig": "で、あわてて口から出したら、"}, {"i": 588, "es": "Ese viejo edificio\nen desuso,", "orig": "あの使われていない古い校舎、"}, {"i": 589, "es": "Ah, no se abre!!\nPor que!?", "orig": "あ、開かない！！　なんで！？"}, {"i": 590, "es": "Viendo el mapa,\nparece que es\nel tercer piso.", "orig": "地図を見ると、３階らしいよ。"}, {"i": 591, "es": "En fin, vamos a\nprobar en el\ntercer piso.", "orig": "とにかく、３階に行ってみよ。"}, {"i": 592, "es": "...No puedo...\nya no puedo\ncorrer mas...", "orig": "…ダメ…もう、走れないよ…。"}, {"i": 593, "es": "Hay un olor como\na quimicos...", "orig": "なんか薬品のようなにおい…。"}, {"i": 594, "es": "Siento que habia\nun rumor......", "orig": "ウワサがあった気がする……。"}, {"i": 595, "es": "Que hacemos...\nasi como estamos...", "orig": "どうしよう…このままじゃ…。"}, {"i": 596, "es": "Antes, lo de\nHanako-san\nera famoso.", "orig": "昔、花子さん、流行ったよね。"}, {"i": 597, "es": "Pero, a donde\nllamo?", "orig": "でも、どこにかければいいの？"}, {"i": 598, "es": "Tengo la llave\nde esta sala,\npero...", "orig": "この教室の鍵ならあるけど…。"}, {"i": 599, "es": "Entonces no hay\nnecesidad de\nabrirla.", "orig": "なら、開ける必要ないじゃん。"}, {"i": 600, "es": "Jeje...soy...\nl-i-n-d-a?", "orig": "フフッ…あたし、き・れ・い？"}]