[{"i": 5701, "es": "No esta, eh...", "orig": "いない、か…。"}, {"i": 5702, "es": "...Ya no quiero!", "orig": "…もういやっ！"}, {"i": 5703, "es": "...Decidido.", "orig": "…決まりだな。"}, {"i": 5704, "es": "Ah...que mal...", "orig": "あ…やばっ…。"}, {"i": 5705, "es": "Aparte de Riko,", "orig": "リコ以外にも、"}, {"i": 5706, "es": "...El juego de\nmiradas...", "orig": "…にらめっこ…"}, {"i": 5707, "es": "No...no esta.", "orig": "ダメ…いない。"}, {"i": 5708, "es": "Ah...Reika...", "orig": "あ…レイカ…。"}, {"i": 5709, "es": "...Yuuta......?", "orig": "…ユウタ……？"}, {"i": 5710, "es": "(Es Masaki...)", "orig": "（マサキだ…）"}, {"i": 5711, "es": "Sale el sol......", "orig": "日が昇る……。"}, {"i": 5712, "es": "Y el bano?", "orig": "トイレはどう？"}, {"i": 5713, "es": "Ajajajaja!", "orig": "あははははは！"}, {"i": 5714, "es": "Ma-Masaki...?", "orig": "マ…マサキ…？"}, {"i": 5715, "es": "Un poder espiritual...", "orig": "霊的な力って…。"}, {"i": 5716, "es": "...La piscina no es?", "orig": "…プールは違う？"}, {"i": 5717, "es": "Mas que Mizuki...", "orig": "ミズキよりも…。"}, {"i": 5718, "es": "Mensaje numero 88", "orig": "８８通目のメール"}, {"i": 5719, "es": "No sera Yuuta?", "orig": "まさか、ユウタ？"}, {"i": 5720, "es": "...Por favor, sensei.", "orig": "…お願い、先生。"}, {"i": 5721, "es": "Que te pasa de repente.", "orig": "どうしたの急に。"}, {"i": 5722, "es": "Mensaje numero 98", "orig": "９８通目のメール"}, {"i": 5723, "es": "Ah...Mizuki...", "orig": "ああ…ミズキ…。"}, {"i": 5724, "es": "Eh......que......", "orig": "え……なに……。"}, {"i": 5725, "es": "Yuuta! Estas bien?", "orig": "ユウタ！大丈夫？"}, {"i": 5726, "es": "Ah......ngh...", "orig": "あ……ううっ…。"}, {"i": 5727, "es": "No esta mal, no?", "orig": "いいじゃないか。"}, {"i": 5728, "es": "Es un apodo...", "orig": "あだ名なんだ…。"}, {"i": 5729, "es": "Ah, yo soy Masaki.", "orig": "あ、俺、マサキ。"}, {"i": 5730, "es": "......Yuuta......", "orig": "……ユウタ……。"}, {"i": 5731, "es": "Mensaje numero 84", "orig": "８４通目のメール"}, {"i": 5732, "es": "Ni de broma, basta.", "orig": "冗談でもやめろ。"}, {"i": 5733, "es": "Debe ser tu\nimaginacion...", "orig": "気のせいだろ…。"}, {"i": 5734, "es": "Eso parece......", "orig": "みたいだな……。"}, {"i": 5735, "es": "Hayakawa...", "orig": "ハヤカワさん…。"}, {"i": 5736, "es": "......Mejor paso.", "orig": "……遠慮しとく。"}, {"i": 5737, "es": "No sera Masaki?", "orig": "まさか、マサキ？"}, {"i": 5738, "es": "...No lo sabia.", "orig": "…知らなかった。"}, {"i": 5739, "es": "Tu, al menos...", "orig": "おまえだけは…。"}, {"i": 5740, "es": "Ese moreton en la\nmuñeca...", "orig": "その手首のアザ…"}, {"i": 5741, "es": "(...Yo......)", "orig": "（…わたし……）"}, {"i": 5742, "es": "(......En ese\nmomento...)", "orig": "（……あの時…）"}, {"i": 5743, "es": "Parece que no esta.", "orig": "いないみたいね。"}, {"i": 5744, "es": "Que es eso.", "orig": "なんだよ、それ。"}, {"i": 5745, "es": "Que susto...", "orig": "びっくりした…。"}, {"i": 5746, "es": "Ah, en ese caso...", "orig": "あ、それなら…。"}, {"i": 5747, "es": "Reika! Reika!", "orig": "レイカ！レイカ！"}, {"i": 5748, "es": "(Un maniqui...?)", "orig": "（マネキン…？）"}, {"i": 5749, "es": "(Ahora...pasos...)", "orig": "（今…足音が…）"}, {"i": 5750, "es": "Yuuta, espera.", "orig": "ユウタ、待って。"}, {"i": 5751, "es": "El album de\ngraduacion...", "orig": "卒業アルバム…。"}, {"i": 5752, "es": "(...Reika......)", "orig": "（…レイカ……）"}, {"i": 5753, "es": "...Eso no puede ser.", "orig": "…それはないな。"}, {"i": 5754, "es": "Ahora lo recorde...", "orig": "今思い出した…。"}, {"i": 5755, "es": "...No te acuerdas?", "orig": "…覚えてないの？"}, {"i": 5756, "es": "Yukari...sensei...", "orig": "ユカリ…先生…。"}, {"i": 5757, "es": "Salgamos del edificio.", "orig": "校舎から出よう。"}, {"i": 5758, "es": "......Eso parece.", "orig": "……みたいだな。"}, {"i": 5759, "es": "Que paso...?", "orig": "何があったの…？"}, {"i": 5760, "es": "......Eso parece.", "orig": "……みたいだな。"}, {"i": 5761, "es": "De verdad estas bien?", "orig": "ホントに大丈夫？"}, {"i": 5762, "es": "......Que tipo raro.", "orig": "……ヘンなヤツ。"}, {"i": 5763, "es": "Riko! Estas ahi?", "orig": "リコ！いるのか？"}, {"i": 5764, "es": "No queda otra que\nbuscar por la escuela...", "orig": "校内を探すしか…"}, {"i": 5765, "es": "Eso parece......", "orig": "みたいだな……。"}, {"i": 5766, "es": "El celular de Riko!", "orig": "リコのケータイ！"}, {"i": 5767, "es": "Un lugar embrujado...", "orig": "心霊スポット…。"}, {"i": 5768, "es": "Apunta...la luz...", "orig": "ライト…向けて…。"}, {"i": 5769, "es": "...Otra vez de Nanashi.", "orig": "…またナナシから。"}, {"i": 5770, "es": "El cruce...maldito...", "orig": "呪いの…交差点…。"}, {"i": 5771, "es": "Solo es simple\ncuriosidad...", "orig": "単なる好奇心さ…。"}, {"i": 5772, "es": "...Hayakawa...", "orig": "…ハヤカワさん…。"}, {"i": 5773, "es": "Entonces, en ese\nmomento...", "orig": "じゃあ、あの時…。"}, {"i": 5774, "es": "Te llamo despues.", "orig": "後からかけるから。"}, {"i": 5775, "es": "(Quien rayos?)", "orig": "（いったい誰が？）"}, {"i": 5776, "es": "(Yukari...sensei...)", "orig": "（ユカリ…先生…）"}, {"i": 5777, "es": "Yuuta, espera!", "orig": "ユウタ、待ってて！"}, {"i": 5778, "es": "Las cien historias de\nleyendas urbanas...?", "orig": "都市伝説百物語…？"}, {"i": 5779, "es": "Eh? Ah, si...", "orig": "えっ？あ、うん…。"}, {"i": 5780, "es": "Gracias...Reika.", "orig": "ありがと…レイカ。"}, {"i": 5781, "es": "...Es hermoso,\nverdad...?", "orig": "…キレイでしょ…？"}, {"i": 5782, "es": "Ah...yo.........", "orig": "あ…あたし………。"}, {"i": 5783, "es": "No quieres investigar un\npoco?", "orig": "少し調べてみない？"}, {"i": 5784, "es": "Si, es solo intuicion.", "orig": "そう、直感だけど。"}, {"i": 5785, "es": "Que te pasa? De\nrepente.", "orig": "どうしたの？急に。"}, {"i": 5786, "es": "Que significa esto...?", "orig": "どういうことだ…？"}, {"i": 5787, "es": "Y entonces...!", "orig": "するとどうだ……！"}, {"i": 5788, "es": "Ya no puedo controlarlo.", "orig": "もう手に負えない。"}, {"i": 5789, "es": "Que pasa con la\nbiblioteca?", "orig": "図書室がどうした？"}, {"i": 5790, "es": "......No, nada,\nperdon", "orig": "……ううん、ごめん"}, {"i": 5791, "es": "No es Masaki?", "orig": "マサキじゃないの？"}, {"i": 5792, "es": "Esta bien...pero rapido", "orig": "いいけど…手短にね"}, {"i": 5793, "es": "(Que significa esto?)", "orig": "（どういうこと？）"}, {"i": 5794, "es": "...Parece que no esta.", "orig": "…いないみたいね。"}, {"i": 5795, "es": "Todavia no esta\ncompleto.", "orig": "まだ完全じゃない。"}, {"i": 5796, "es": "Mejor lo dejo, despues\nde todo", "orig": "やっぱりやめておく"}, {"i": 5797, "es": "Este es el numero 99...", "orig": "これが９９通目…。"}, {"i": 5798, "es": "Que rayos...esta\npasando...", "orig": "いったい…何が…。"}, {"i": 5799, "es": "...Hay algo ahi.", "orig": "…何かがあるのよ。"}, {"i": 5800, "es": "Entonces, donde es?", "orig": "じゃあ、どこなの？"}, {"i": 5801, "es": "(No queda otra que ir!)", "orig": "（行くしかない！）"}, {"i": 5802, "es": "Estuviste bien...?", "orig": "大丈夫だったの…？"}, {"i": 5803, "es": "Ah, con que asi es.", "orig": "へえ、そうなんだ。"}, {"i": 5804, "es": "Parece que lo rechazo.", "orig": "フッたらしいけど。"}, {"i": 5805, "es": "Todavia no lo borraste?", "orig": "まだ削除してない？"}, {"i": 5806, "es": "Oye, no quieres\ninvestigarlo?", "orig": "ね、調べてみない？"}, {"i": 5807, "es": "Entonces, es el segundo\npiso.", "orig": "じゃあ、２階だな。"}, {"i": 5808, "es": "Esta con llave.", "orig": "カギがかかってる。"}, {"i": 5809, "es": "Vamos buscando\nmientras avanzamos.", "orig": "探しながら行こう。"}, {"i": 5810, "es": "Esta con llave.", "orig": "カギがかかってる。"}, {"i": 5811, "es": "No, no esta......", "orig": "ダメ、いない……。"}, {"i": 5812, "es": "Bueno, no le des\nimportancia.", "orig": "ま、気にするなよ。"}, {"i": 5813, "es": "...No es nada.", "orig": "…なんでもないわ。"}, {"i": 5814, "es": "No, no esta......", "orig": "ダメ、いない……。"}, {"i": 5815, "es": "......No lo se.", "orig": "……知らないわよ。"}, {"i": 5816, "es": "Parece que no esta.", "orig": "いないみたいだな。"}, {"i": 5817, "es": "...No es nada.", "orig": "…なんでもないわ。"}, {"i": 5818, "es": "Reika! Noooo!", "orig": "レイカ！いやあっ！"}, {"i": 5819, "es": "Ngh......ngh......", "orig": "う……ううっ……。"}, {"i": 5820, "es": "Lo se, el transferido.", "orig": "知ってる、転校生。"}, {"i": 5821, "es": "...Parece que no esta.", "orig": "…いないみたいね。"}, {"i": 5822, "es": "Masaki! Estas bien!", "orig": "マサキ！無事なの！"}, {"i": 5823, "es": "Preguntemos por\ncelular...", "orig": "ケータイで聞こう…"}, {"i": 5824, "es": "(Sera por aqui...)", "orig": "（この辺り…かな）"}, {"i": 5825, "es": "Masaki......estas ahi?", "orig": "マサキ……いるの？"}, {"i": 5826, "es": "(El alma...se\naloja...?)", "orig": "（魂が…宿る…？）"}, {"i": 5827, "es": "...Sensei...\nayudeme...", "orig": "…先生……助けて…"}, {"i": 5828, "es": "...Parece que no esta.", "orig": "…いないみたいね。"}, {"i": 5829, "es": "Reika! Estas ahi!?", "orig": "レイカ！いるの！？"}, {"i": 5830, "es": "El casillero de Masaki.", "orig": "マサキのロッカー。"}, {"i": 5831, "es": "(No sera, Riko...)", "orig": "（まさか、リコ…）"}, {"i": 5832, "es": "Yukari...? Quien es\nesa?", "orig": "ユカリ…？誰それ？"}, {"i": 5833, "es": "Eh!\nYo soy Nanashi?", "orig": "えっ！\n俺がナナシ？"}, {"i": 5834, "es": "Vaya, ya es de noche\npor completo.", "orig": "あちゃ、すっかり夜。"}, {"i": 5835, "es": "En el club de natacion\ntambien es asi?", "orig": "水泳部でもそうなの？"}, {"i": 5836, "es": "(......Este numero\nque llama)", "orig": "（……この着信番号）"}, {"i": 5837, "es": "(...No contesta el\ntelefono...)", "orig": "（…電話に出ない…）"}, {"i": 5838, "es": "Jaja...no puede ser...", "orig": "ははっ…まさかな…。"}, {"i": 5839, "es": "Me meti\ndemasiado......", "orig": "深入りしすぎた……。"}, {"i": 5840, "es": "...Una cadena de\nmensajes...", "orig": "…チェーンメール…。"}, {"i": 5841, "es": "Si...un poco...", "orig": "うん…ちょっとね…。"}, {"i": 5842, "es": "...Este arbol...en\nalgun lado...", "orig": "…この木…どこかで…"}, {"i": 5843, "es": "Desde cuando? Que clase\nde persona?", "orig": "いつから？どんな人？"}, {"i": 5844, "es": "Reika...tu que crees?", "orig": "レイカは…どう思う？"}, {"i": 5845, "es": "(Otra vez...hablando\nde Riko?)", "orig": "（また…リコの話？）"}, {"i": 5846, "es": "...No lo sabia...", "orig": "…知らなかったの…。"}, {"i": 5847, "es": "......Yo segui\nrezando.", "orig": "……俺は祈り続けた。"}, {"i": 5848, "es": "Todos andan\ncomentando.", "orig": "みんなウワサしてる。"}, {"i": 5849, "es": "Despues de todo...este\ntipo...", "orig": "やっぱり…こいつ…。"}, {"i": 5850, "es": "Yo ya me voy a casa...", "orig": "わたし、もう帰るね…"}, {"i": 5851, "es": "...El hechizo para\ncomunicarse,", "orig": "…交信のおまじない、"}, {"i": 5852, "es": "...No me preguntes a\nmi.", "orig": "…私に聞かないでよ。"}, {"i": 5853, "es": "...Tu...te vas a\nsalvar......", "orig": "…君は…助かる……。"}, {"i": 5854, "es": "(No......el\namanecer...)", "orig": "（ダメ……夜明け…）"}, {"i": 5855, "es": "Yo...la\npiscina...supongo.", "orig": "僕は…プール…かな。"}, {"i": 5856, "es": "Parece que no esta...", "orig": "いないみたいだな…。"}, {"i": 5857, "es": "Por ejemplo, el salon...", "orig": "例えば、教室とか…。"}, {"i": 5858, "es": "Si, yo tambien lo creo.", "orig": "うん、私もそう思う。"}, {"i": 5859, "es": "Apuremonos por aqui\ntambien.", "orig": "こっちも急ぎましょ。"}, {"i": 5860, "es": "(...Que...fue eso...)", "orig": "（…なに…いまの…）"}, {"i": 5861, "es": "(Desde el bano......?)", "orig": "（トイレから……？）"}, {"i": 5862, "es": "(Nanashi esta aqui...?)", "orig": "（ナナシがいる…？）"}, {"i": 5863, "es": "(No......el\namanecer...)", "orig": "（ダメ……夜明け…）"}, {"i": 5864, "es": "Noo......Reika...", "orig": "いやあ……レイカ…。"}, {"i": 5865, "es": "Tal vez sea mas fiel de lo\nque parece.", "orig": "案外一途なのかもね。"}, {"i": 5866, "es": "El aula de economia\ndomestica y la\nbiblioteca.", "orig": "家庭科室と図書室よ。"}, {"i": 5867, "es": "Que rayos...esta\npasando...", "orig": "いったい…なにが…。"}, {"i": 5868, "es": "Haz lo que quieras.", "orig": "好きにすればいいさ。"}, {"i": 5869, "es": "...No se oye algun\nruido...?", "orig": "…何か音がしない…？"}, {"i": 5870, "es": "...Yo, soy linda...?", "orig": "…あたし、キレイ…？"}, {"i": 5871, "es": "Busquemos en otro lado.", "orig": "他のところを探そう。"}, {"i": 5872, "es": "Aqui es, segundo año,\nsalon 1.", "orig": "ここだな、２年１組。"}, {"i": 5873, "es": "Reika! Estas ahi!?", "orig": "レイカ！いるのか！？"}, {"i": 5874, "es": "Aqui es, segundo año,\nsalon 1.", "orig": "ここだな、２年１組。"}, {"i": 5875, "es": "Es una buena\noportunidad, pero...", "orig": "いい機会なんだけど。"}, {"i": 5876, "es": "Que deberia hacer...", "orig": "どうしたらいいの…。"}, {"i": 5877, "es": "El conjuro para\nahuyentarlo......", "orig": "ゲキタイの呪文が……"}, {"i": 5878, "es": "Mira, cuando entras a la\nlibreria,", "orig": "ほら、本屋に入ると、"}, {"i": 5879, "es": "Mira, cuando entras a la\nlibreria,", "orig": "ほら、本屋に入ると、"}, {"i": 5880, "es": "No...mis pies se\nmovieron solos...", "orig": "いや…足が勝手に…。"}, {"i": 5881, "es": "(La puerta...se movio\nsola!)", "orig": "（勝手に…ドアが！）"}, {"i": 5882, "es": "Que rayos...esta\npasando...", "orig": "いったい…なにが…。"}, {"i": 5883, "es": "...De repente, mi\ncuello...", "orig": "…突然、俺の首を…。"}, {"i": 5884, "es": "Eh? No hay natacion.", "orig": "あれ？水泳がないな。"}, {"i": 5885, "es": "Ahora ya...no puedo.", "orig": "今はもう…無理なの。"}, {"i": 5886, "es": "Te va a arrastrar un\nespiritu.", "orig": "霊に引き込まれるぞ。"}, {"i": 5887, "es": "Por que?\nPorque eres profesor?", "orig": "なんで？\n教師だから？"}, {"i": 5888, "es": "No has ido a Kirizuka?", "orig": "桐塚に行ったことない？"}, {"i": 5889, "es": "Riko......calmate...", "orig": "リコ……落ち着いて…。"}, {"i": 5890, "es": "Masaki es Nanashi...?", "orig": "マサキがナナシ…なの？"}, {"i": 5891, "es": "Mentira... no\nresponde...", "orig": "うそ……きか…ない…。"}, {"i": 5892, "es": "Faltaba algo...", "orig": "何かが足りなかった…。"}, {"i": 5893, "es": "Yo, cuando era\npequeña...", "orig": "わたし、小さいとき…。"}, {"i": 5894, "es": "(Hay que ayudarla\nrapido...!)", "orig": "（早く助けないと…！）"}, {"i": 5895, "es": "Riko tambien lo\nmismo......", "orig": "リコも同じことを……。"}, {"i": 5896, "es": "(...Esto no esta\nbien...)", "orig": "（…どうかしてるよ…）"}, {"i": 5897, "es": "(Que......es este\nsonido...?)", "orig": "（なに……この音…？）"}, {"i": 5898, "es": "Investigar un poco mas\nel edificio", "orig": "もう少し校舎内を調べる"}, {"i": 5899, "es": "Puedes salir ahora?", "orig": "今から出てこられるか？"}, {"i": 5900, "es": "Seguro que es lo\nmismo...", "orig": "たぶん同じことじゃ…。"}, {"i": 5901, "es": "Quien sera, me pregunto", "orig": "さあ、誰なんでしょうね"}, {"i": 5902, "es": "...No!...juntos......", "orig": "…いやっ…一緒に……。"}, {"i": 5903, "es": "Mas que eso, hay que\napurarse...", "orig": "それより早くしないと…"}, {"i": 5904, "es": "Se materializa por\ncompleto.", "orig": "完全な形で実体化する。"}, {"i": 5905, "es": "(Pero...como...)", "orig": "（でも…どうやって…）"}, {"i": 5906, "es": "Este hechizo...", "orig": "このおまじないって…。"}, {"i": 5907, "es": "(......El juego de\nmiradas......)", "orig": "（……にらめっこ……）"}, {"i": 5908, "es": "Eso he oido.", "orig": "そう聞いたことがある。"}, {"i": 5909, "es": "(Usando el celular...)", "orig": "（ケータイを使って…）"}, {"i": 5910, "es": "Solo esto...esta\nabierto...", "orig": "これだけ…開いてる…。"}, {"i": 5911, "es": "......Yo creo que no es\nasi...", "orig": "……僕は違うと思う…。"}, {"i": 5912, "es": "(...El juego de\nmiradas...)", "orig": "（…にらめっこ…を…）"}, {"i": 5913, "es": "No sirve... Busquemos\nen otro lado.", "orig": "ダメか…。他を探そう。"}, {"i": 5914, "es": "Un hechizo de amor...", "orig": "恋のおまじないって…。"}, {"i": 5915, "es": "...Busquemos en otro\nlado.", "orig": "…他のところを探そう。"}, {"i": 5916, "es": "...Reika...me ataco.", "orig": "…レイカに…襲われた。"}, {"i": 5917, "es": "Juguemos...al juego de\nmiradas...", "orig": "にらめっこ…しましょ…"}, {"i": 5918, "es": "Por que no le apuntamos\nla luz?", "orig": "ライト向けてみないか？"}, {"i": 5919, "es": "Si admito que es\nhermoso...", "orig": "キレイだって認めれば…"}, {"i": 5920, "es": "...Busquemos en otro\nlado.", "orig": "…他のところを探そう。"}, {"i": 5921, "es": "......Ya casi amanece.", "orig": "……もうすぐ夜明けだ。"}, {"i": 5922, "es": "......No queda de\notra.", "orig": "……しょうがねえなあ。"}, {"i": 5923, "es": "Hoy tampoco hay\ntiempo.", "orig": "今日は時間もないしな。"}, {"i": 5924, "es": "......Ya casi amanece.", "orig": "……もうすぐ夜明けだ。"}, {"i": 5925, "es": "......Ah, eso hare...", "orig": "……ああ、そうする…。"}, {"i": 5926, "es": "Entendido...nos\nvemos...", "orig": "わかった…じゃあね…。"}, {"i": 5927, "es": "(La verdad nunca se\nsupo)", "orig": "（真相はわかりません）"}, {"i": 5928, "es": "Eso de ahora...era el\nfantasma del\ndirector...?", "orig": "今の…校長の霊…なの？"}, {"i": 5929, "es": "...Busquemos en otro\nlado.", "orig": "…他のところを探そう。"}, {"i": 5930, "es": "...Oye, no vas a salir\nya?", "orig": "…なあ、もう出ないか？"}, {"i": 5931, "es": "No sera...de la\npiscina...", "orig": "まさか…プールの……。"}, {"i": 5932, "es": "Puede que de verdad\neste maldito", "orig": "ホントに呪われてるかも"}, {"i": 5933, "es": "(...Quede encerrada?)", "orig": "（…閉じこめられた？）"}, {"i": 5934, "es": "...Reika...me ataco.", "orig": "…レイカに…襲われた。"}, {"i": 5935, "es": "...Es igual...que\naquella vez...", "orig": "…あの時と…同じだ…。"}, {"i": 5936, "es": "(Estuvo de moda cuando\neramos niños...)", "orig": "（子供の頃流行った…）"}, {"i": 5937, "es": "Con un amigo al que\npueda llamar mejor\namigo...", "orig": "親友と呼べる友達と…。"}, {"i": 5938, "es": "(Ji ji... ji...)", "orig": "（くくっ……くっ……）"}, {"i": 5939, "es": "!?\nAhora...una voz cerca?", "orig": "！？\nいま…近くで声が？"}, {"i": 5940, "es": "!?\nAhora...una voz cerca?", "orig": "！？\nいま…近くで声が？"}, {"i": 5941, "es": "Creo que hable de mas.", "orig": "ちょっと話しすぎたかな。"}, {"i": 5942, "es": "(Despues de\ntodo...Masaki...)", "orig": "（やっぱり…マサキは…）"}, {"i": 5943, "es": "No, pero fue divertido.", "orig": "ううん、でも楽しかった。"}, {"i": 5944, "es": "(Esa mano...era\nMasaki...?)", "orig": "（あの手が…マサキ…？）"}, {"i": 5945, "es": "Aunque lo deje\nenseguida.", "orig": "すぐやめちゃったけどな。"}, {"i": 5946, "es": "Esta bien, eres\nbienvenida.", "orig": "いいじゃん、歓迎するよ。"}, {"i": 5947, "es": "Despues de todo, paso\nalgo?", "orig": "やっぱり、何かあったの？"}, {"i": 5948, "es": "Pesca, beisbol,\nesqui......", "orig": "釣り、野球、スキー……。"}, {"i": 5949, "es": "...Yo, no me\nacuerdo...", "orig": "…わたし、覚えてない…。"}, {"i": 5950, "es": "Si estiro la\nmano...parece que\nllego.", "orig": "手を伸ばせば…届きそう。"}, {"i": 5951, "es": "En momentos asi, es\nmejor tener mas gente", "orig": "こういう時は人が多い方が"}, {"i": 5952, "es": "Yo...no me acuerdo...", "orig": "わたし…覚えてないよ…。"}, {"i": 5953, "es": "Eso es todo lo que\nquerias decir?", "orig": "言いたいことはそれだけ？"}, {"i": 5954, "es": "Eh! No lo sabia...", "orig": "ええっ！知らなかった…。"}, {"i": 5955, "es": "Oye, es sobre Riko.", "orig": "あのさ、リコなんだけど。"}, {"i": 5956, "es": "Falta poco para el\namanecer...", "orig": "夜明けまで、あと少し…。"}, {"i": 5957, "es": "No tuviste un accidente\nde transito?", "orig": "交通事故にあわなかった？"}, {"i": 5958, "es": "Se convirtio en ese tipo\nde ser...", "orig": "存在になってしまった…。"}, {"i": 5959, "es": "Las cien historias\nperdieron su efecto...", "orig": "百物語は効力を失った…。"}, {"i": 5960, "es": "Eso...dijo Yuuta.", "orig": "ユウタは…そう言ってた。"}, {"i": 5961, "es": "...Hay una\npresencia...extraña...", "orig": "…妙な…気配があるの…。"}, {"i": 5962, "es": "Una ayuda para\nmaterializar las cien\nhistorias.", "orig": "百物語実体化への手助け。"}, {"i": 5963, "es": "(Pero, tengo que\ninvestigar......)", "orig": "（でも、調べないと……）"}, {"i": 5964, "es": "(Ngh......el\ncelular...)", "orig": "（くっ……ケータイを…）"}, {"i": 5965, "es": "Si yo fuera Nanashi,", "orig": "もし僕がナナシだったら、"}, {"i": 5966, "es": "Tienes razon. Que tipico\nde Riko.", "orig": "そうだな。リコらしいや。"}, {"i": 5967, "es": "...Juguemos al juego de\nmiradas.", "orig": "…にらめっこ、しましょ。"}, {"i": 5968, "es": "Solo Yuuta va a la\npiscina?", "orig": "ユウタだけプール行くか？"}, {"i": 5969, "es": "Pero dicen que Reika es\nNanashi", "orig": "でもレイカはナナシだって"}, {"i": 5970, "es": "...Mm......Yuuta?", "orig": "…う……ん………ユウタ？"}, {"i": 5971, "es": "Pero, por que la\npiscina.", "orig": "でも、なんでプールなの。"}, {"i": 5972, "es": "(......Una mancha...\nespeluznante...)", "orig": "（……気味悪い…シミ…）"}, {"i": 5973, "es": "(Huellas...mojadas de\nagua?)", "orig": "（水に濡れた…足あと？）"}, {"i": 5974, "es": "(Eh...la voz de\nReika...!)", "orig": "（えっ…レイカの声…！）"}, {"i": 5975, "es": "El salon 2-1 esta en el\nsegundo piso.", "orig": "２−１の教室は２階だな。"}, {"i": 5976, "es": "(Si subo esto...la\nazotea...)", "orig": "（これを上れば…屋上…）"}, {"i": 5977, "es": "Ja, que bien que estes\ntan tranquila.", "orig": "フッ、のんきでいいわね。"}, {"i": 5978, "es": "...A mi tambien me\nparece...", "orig": "…私もそんな気がする…。"}, {"i": 5979, "es": "O-oye, se... se\nahorco!", "orig": "お、おい、くくく首つり！"}, {"i": 5980, "es": "Ah...un terremoto al\namanecer...", "orig": "ああ…夜明けに地震が…。"}, {"i": 5981, "es": "...Lo...lo\nsiento......Riko...", "orig": "…ご…ごめんね……リコ…"}, {"i": 5982, "es": "(...Que debo hacer?)", "orig": "（…どうすればいいの？）"}, {"i": 5983, "es": "Que pasa, ocurrio algo?", "orig": "なんだ、何かあったのか？"}, {"i": 5984, "es": "Ahi deberia estar\nNanashi.", "orig": "そこにナナシがいるはず。"}, {"i": 5985, "es": "Reika! Donde estas!?", "orig": "レイカ！どこにいるの！？"}, {"i": 5986, "es": "Cuando se habla de\nRiko, se ve feliz", "orig": "リコの話になると楽しそう"}, {"i": 5987, "es": "(...No sera...un\nmuñeco...!?)", "orig": "（…まさか…人形…！？）"}, {"i": 5988, "es": "(El alma...se aloja en el\nmuñeco......)", "orig": "（人形に…魂が宿る……）"}, {"i": 5989, "es": "Diccionario\njapones-ingles,\nenciclopedia......", "orig": "和英辞典、百科事典……。"}, {"i": 5990, "es": "Despues de todo, Riko\nesta aqui...", "orig": "やっぱりリコはここに…。"}, {"i": 5991, "es": "Mas importante, el\nmensaje de Nanashi.", "orig": "それよりナナシのメール。"}, {"i": 5992, "es": "Que...?\n...Que hay ahi!?", "orig": "なに…？\n…何がいるの！？"}, {"i": 5993, "es": "Reika!\nNo! Reika!", "orig": "レイカ！\nいやっ！レイカ！"}, {"i": 5994, "es": "(Se le cayeron las gafas\nal agua...)", "orig": "（ゴーグルを水に落とす…）"}, {"i": 5995, "es": "(Mentira... por que...\nla mujer de la boca\nrasgada...)", "orig": "（うそ…なんで…口裂け…）"}, {"i": 5996, "es": "Siempre terminaba\ncancelandose.", "orig": "いつも中止になってたんだ。"}, {"i": 5997, "es": "...Escucha bien...lo\nque te voy a decir...", "orig": "…いいか…よく聞くんだ…。"}, {"i": 5998, "es": "...Es tu\nculpa...Mizuki.", "orig": "…おまえのせいさ…ミズキ。"}, {"i": 5999, "es": "Fue cuando recorrimos\nlas inmobiliarias.", "orig": "不動産屋めぐりをした時よ。"}, {"i": 6000, "es": "El numero es la cuenta\nhacia el 100.", "orig": "番号は１００へのカウント。"}]