[{"i": 5401, "es": "Si es asi... tal vez este\natrapado sin poder\nbajar.", "orig": "そうだとしたら…、\n降りれなくて困っているかもな。"}, {"i": 5402, "es": "Encuentra lo que el\ndueño mas apreciaba en\nsu corazon.", "orig": "オーナーが最も心にとめていた\nものを探し出しなさい。"}, {"i": 5403, "es": "(Al final, mi destino fue\ntal como lo vi en el\nsueño)", "orig": "（結局、わたしの運命は\n　夢で見た通りだったのです）"}, {"i": 5404, "es": "Encuentra lo que el\ndueño mas apreciaba en\nsu corazon.", "orig": "オーナーが最も心にとめていた\nものを探し出しなさい。"}, {"i": 5405, "es": "Esta hecho de forma que\nse desarma con solo\ntocarlo un poco.", "orig": "ちょっとさわるとバラバラ\nになる仕組みになっている。"}, {"i": 5406, "es": "Parece que el hijo del\ndueño fallecido esta\nplaneando la demolicion.", "orig": "死んだオーナーの息子が、\n解体を計画しているらしい。"}, {"i": 5407, "es": "Ah si? Si tienes alguna\npreocupacion, contarla\nte hara sentir mejor.", "orig": "そう？何か心配事があるなら\n話した方が楽になるわよ。"}, {"i": 5408, "es": "Dicen que cerca de la\ncima, sin darte cuenta,\naparece otra persona\nmontada.", "orig": "頂上付近でいつのまにか\nもう１人が乗ってるらしいよ。"}, {"i": 5409, "es": "Bueno, una propuesta!\nQue tal si entramos uno\npor uno, con tiempo de\npor medio?", "orig": "さて、ここで提案！\n１人ずつ、時間を空けて入らない？"}, {"i": 5410, "es": "Algo que solo se ve por\nestar a oscuras...\nsiento que lo vi en algun\nlado.", "orig": "暗闇だからこそ見えるもの…。\nどこかで見た気がする。"}, {"i": 5411, "es": "(Al final... todos\nescapamos sanos y\nsalvos de Dream Park,)", "orig": "（結局……、全員無事に\n　ドリームパークを脱出し、）"}, {"i": 5412, "es": "(Pero tal vez haya sido\nmejor no saberlo)", "orig": "（でも、わからないままで\n　よかったかもしれません）"}, {"i": 5413, "es": "(Al final, mi destino fue\ntal como lo vi en el\nsueño)", "orig": "（結局、わたしの運命は\n　夢で見た通りだったのです）"}, {"i": 5414, "es": "Pensar como escapar...\no resolver el misterio de\nese payaso.", "orig": "逃げる方法を考えるか……\nあのピエロの謎を解かないと。"}, {"i": 5415, "es": "...Ese payaso... al ver\nel globo parecio\nrecuperar la cordura por\nun instante...", "orig": "…あのピエロ…風船を見て、\n一瞬正気に戻ったような…。"}, {"i": 5416, "es": "Gas... te refieres a\nhelio? Hay algo de eso\npor aqui?", "orig": "ガスって…ヘリウムガス？\nそれってどこかにありますか？"}, {"i": 5417, "es": "Antes... creo que lo vi\nen el cuarto del personal\nde la casa embrujada.", "orig": "以前…、お化け屋敷の\nスタッフルームで見かけたような。"}, {"i": 5418, "es": "Que miedosa eres, de\nverdad. Bueno,\nentonces empiezan los\nchicos.", "orig": "もう、ホントに怖がりなんだから。\nじゃ、男子からだね。"}, {"i": 5419, "es": "Si seguimos por este\npasillo, parece que\nsalimos frente a la\nentrada.", "orig": "このまま通路の先へ行けば、\nゲート前に出れるみたいよ。"}, {"i": 5420, "es": "Este lugar sera\ndemolido... Que quieres\nque haga yo ahora?", "orig": "ここは潰す予定だ……。\n今さら私にどうしろというんだ？"}, {"i": 5421, "es": "Aunque ya pasaron\nvarios años desde que\ncerro Dream Park...", "orig": "ドリームパークが閉鎖されて、\n何年も経つと言うのに…。"}, {"i": 5422, "es": "Este lugar sera\ndemolido... Que quieres\nque haga yo ahora?", "orig": "ここは潰す予定だ……。\n今さら私にどうしろというんだ？"}, {"i": 5423, "es": "No hace falta que te\nasustes tanto. Tuviste\nuna pesadilla o algo asi?", "orig": "そこまでビビらなくても。\nよっぽどコワイ夢でも見てたの？"}, {"i": 5424, "es": "En los lugares donde se\njuntan los sentimientos\nde la gente, siempre\nqueda algo.", "orig": "人の想いが集まる場所には、\n何かが残っているものだから。"}, {"i": 5425, "es": "Por cierto, ya\ndescubriste que era lo\nque mas apreciaba el\ndueño?", "orig": "ところで、オーナーが最も心に\nとめていたものはわかった？"}, {"i": 5426, "es": "Dicen que en estos\ncasos, el primero en\nentrar es el que ve mas\nclaro.", "orig": "こういうとき、最初に入った方が\nハッキリ見えるらしいよ。"}, {"i": 5427, "es": "Tiene la propiedad de\nabsorber la luz de las\nlamparas y despues\nbrillar.", "orig": "電灯の明かりなんかを吸収して、\n発光する性質があるんだ。"}, {"i": 5428, "es": "Es para demoler este\nlugar. Vine a comprobar\nque hay detras de la\nmaldicion.", "orig": "ここを取り壊すためだよ。\n祟りの正体を確かめに来たんだ。"}, {"i": 5429, "es": "Nosotras tambien\nvinimos a comprobar que\nhay detras de la\nmaldicion...", "orig": "あたしたちだって、タタリの正体を\nたしかめに来たのに…。"}, {"i": 5430, "es": "En los lugares donde se\njuntan los sentimientos\nde la gente, siempre\nqueda algo.", "orig": "人の想いが集まる場所には、\n何かが残っているものだから。"}, {"i": 5431, "es": "Riko esta en peligro!\nDicen que hay un payaso\nafuera del cuarto del\npersonal.", "orig": "リコが危ないの！スタッフルームの\n外にピエロがいるって。"}, {"i": 5432, "es": "(Lo ultimo que vi fue el\nparque tenido de\nsangre)", "orig": "（わたしが最後に見た光景は、\n　血に染まったテーマパーク）"}, {"i": 5433, "es": "Se los muestro con una\ngran sorpresa, algo que\nle encantaba al dueño.", "orig": "オーナーが大好きだった、\n大掛かりなサプライズで見せるの。"}, {"i": 5434, "es": "Dicen que alguien conto\nque le dio miedo por una\npersona que hacia de\nfantasma.", "orig": "幽霊役の人がいて怖かったって\n言われたことがあったらしい。"}, {"i": 5435, "es": "(Lo ultimo que vi fue el\nparque tenido de\nsangre)", "orig": "（わたしが最後に見た光景は、\n　血に染まったテーマパーク）"}, {"i": 5436, "es": "Esa maqueta del carrusel\nla hizo mi viejo con sus\npropias manos.", "orig": "そのメリーゴーラウンドの模型は、\n親父が自分でつくったんだ。"}, {"i": 5437, "es": "Entonces, no se podra\nusar el poder de esos\nespiritus para que el\npayaso vuelva a la\nnormalidad?", "orig": "だったらあの霊たちの力を借りて、\nピエロを元に戻せないかな。"}, {"i": 5438, "es": "Parece que su lema era:\nlo divertido, hacerlo aun\nmas divertido.", "orig": "楽しいものはより楽しくって、\nそれが彼の理念だったらしいわ。"}, {"i": 5439, "es": "Estaba tratando en serio\nde crear un parque de\ndiversiones soñado\ndonde todos se\nreunieran.", "orig": "みんなが集まる夢の遊園地を、\n真剣に作ろうとしていたんです。"}, {"i": 5440, "es": "Parece que su lema era:\nlo divertido, hacerlo aun\nmas divertido.", "orig": "楽しいものはより楽しくって、\nそれが彼の理念だったらしいわ。"}, {"i": 5441, "es": "Oye. No es cruel\nburlarse de una chica?\nVerdad, Mizuki.", "orig": "ちょっとぉ。女の子をからかう\nなんてヒドくない？ね、ミズキ。"}, {"i": 5442, "es": "(Al final, nunca supimos\nque era realmente lo que\nvimos)", "orig": "（結局、わたしたちが見たものの\n　正体はわかりませんでした）"}, {"i": 5443, "es": "Si cortamos la energia de\nla casa embrujada, no se\nbloquearia la puerta?", "orig": "お化け屋敷の電源を落とせば扉に\nロックがかかるんじゃないか？"}, {"i": 5444, "es": "Si esa conviccion se\nmanifiesta ahora en\nforma de ese payaso...", "orig": "その信念がピエロというカタチで\n今、現れているのだとしたら…。"}, {"i": 5445, "es": "Aunque se que es falso,\nestar solo me pone\nnervioso de todos\nmodos...", "orig": "作り物って分かっているのに、\nどうも１人だと不安になるなぁ…。"}, {"i": 5446, "es": "Ya me aprendi de\nmemoria todos los\ntrucos, de donde sale\ncada fantasma.", "orig": "どこから、お化けが出てくるか、\n仕掛けも全部覚えちゃったから。"}, {"i": 5447, "es": "(Que un payaso me\nestaba persiguiendo, y\nque ese payaso,)", "orig": "（私はピエロに追いかけられている\n　こと、そしてそのピエロは、）"}, {"i": 5448, "es": "Dicen que cerro despues\nde que murio el dueño y\nquedo abandonado\ndesde entonces.", "orig": "オーナーが死んだ後に閉鎖されて、\nずっと放置されているらしいよ。"}, {"i": 5449, "es": "Hay que encontrar\nrapido el cuarto del\npersonal y conseguir el\ngas helio...", "orig": "早いトコ、スタッフルームを探して\nヘリウムガスを見つけなきゃ…。"}, {"i": 5450, "es": "(Le conte a Reika que\nparecia ser el espiritu\ndel dueño)", "orig": "（どうやらオーナーの霊らしい、と\n　いうことをレイカに話しました）"}, {"i": 5451, "es": "Riko?", "orig": "リコ？"}, {"i": 5452, "es": "Que?", "orig": "なに？"}, {"i": 5453, "es": "Eh?", "orig": "えっ？"}, {"i": 5454, "es": "Quien sabe?", "orig": "さあ？"}, {"i": 5455, "es": "Masaki", "orig": "マサキ"}, {"i": 5456, "es": "Hola.", "orig": "よっ。"}, {"i": 5457, "es": "Ah.", "orig": "ああ。"}, {"i": 5458, "es": "Una presencia?", "orig": "気配？"}, {"i": 5459, "es": "Sensei?", "orig": "先生？"}, {"i": 5460, "es": "Yo tambien.", "orig": "俺も。"}, {"i": 5461, "es": "Reika", "orig": "レイカ"}, {"i": 5462, "es": "Riko!", "orig": "リコ！"}, {"i": 5463, "es": "Eh.", "orig": "えっ。"}, {"i": 5464, "es": "Especial?", "orig": "特別？"}, {"i": 5465, "es": "Ah si?", "orig": "そう？"}, {"i": 5466, "es": "Es real?", "orig": "本物？"}, {"i": 5467, "es": "Bueno,", "orig": "さあ、"}, {"i": 5468, "es": "Ah.", "orig": "ああ。"}, {"i": 5469, "es": "Eh?", "orig": "えっ？"}, {"i": 5470, "es": "Si.", "orig": "うん。"}, {"i": 5471, "es": "Riko!", "orig": "リコ！"}, {"i": 5472, "es": "Asi es.", "orig": "そう。"}, {"i": 5473, "es": "...Cero!", "orig": "…ゼロ！"}, {"i": 5474, "es": "Voy a escapar!", "orig": "逃げる！"}, {"i": 5475, "es": "Ah...", "orig": "ああ…。"}, {"i": 5476, "es": "Eh?!", "orig": "ええっ。"}, {"i": 5477, "es": "Ah...", "orig": "ああ…。"}, {"i": 5478, "es": "Ah...", "orig": "ああ…。"}, {"i": 5479, "es": "Masaki!", "orig": "マサキ！"}, {"i": 5480, "es": "Shh...", "orig": "しっ…。"}, {"i": 5481, "es": "Si...", "orig": "うん…。"}, {"i": 5482, "es": "Si...", "orig": "うん…。"}, {"i": 5483, "es": "Sensei...", "orig": "先生…。"}, {"i": 5484, "es": "Reika!", "orig": "レイカ！"}, {"i": 5485, "es": "Puede ser.", "orig": "かもな。"}, {"i": 5486, "es": "Eh...?", "orig": "えっ…？"}, {"i": 5487, "es": "Hii...", "orig": "ヒッ…。"}, {"i": 5488, "es": "Reika!", "orig": "レイカ！"}, {"i": 5489, "es": "Oye...", "orig": "なあ…。"}, {"i": 5490, "es": "Reika!", "orig": "レイカ！"}, {"i": 5491, "es": "Yuuta!", "orig": "ユウタ！"}, {"i": 5492, "es": "Estas bien?", "orig": "大丈夫？"}, {"i": 5493, "es": "...Si.", "orig": "…うん。"}, {"i": 5494, "es": "Ah, ya veo.", "orig": "ふうん。"}, {"i": 5495, "es": "...Si.", "orig": "…うん。"}, {"i": 5496, "es": "Estas bien?", "orig": "大丈夫？"}, {"i": 5497, "es": "Si...", "orig": "うん…。"}, {"i": 5498, "es": "Si hay.", "orig": "あるよ。"}, {"i": 5499, "es": "Ah...!", "orig": "はっ…！"}, {"i": 5500, "es": "Estas bien?", "orig": "大丈夫？"}, {"i": 5501, "es": "...Eh?", "orig": "…あれ？"}, {"i": 5502, "es": "Masaki!", "orig": "マサキ！"}, {"i": 5503, "es": "Espera!", "orig": "待って！"}, {"i": 5504, "es": "Perdon.", "orig": "ごめん。"}, {"i": 5505, "es": "...Ah, vaya.", "orig": "…へえ。"}, {"i": 5506, "es": "Reika!", "orig": "レイカ！"}, {"i": 5507, "es": "Me perdi...", "orig": "迷子…。"}, {"i": 5508, "es": "Ah...", "orig": "あっ…。"}, {"i": 5509, "es": "Eh...", "orig": "えっ…。"}, {"i": 5510, "es": "Si...", "orig": "うん…。"}, {"i": 5511, "es": "Reika!", "orig": "レイカ！"}, {"i": 5512, "es": "Esto...", "orig": "これ…。"}, {"i": 5513, "es": "Basta.", "orig": "やめろ。"}, {"i": 5514, "es": "...Que?", "orig": "…なに？"}, {"i": 5515, "es": "Eh...", "orig": "えっ…。"}, {"i": 5516, "es": "Masaki!", "orig": "マサキ！"}, {"i": 5517, "es": "Ves? Te lo dije.", "orig": "ほらな。"}, {"i": 5518, "es": "Ahh?", "orig": "あああ？"}, {"i": 5519, "es": "Yuuta!", "orig": "ユウタ！"}, {"i": 5520, "es": "Yuuta!", "orig": "ユウタ！"}, {"i": 5521, "es": "Eh...?", "orig": "えっ…？"}, {"i": 5522, "es": "La piscina?", "orig": "プール？"}, {"i": 5523, "es": "Estas bien?", "orig": "大丈夫？"}, {"i": 5524, "es": "Ah...", "orig": "はっ…。"}, {"i": 5525, "es": "Eh...", "orig": "えっ…。"}, {"i": 5526, "es": "...Ah.", "orig": "…ああ。"}, {"i": 5527, "es": "Mas o menos.", "orig": "まあね。"}, {"i": 5528, "es": "Ah...", "orig": "はっ…。"}, {"i": 5529, "es": "Ah, ya veo.", "orig": "ふうん。"}, {"i": 5530, "es": "Desde siempre!", "orig": "ずっとね！"}, {"i": 5531, "es": "No puede ser...", "orig": "そんな…。"}, {"i": 5532, "es": "Esos ojos...", "orig": "その目…。"}, {"i": 5533, "es": "Por que?", "orig": "どうして？"}, {"i": 5534, "es": "Masaki...", "orig": "マサキ…。"}, {"i": 5535, "es": "Que grosero...", "orig": "失礼ね…。"}, {"i": 5536, "es": "Lo vi, lo vi.", "orig": "見た見た。"}, {"i": 5537, "es": "Masaki...", "orig": "マサキ…。"}, {"i": 5538, "es": "No puede ser...", "orig": "そんな…。"}, {"i": 5539, "es": "Perdon...", "orig": "ごめん…。"}, {"i": 5540, "es": "Si, si.", "orig": "はいはい。"}, {"i": 5541, "es": "Perdon...", "orig": "ごめん…。"}, {"i": 5542, "es": "Ugh...", "orig": "うぐっ…。"}, {"i": 5543, "es": "Es la piscina.", "orig": "プールさ。"}, {"i": 5544, "es": "(Ah...)", "orig": "（はっ…）"}, {"i": 5545, "es": "Masaki...", "orig": "マサキ…。"}, {"i": 5546, "es": "No lo puedo creer...", "orig": "呆れた…。"}, {"i": 5547, "es": "Quien sabe.", "orig": "どうだか。"}, {"i": 5548, "es": "Basta ya.", "orig": "やめろよ。"}, {"i": 5549, "es": "Tienes razon.", "orig": "そうだな。"}, {"i": 5550, "es": "Eso...", "orig": "それは…。"}, {"i": 5551, "es": "No, no sirve.", "orig": "ダメだな。"}, {"i": 5552, "es": "Y entonces?", "orig": "だったら？"}, {"i": 5553, "es": "El sol de la manana...", "orig": "朝日が…。"}, {"i": 5554, "es": "Eh? Yo?", "orig": "えっ？俺？"}, {"i": 5555, "es": "En el salon...", "orig": "教室じゃ…"}, {"i": 5556, "es": "Es como si...,", "orig": "まるで…、"}, {"i": 5557, "es": "......Si.", "orig": "……うん。"}, {"i": 5558, "es": "Desde la pared...", "orig": "壁から…。"}, {"i": 5559, "es": "Que pasa?", "orig": "どうした？"}, {"i": 5560, "es": "......Sensei.", "orig": "……先生。"}, {"i": 5561, "es": "Ah......", "orig": "あぁ……。"}, {"i": 5562, "es": "Yo...", "orig": "わたし…。"}, {"i": 5563, "es": "Buenos dias!", "orig": "おはよっ。"}, {"i": 5564, "es": "Ah