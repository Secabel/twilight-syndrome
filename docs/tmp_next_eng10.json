[{"i": 2701, "es": "(Entonces... Masaki de\nmi...)", "orig": "（やっぱり…マサキはあたしの\n　こと…）"}, {"i": 2702, "es": "Dibuja un circulo en la\npantalla de abajo con el\nlapiz tactil.", "orig": "タッチペンで下画面に円を\n描いて下さい。"}, {"i": 2703, "es": "Y bueno... a la derecha\ny a la izquierda...\ncuantas veces se\ngiraba...", "orig": "で…、右と左…、\n何回ずつ回すんだっけ…。"}, {"i": 2704, "es": "Ja... que estas\ndiciendo? Nanashi soy\nyo!", "orig": "ははっ…なに言ってるの？\nナナシは俺だろ！"}, {"i": 2705, "es": "En que otro lugar se\npuede hacer este\nhechizo...", "orig": "…他に、このおまじないができる\n場所って…。"}, {"i": 2706, "es": "(Si este 1059 tambien es\nun juego de palabras con\nnumeros...)", "orig": "（この１０５９もゴロあわせだと\n　すると…）"}, {"i": 2707, "es": "(Por favor... la\nverdad... quien le\ngusta a el...)", "orig": "（どうか…真実を…あいつの好きな\n　異性…）"}, {"i": 2708, "es": "(Si nos quedamos\nencerradas aqui, sera\naun mas peligroso...)", "orig": "（ここに閉じこめられたら、\n　ますます危険…）"}, {"i": 2709, "es": "Que estas diciendo, te\nvolviste loca? Jajajaja.", "orig": "なに言ってんの、頭おかしく\nなった？ははははっ。"}, {"i": 2710, "es": "(26 de septiembre...\nhoy... al amanecer...\nun gran terremoto en\nTokio...)", "orig": "（９月２６日…今日…夜明けに\n　…東京で大地震…）"}, {"i": 2711, "es": "Este tipo de cosas,\naunque sea en broma,\nno esta bien...", "orig": "こういうのって、ふざけてても、\nあまり良くない…。"}, {"i": 2712, "es": "Donde esta Nanashi,\nquien envio la cadena de\ncorreo?", "orig": "…チェーンメールを送ったナナシは\nどこにいますか？"}, {"i": 2713, "es": "Toca la chinche y\ndeslizala hacia abajo.", "orig": "ガビョウをタッチして、\n下にスライドして\nください。"}, {"i": 2714, "es": "(Si \"4219\" es\n\"shiniiku\"... y significa\n\"voy a morir\"...)", "orig": "（“４２１９”が“シニイク”\n　…で“死に行く”なら）"}, {"i": 2715, "es": "(Dos celulares... uno\nes el mio... y el otro\nes...)", "orig": "（２台のケータイって…１つは\n　わたしの…もう１つは…）"}, {"i": 2716, "es": "(Suena como si se\nestuviera riendo... eso\nsignifica que gane?)", "orig": "（笑ってるように聞こえる…\n　わたしが勝ったってこと？）"}, {"i": 2717, "es": "...Hagamos...\nnirameko... si te\nries... pierdes...", "orig": "……にらめっ…こ……しましょ\n……わらう…と…まけよ……。"}, {"i": 2718, "es": "Espera, no que ya\nhabiamos aprendido la\nleccion con Kokkuri-san\nen la azotea?", "orig": "待って、屋上はさすがにコックリ\nさんでこりてるんじゃない？"}, {"i": 2719, "es": "Ya revise la azotea hace\nrato, pero algo que\nsirviera de pista sobre\nRiko,", "orig": "屋上はさっき調べたけど、リコの\n手がかりになるようなモノは、"}, {"i": 2720, "es": "Cuesta creer que el haga\nun hechizo de amor, la\nverdad.", "orig": "あいつが恋のおまじないなんて、\nちょっと信じられないけどね。"}, {"i": 2721, "es": "Toca el mismo lugar que\nse movio, la misma\ncantidad de veces que se\nmovio.", "orig": "揺れた場所と同じ場所を\n揺れた回数分だけタッチ\nしてください。"}, {"i": 2722, "es": "Desliza el lapiz tactil\nhacia el lado para pasar\nla pagina.", "orig": "タッチペンを横にスライド\nさせて、ページをめくって\nください。"}, {"i": 2723, "es": "No conecta...", "orig": "つながらない…。"}, {"i": 2724, "es": "(Aqui tambien!?)", "orig": "（ここにも！？）"}, {"i": 2725, "es": "Profesora Yukari...!?", "orig": "ユカリ先生…！？"}, {"i": 2726, "es": "(Aqui tambien hay la\nmisma mancha...)", "orig": "（ここにも同じシミが…）"}, {"i": 2727, "es": "(Esto tambien tiene una\nmancha...)", "orig": "（これにもシミがある…）"}, {"i": 2728, "es": "(No... miren mejor...)", "orig": "（違う…もっと良く見て…）"}, {"i": 2729, "es": "(Esta mancha... que\nsera...)", "orig": "（このシミって…いったい…）"}, {"i": 2730, "es": "Toca el lugar que quieras\nrevisar.", "orig": "調べたい場所をタッチ\nしてください。"}, {"i": 2731, "es": "Toca el lugar que quieras\nrevisar.", "orig": "調べたい場所をタッチ\nしてください。"}, {"i": 2732, "es": "Toca el lugar que quieras\nrevisar.", "orig": "調べたい場所をタッチ\nしてください。"}, {"i": 2733, "es": "(No puede ser! La\nprofesora Yukari esta en\ntodos lados...)", "orig": "（うそ！\n　どの場所にもユカリ先生が…）"}, {"i": 2734, "es": "No sabia que el\ncementerio de cadenas\nera ese tipo de sitio...", "orig": "チェーンメールの墓場がそんな\nサイトだったなんて…。"}, {"i": 2735, "es": "La voz... de un\nespiritu...?", "orig": "霊の…声…？"}, {"i": 2736, "es": "Se oye algo...", "orig": "何か聞こえる…。"}, {"i": 2737, "es": "Que sera esto...", "orig": "これ…なにかしら？"}, {"i": 2738, "es": "No sale nada en la foto.", "orig": "何も写ってないわね。"}, {"i": 2739, "es": "Que sera esto...", "orig": "なんだろう…これ…。"}, {"i": 2740, "es": "Se... se oye algo...", "orig": "な…なんか…聞こえる…。"}, {"i": 2741, "es": "No parece haber nada\nraro en especial.", "orig": "特に怪しいところは無いわね。"}, {"i": 2742, "es": "Vamos a revisarlo bien\ndespues...", "orig": "後でよく調べてみましょう…。"}, {"i": 2743, "es": "Sera que... hay un\nespiritu en la foto?", "orig": "もしかして…霊が写っているの？"}, {"i": 2744, "es": "La proxima vez lo\nagrando en la\ncomputadora.", "orig": "今度、パソコンで拡大してみよう。"}, {"i": 2745, "es": "Sera que me lo imagine,\nesa sensacion rara...", "orig": "妙な感じがしたのは、気のせい\nかしら…。"}, {"i": 2746, "es": "Si, no parece haber\nnada raro.", "orig": "うん、特におかしなところは\n無いみたい。"}, {"i": 2747, "es": "Sera mi imaginacion...\nsenti que habia algo,\npero...", "orig": "気のせいかな…。何かがいそうな\n気がしたんだけど…。"}, {"i": 2748, "es": "Por ahora lo guardo, y lo\nescucho de nuevo\ndespues.", "orig": "とりあえず保存して、後でもう一度\n聞いてみましょう。"}, {"i": 2749, "es": "Que sera esto...", "orig": "なんだろう…これ…。"}, {"i": 2750, "es": "Se... se oye algo...", "orig": "な…なんか…聞こえる…。"}, {"i": 2751, "es": "La proxima vez lo\nagrando en la\ncomputadora.", "orig": "今度、パソコンで拡大してみよう。"}, {"i": 2752, "es": "Si, no parece haber\nnada raro.", "orig": "うん、特におかしなところは\n無いみたい。"}, {"i": 2753, "es": "Sera mi imaginacion...\nsenti que habia algo,\npero...", "orig": "気のせいかな…。何かがいそうな\n気がしたんだけど…。"}, {"i": 2754, "es": "Que sera esto...", "orig": "なんだろう…これ…。"}, {"i": 2755, "es": "Se... se oye algo...", "orig": "な…なんか…聞こえる…。"}, {"i": 2756, "es": "La proxima vez lo\nagrando en la\ncomputadora.", "orig": "今度、パソコンで拡大してみよう。"}, {"i": 2757, "es": "Si, no parece haber\nnada raro.", "orig": "うん、特におかしなところは\n無いみたい。"}, {"i": 2758, "es": "Sera mi imaginacion...\nsenti que habia algo,\npero...", "orig": "気のせいかな…。何かがいそうな\n気がしたんだけど…。"}, {"i": 2759, "es": "Puaj.", "orig": "うげっ。"}, {"i": 2760, "es": "Que aburrido.", "orig": "つまんないの。"}, {"i": 2761, "es": "Sale algo en la foto!", "orig": "なんか写ってる！"}, {"i": 2762, "es": "Que sera esto...", "orig": "なんだろう…これ…。"}, {"i": 2763, "es": "Y yo que tenia\nesperanzas...", "orig": "期待してたのになぁ…。"}, {"i": 2764, "es": "Oye, que es esto!?", "orig": "ちょっと、ナニこれ！？"}, {"i": 2765, "es": "Se... se oye algo...", "orig": "な…なんか…聞こえる…。"}, {"i": 2766, "es": "Manana le pregunto a\nReika.", "orig": "明日レイカに聞いてみよう。"}, {"i": 2767, "es": "Ay, no se grabo nada.", "orig": "ちぇっ、なんにも録れてない。"}, {"i": 2768, "es": "Nada, no sale nada en la\nfoto.", "orig": "なーんだ、なんにも写ってない。"}, {"i": 2769, "es": "La proxima vez lo\nagrando en la\ncomputadora.", "orig": "今度、パソコンで拡大してみよう。"}, {"i": 2770, "es": "Q-que es... este sonido\ntan raro...", "orig": "な、な、ナニよ…、この変な音…。"}, {"i": 2771, "es": "Si, no parece haber\nnada raro.", "orig": "うん、特におかしなところは\n無いみたい。"}, {"i": 2772, "es": "Que hago, quiero\nborrarlo, pero... estara\nbien si lo borro?", "orig": "どうしよう、消したいけど…\n消しても大丈夫かな。"}, {"i": 2773, "es": "Sera mi imaginacion...\nsenti que habia algo,\npero...", "orig": "気のせいかな…。何かがいそうな\n気がしたんだけど…。"}, {"i": 2774, "es": "No quiero que me\nmaldigan por\nborrarlo... manana le\npido a Reika que lo\nrevise.", "orig": "消して呪われたらイヤだし…。\n明日レイカに調べてもらおう。"}, {"i": 2775, "es": "La voz... de un\nespiritu...?", "orig": "霊の…声…？"}, {"i": 2776, "es": "Se oye algo...", "orig": "何か聞こえる…。"}, {"i": 2777, "es": "Que sera esto...", "orig": "これ…なにかしら？"}, {"i": 2778, "es": "No sale nada en la foto.", "orig": "何も写ってないわね。"}, {"i": 2779, "es": "Que sera esto...", "orig": "なんだろう…これ…。"}, {"i": 2780, "es": "Se... se oye algo...", "orig": "な…なんか…聞こえる…。"}, {"i": 2781, "es": "Vamos a revisarlo bien\ndespues...", "orig": "後でよく調べてみましょう…。"}, {"i": 2782, "es": "No parece haber nada\nraro en especial.", "orig": "特に怪しいところは無いわね。"}, {"i": 2783, "es": "Sera que... hay un\nespiritu en la foto?", "orig": "もしかして…霊が写っているの？"}, {"i": 2784, "es": "La proxima vez lo\nagrando en la\ncomputadora.", "orig": "今度、パソコンで拡大してみよう。"}, {"i": 2785, "es": "Sera que me lo imagine,\nesa sensacion rara...", "orig": "妙な感じがしたのは、気のせい\nかしら…。"}, {"i": 2786, "es": "Si, no parece haber\nnada raro.", "orig": "うん、特におかしなところは\n無いみたい。"}, {"i": 2787, "es": "Sera mi imaginacion...\nsenti que habia algo,\npero...", "orig": "気のせいかな…。何かがいそうな\n気がしたんだけど…。"}, {"i": 2788, "es": "Por ahora lo guardo, y lo\nescucho de nuevo\ndespues.", "orig": "とりあえず保存して、後でもう一度\n聞いてみましょう。"}, {"i": 2789, "es": "Que sera esto...", "orig": "なんだろう…これ…。"}, {"i": 2790, "es": "Se... se oye algo...", "orig": "な…なんか…聞こえる…。"}, {"i": 2791, "es": "La proxima vez lo\nagrando en la\ncomputadora.", "orig": "今度、パソコンで拡大してみよう。"}, {"i": 2792, "es": "Si, no parece haber\nnada raro.", "orig": "うん、特におかしなところは\n無いみたい。"}, {"i": 2793, "es": "Sera mi imaginacion...\nsenti que habia algo,\npero...", "orig": "気のせいかな…。何かがいそうな\n気がしたんだけど…。"}, {"i": 2794, "es": "Por que?", "orig": "何で？"}, {"i": 2795, "es": "Ahh!", "orig": "キャ！"}, {"i": 2796, "es": "Eh?", "orig": "えっ？"}, {"i": 2797, "es": "Ahh!", "orig": "キャ！"}, {"i": 2798, "es": "Que cosa?", "orig": "何が？"}, {"i": 2799, "es": "Si.", "orig": "はい。"}, {"i": 2800, "es": "Si.", "orig": "うん。"}, {"i": 2801, "es": "Eh!", "orig": "えっ！"}, {"i": 2802, "es": "Ah.", "orig": "あっ。"}, {"i": 2803, "es": "Sakuma?", "orig": "サクマ？"}, {"i": 2804, "es": "Vamos!", "orig": "行くぞ！"}, {"i": 2805, "es": "Espera!", "orig": "待って！"}, {"i": 2806, "es": "Bajemos", "orig": "降りよう"}, {"i": 2807, "es": "Eh...?", "orig": "えっ…？"}, {"i": 2808, "es": "Eh!?", "orig": "えっ！？"}, {"i": 2809, "es": "Tonto.", "orig": "ばーか。"}, {"i": 2810, "es": "Eh...?", "orig": "…えっ？"}, {"i": 2811, "es": "No...", "orig": "いや…。"}, {"i": 2812, "es": "El viento...", "orig": "風が…。"}, {"i": 2813, "es": "Eh...", "orig": "えっ…。"}, {"i": 2814, "es": "Es cierto.", "orig": "そだね。"}, {"i": 2815, "es": "Esta cerca...", "orig": "近い…。"}, {"i": 2816, "es": "Apuremonos.", "orig": "急ごう。"}, {"i": 2817, "es": "Maldicion!", "orig": "くそっ！"}, {"i": 2818, "es": "Nos vemos", "orig": "じゃあね"}, {"i": 2819, "es": "Es la alarma.", "orig": "警報機だ。"}, {"i": 2820, "es": "Una ampliacion?", "orig": "拡張工事？"}, {"i": 2821, "es": "No...", "orig": "違う……。"}, {"i": 2822, "es": "Es cierto.", "orig": "そうだね。"}, {"i": 2823, "es": "O-oye!", "orig": "お、おい！"}, {"i": 2824, "es": "Callate.", "orig": "うるへー。"}, {"i": 2825, "es": "Esta bien...", "orig": "いいよ…。"}, {"i": 2826, "es": "Entendido.", "orig": "分かった。"}, {"i": 2827, "es": "Esta vez si.", "orig": "今度こそ。"}, {"i": 2828, "es": "Nos vemos.", "orig": "じゃあね。"}, {"i": 2829, "es": "Esto es...", "orig": "これが…。"}, {"i": 2830, "es": "Adios", "orig": "さようなら"}, {"i": 2831, "es": "Si, si.", "orig": "はいはい。"}, {"i": 2832, "es": "Tu tambien, Riko!", "orig": "リコこそ！"}, {"i": 2833, "es": "Nos vemos.", "orig": "じゃあな。"}, {"i": 2834, "es": "Es cierto.", "orig": "…そうだ。"}, {"i": 2835, "es": "No puede ser...", "orig": "まさか…。"}, {"i": 2836, "es": "Ignoremoslo", "orig": "無視しよう"}, {"i": 2837, "es": "Quien es ese?", "orig": "それだれ？"}, {"i": 2838, "es": "En serio?", "orig": "そうなの？"}, {"i": 2839, "es": "Es agua subterranea.", "orig": "地下水だ。"}, {"i": 2840, "es": "Es imposible.", "orig": "無理だよ。"}, {"i": 2841, "es": "Callate.", "orig": "うるへー。"}, {"i": 2842, "es": "Es cierto.", "orig": "そうだね。"}, {"i": 2843, "es": "Este lugar...", "orig": "ここは…。"}, {"i": 2844, "es": "Que miedo...", "orig": "こわ……。"}, {"i": 2845, "es": "Vaya...", "orig": "へぇ……。"}, {"i": 2846, "es": "Ah... Riko.", "orig": "あ…リコ。"}, {"i": 2847, "es": "Era otra epoca.", "orig": "時代だった。"}, {"i": 2848, "es": "Nos vemos.", "orig": "じゃあ、な。"}, {"i": 2849, "es": "Adios.", "orig": "さようなら。"}, {"i": 2850, "es": "Lo reutilizaron.", "orig": "再利用した。"}, {"i": 2851, "es": "Por que yo!", "orig": "なんで俺が！"}, {"i": 2852, "es": "De que hablara?", "orig": "何の話だろ？"}, {"i": 2853, "es": "Este sonido...!?", "orig": "この音…！？"}, {"i": 2854, "es": "Un santuario...?", "orig": "…ホコラ…？"}, {"i": 2855, "es": "Traidora.", "orig": "裏切り者め。"}, {"i": 2856, "es": "Que fria eres.", "orig": "冷たいなあ。"}, {"i": 2857, "es": "Estacion\nHigashi-Kirizuka...", "orig": "東桐塚駅…。"}, {"i": 2858, "es": "Que mas da.", "orig": "いいじゃん。"}, {"i": 2859, "es": "Ah, eso...", "orig": "あ、あれ…。"}, {"i": 2860, "es": "Yo tambien voy", "orig": "わたしも行く"}, {"i": 2861, "es": "Subamos al tren", "orig": "電車に乗ろう"}, {"i": 2862, "es": "S-sera un apagon?", "orig": "て、停電か？"}, {"i": 2863, "es": "H-huyamos!", "orig": "に、逃げよ！"}, {"i": 2864, "es": "Ah, hay alguien...", "orig": "あ、人が…。"}, {"i": 2865, "es": "Un reloj de bolsillo...", "orig": "懐中時計…。"}, {"i": 2866, "es": "Eso es...", "orig": "それは……。"}, {"i": 2867, "es": "Ah, Yuuta.", "orig": "あ、ユウタ。"}, {"i": 2868, "es": "S-se derrumba!", "orig": "く、崩れる！"}, {"i": 2869, "es": "Sakuma...!", "orig": "サクマ……！"}, {"i": 2870, "es": "Ex-empleado de la\nestacion?", "orig": "元駅員さん？"}, {"i": 2871, "es": "Oye, Riko!", "orig": "おい、リコ！"}, {"i": 2872, "es": "Mmm...", "orig": "うーん……。"}, {"i": 2873, "es": "Que raro...", "orig": "おかしい……。"}, {"i": 2874, "es": "Un objeto...", "orig": "…アイテム…。"}, {"i": 2875, "es": "Yo soy Sakuma.", "orig": "わしはサクマ。"}, {"i": 2876, "es": "Y me subo a eso?", "orig": "それに乗って？"}, {"i": 2877, "es": "Es cierto...", "orig": "そうだな……。"}, {"i": 2878, "es": "Yo...", "orig": "わたしは……。"}, {"i": 2879, "es": "El sonido del reloj...", "orig": "時計の音……。"}, {"i": 2880, "es": "Yo tambien voy!", "orig": "わたしも行く！"}, {"i": 2881, "es": "Este tren...", "orig": "この電車……。"}, {"i": 2882, "es": "Eh, a donde?", "orig": "えっ、どこに？"}, {"i": 2883, "es": "Y me subo a eso?", "orig": "それに乗って？"}, {"i": 2884, "es": "Vamos rapido.", "orig": "早く行こうぜ。"}, {"i": 2885, "es": "Solo un poco.", "orig": "少しだけだよ。"}, {"i": 2886, "es": "Eh? Por que?", "orig": "は？何でだよ？"}, {"i": 2887, "es": "Un amuleto contra el\nmal?", "orig": "魔よけのお札？"}, {"i": 2888, "es": "Entendido...", "orig": "分かった……。"}, {"i": 2889, "es": "Estuvo cerca...", "orig": "危なかった…。"}, {"i": 2890, "es": "Y a-ahora que?", "orig": "こ、今度は何？"}, {"i": 2891, "es": "Un amuleto contra el\nmal?", "orig": "魔よけのお札？"}, {"i": 2892, "es": "Ya veo...", "orig": "そうなんだ…。"}, {"i": 2893, "es": "Y Yuuta?", "orig": "ユウタくんは？"}, {"i": 2894, "es": "Y me subo a eso?", "orig": "それに乗って？"}, {"i": 2895, "es": "Se detuvo...", "orig": "停まった……。"}, {"i": 2896, "es": "Lo hice yo.", "orig": "つくったんだ。"}, {"i": 2897, "es": "Vamos a ver.", "orig": "行ってみましょ。"}, {"i": 2898, "es": "Que pasa, Yuuta?", "orig": "どうしたユウタ？"}, {"i": 2899, "es": "Me sorprendi en ese\nmomento.", "orig": "あの時は驚いた。"}, {"i": 2900, "es": "Si... entonces,", "orig": "うん……じゃあ、"}, {"i": 2901, "es": "Por que?", "orig": "どうしてですか？"}, {"i": 2902, "es": "Uy, una rata!", "orig": "うわっネズミだ！"}, {"i": 2903, "es": "Oye, Riko!", "orig": "ちょっと、リコ！"}, {"i": 2904, "es": "Que sera esto?", "orig": "なんだろうこれ？"}, {"i": 2905, "es": "La luz esta por alla.", "orig": "光は向こうだよ。"}, {"i": 2906, "es": "Estuvo cerca...!", "orig": "危なかった……！"}, {"i": 2907, "es": "Yo tampoco se.", "orig": "僕も分からない。"}, {"i": 2908, "es": "Que sera esto?", "orig": "なんだろうこれ？"}, {"i": 2909, "es": "Si me subo a eso...", "orig": "それに乗ると…。"}, {"i": 2910, "es": "Mejor no subamos", "orig": "乗るのはやめよう"}, {"i": 2911, "es": "Oye, Mizuki,", "orig": "ちょっとミズキ、"}, {"i": 2912, "es": "No hay pasajeros...", "orig": "客がいない……。"}, {"i": 2913, "es": "Bajense las dos!", "orig": "２人とも降りて！"}, {"i": 2914, "es": "Yuuta, cuento contigo.", "orig": "ユウタ、頼んだ。"}, {"i": 2915, "es": "Que alivio...", "orig": "よかったぁ……。"}, {"i": 2916, "es": "Que sera esto?", "orig": "なんだろうこれ？"}, {"i": 2917, "es": "Si, bastante.", "orig": "うん、かなりね。"}, {"i": 2918, "es": "Escuchemos lo que dice", "orig": "話を聞いてみよう"}, {"i": 2919, "es": "Que sera esto?", "orig": "なんだろうこれ？"}, {"i": 2920, "es": "Esta bastante cafe.", "orig": "かなり茶色いよ。"}, {"i": 2921, "es": "Ya lo se.", "orig": "わかってるって。"}, {"i": 2922, "es": "Q-que miedo...", "orig": "こ、こわい……。"}, {"i": 2923, "es": "Que esta pasando?", "orig": "どうなってんだ？"}, {"i": 2924, "es": "Yuuta, te toca!", "orig": "ユウタ、出番だ！"}, {"i": 2925, "es": "No, no abre.", "orig": "ダメ、開かない。"}, {"i": 2926, "es": "A investigar fenomenos\nparanormales", "orig": "怪奇現象を調べに"}, {"i": 2927, "es": "Que sera esto?", "orig": "なんだろうこれ？"}, {"i": 2928, "es": "Otra vez el sonido del\nreloj...", "orig": "また時計の音…。"}, {"i": 2929, "es": "Otra vez el sonido del\nreloj...", "orig": "また時計の音だ。"}, {"i": 2930, "es": "Puede que si.", "orig": "そうかもしれん。"}, {"i": 2931, "es": "Si... huyamos.", "orig": "うん…逃げよう。"}, {"i": 2932, "es": "No, no lo se.", "orig": "いや、知らない。"}, {"i": 2933, "es": "Vamos a entrar...", "orig": "入ってみよう…。"}, {"i": 2934, "es": "Ah... a mis pies...", "orig": "…あ…足元……。"}, {"i": 2935, "es": "Que sera esto?", "orig": "なんだろうこれ？"}, {"i": 2936, "es": "D-desaparecio...", "orig": "…き…消えた…。"}, {"i": 2937, "es": "Hay luz por alla...", "orig": "向こうから光が…。"}, {"i": 2938, "es": "Ah, senoritas.", "orig": "ああ、お嬢さん方。"}, {"i": 2939, "es": "Yuuta, lo sabes?", "orig": "ユウタ、知ってる？"}, {"i": 2940, "es": "No hay duda.", "orig": "間違いないでしょ。"}, {"i": 2941, "es": "El tren se va...", "orig": "電車が出るよ……。"}, {"i": 2942, "es": "Porque me preocupa\nRiko.", "orig": "リコが心配だから。"}, {"i": 2943, "es": "Se fue...", "orig": "行っちゃった……。"}, {"i": 2944, "es": "No, no lo se.", "orig": "いや、分からない。"}, {"i": 2945, "es": "Yo tambien lo creo...", "orig": "僕もそう思う……。"}, {"i": 2946, "es": "Eh... yo...", "orig": "あれ……わたし…。"}, {"i": 2947, "es": "DETRAS DEL MARCO", "orig": "ガクブチ　ノ　ウラ"}, {"i": 2948, "es": "Entendido, te ayudo", "orig": "わかった、協力する"}, {"i": 2949, "es": "Algo se cayo...", "orig": "何か、落ちてる…。"}, {"i": 2950, "es": "Por cierto, que hora es?", "orig": "ところでいま何時？"}, {"i": 2951, "es": "Esta persona da miedo!", "orig": "ヤバいよ、この人！"}, {"i": 2952, "es": "Bueno, bajemos.", "orig": "じゃあ、降りるか。"}, {"i": 2953, "es": "Murio enterrado vivo.", "orig": "生き埋めで死んだ。"}, {"i": 2954, "es": "Ah, senoritas.", "orig": "ああ、お嬢さん方。"}, {"i": 2955, "es": "Bueno, decidido.", "orig": "じゃあ、決まりね。"}, {"i": 2956, "es": "Que hacemos ahora?", "orig": "これからどうする？"}, {"i": 2957, "es": "Mizuki, que hacemos?", "orig": "ミズキ、どうする？"}, {"i": 2958, "es": "Otra vez... el sonido\ndel reloj...", "orig": "また…時計の音…。"}, {"i": 2959, "es": "Entonces, cuento\ncontigo, Riko.", "orig": "じゃあリコお願いね。"}, {"i": 2960, "es": "Uy, ya llego.", "orig": "うわ、来ちゃったよ。"}, {"i": 2961, "es": "Oye, Riko...", "orig": "ちょっと、リコ……。"}, {"i": 2962, "es": "no se pudo)", "orig": "　できませんでした）"}, {"i": 2963, "es": "Eh? Si es Masaki.", "orig": "あれ？マサキじゃん。"}, {"i": 2964, "es": "Es... nuestra culpa?", "orig": "わたしたちの…せい？"}, {"i": 2965, "es": "No podremos escuchar la\nhistoria...", "orig": "話聞けないかなぁ…。"}, {"i": 2966, "es": "Vamos a otro lugar", "orig": "ほかのところに行こう"}, {"i": 2967, "es": "Sera que este lugar...", "orig": "もしかして、ここ…。"}, {"i": 2968, "es": "Mejor dejemoslo\ntranquilo...", "orig": "そっとしておこう…。"}, {"i": 2969, "es": "Riko, no hay tiempo,", "orig": "リコ、時間もないし、"}, {"i": 2970, "es": "Con esto quedo\nprobado.", "orig": "これで証明されたね。"}, {"i": 2971, "es": "Pensaba subir al tren", "orig": "電車に乗ろうと思って"}, {"i": 2972, "es": "Bebe abandonado en un\ncasillero", "orig": "コインロッカーベビー"}, {"i": 2973, "es": "Estas haciendo eso?", "orig": "そんなことしてんの？"}, {"i": 2974, "es": "Eso, que tipo de...?", "orig": "それは、どんな……？"}, {"i": 2975, "es": "Las vias siguen.", "orig": "線路が続いているね。"}, {"i": 2976, "es": "Si, vamos a ver.", "orig": "うん、行ってみよう。"}, {"i": 2977, "es": "Un bebe... no puede\nser...", "orig": "赤ちゃん…まさか…。"}, {"i": 2978, "es": "Yuuta, que hay de eso?", "orig": "ユウタ、どうなんだ？"}, {"i": 2979, "es": "Mejor no lo toques.", "orig": "触らない方がいいよ。"}, {"i": 2980, "es": "Mejor quedate aqui", "orig": "ここにいた方がいいよ"}, {"i": 2981, "es": "El anden...\nfantasma...", "orig": "幻の……ホーム……。"}, {"i": 2982, "es": "No. Gracias.", "orig": "ううん。ありがとう。"}, {"i": 2983, "es": "Un hoyo...? Con ese\ntemblor...", "orig": "穴…？今の揺れで…。"}, {"i": 2984, "es": "Ahora que lo pienso...\nen ese momento.", "orig": "そういえば…あの時。"}, {"i": 2985, "es": "Estas haciendo eso?", "orig": "そんなことしてんの？"}, {"i": 2986, "es": "(Me lo conto)", "orig": "（話してくれました）"}, {"i": 2987, "es": "Es un poster de esa\nepoca.", "orig": "当時のポスターだね。"}, {"i": 2988, "es": "No hay que subirse.", "orig": "乗ってはいけないよ。"}, {"i": 2989, "es": "(Esa misma noche...)", "orig": "（その日の深夜……）"}, {"i": 2990, "es": "Cadena de correo...\nque molesto...", "orig": "チェンメ……うざ…。"}, {"i": 2991, "es": "Senor, este...", "orig": "おじいさん、あの……。"}, {"i": 2992, "es": "Ya veo, que dificil.", "orig": "そっか、大変だったね。"}, {"i": 2993, "es": "(Dicen que desaparecio)", "orig": "（なくなったそうです）"}, {"i": 2994, "es": "Vamos a la entrada de\nboletos.", "orig": "改札に行ってみよっか。"}, {"i": 2995, "es": "\"Kirizuka\"... es eso.", "orig": "“キリヅカ”…なんだ。"}, {"i": 2996, "es": "En esa epoca, en el\ncasillero", "orig": "当時はコインロッカーに"}, {"i": 2997, "es": "Ya no se usa para eso.", "orig": "それに使われていない。"}, {"i": 2998, "es": "Estara bien asi...", "orig": "これでいいのかな……。"}, {"i": 2999, "es": "En ese momento, en el\nanden fantasma", "orig": "そのとき、幻のホームに"}, {"i": 3000, "es": "Como que no es asi?", "orig": "違うってどういうこと？"}]